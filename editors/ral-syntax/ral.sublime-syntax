%YAML 1.2
---
# Sublime Text / syntect syntax definition for ral.
# Derived from the TextMate grammar (ral.tmLanguage.json) in this directory.
# Used by bat, delta, presenterm (via bat cache), and Sublime Text.
name: ral
scope: source.ral
file_extensions:
  - ral
first_line_match: '^#!.*\bral\b'

contexts:
  main:
    - include: string-bumped
    - include: comment
    - include: string-double
    - include: string-single
    - include: arithmetic
    - include: let-binding
    - include: return-keyword
    - include: lambda-params
    - include: deref-paren
    - include: deref-plain
    - include: spread
    - include: force-brace
    - include: force-sigil
    - include: bypass
    - include: tilde
    - include: redirection
    - include: pipe-operator
    - include: chain-operator
    - include: number
    - include: boolean
    - include: unit
    - include: control-name
    - include: block
    - include: word
    - include: punctuation

  comment:
    - match: '#.*$'
      scope: comment.line.number-sign.ral

  # --- strings ---

  string-bumped:
    - match: '(#+)'''
      scope: punctuation.definition.string.begin.ral
      push:
        - meta_scope: string.quoted.single.ral
        - match: '''\1'
          scope: punctuation.definition.string.end.ral
          pop: true

  string-single:
    - match: "'"
      scope: punctuation.definition.string.begin.ral
      push: string-single-body

  string-single-body:
    - meta_scope: string.quoted.single.ral
    - match: "'"
      scope: punctuation.definition.string.end.ral
      pop: true

  string-double:
    - match: '"'
      scope: punctuation.definition.string.begin.ral
      push: string-double-body

  string-double-body:
    - meta_scope: string.quoted.double.ral
    - match: '\\(?:[nrte\\0"$!~]|x[0-9a-fA-F]{2}|u\{[0-9a-fA-F]{1,6}\}|\r\n?|\n)'
      scope: constant.character.escape.ral
    - include: interp-arith
    - include: interp-force-brace
    - include: interp-deref-paren
    - include: interp-deref-index
    - include: interp-force-plain
    - match: '"'
      scope: punctuation.definition.string.end.ral
      pop: true

  interp-arith:
    - match: '\$\['
      scope: punctuation.section.interpolation.begin.ral
      push: interp-arith-body

  interp-arith-body:
    - meta_scope: meta.interpolation.arithmetic.ral
    - include: arith-inner
    - match: '\]'
      scope: punctuation.section.interpolation.end.ral
      pop: true

  interp-force-brace:
    - match: '!\{'
      scope: punctuation.section.interpolation.begin.ral
      push: interp-force-brace-body

  interp-force-brace-body:
    - meta_scope: meta.interpolation.force.ral
    - include: main
    - match: '\}'
      scope: punctuation.section.interpolation.end.ral
      pop: true

  interp-deref-paren:
    - match: '(\$\()([a-zA-Z_][a-zA-Z0-9_-]*)(\))'
      captures:
        1: punctuation.definition.variable.begin.ral
        2: variable.other.ral
        3: punctuation.definition.variable.end.ral

  interp-deref-index:
    - match: '(\$)([a-zA-Z_](?:[a-zA-Z0-9_-]*[a-zA-Z0-9_])?)(\[[^\]]*\])*'
      captures:
        1: punctuation.definition.variable.ral
        2: variable.other.ral
        3: punctuation.section.index.ral

  interp-force-plain:
    - match: '!(?=\$(?:[a-zA-Z_]|\(|\[))'
      scope: keyword.operator.force.ral

  # --- arithmetic ---

  arithmetic:
    - match: '\$\['
      scope: punctuation.section.arithmetic.begin.ral
      push: arithmetic-body

  arithmetic-body:
    - meta_scope: meta.arithmetic.ral
    - include: arith-inner
    - match: '\]'
      scope: punctuation.section.arithmetic.end.ral
      pop: true

  arith-inner:
    - include: arith-prefix
    - include: arith-operand-and-tail
    - include: comment
    - match: '[+\-*/%]|==|!=|<=|>=|<|>|&&|\|\|'
      scope: keyword.operator.arithmetic.ral

  arith-prefix:
    - match: 'not(?=$|[\s|{}\[\]$^!<>"''`();,+*/%=&\-]|:(?=[\s,\]})]|$))'
    - match: '`[a-zA-Z_][a-zA-Z0-9_-]*'
    - match: '!(?=[a-zA-Z_$\(\[])'
      scope: keyword.operator.force.ral

  # After an atom, retain binary-operator expectation through whitespace and comments.
  arith-operand-and-tail:
    - match: '([+-])(?=(?:(?:[0-9]+\.[0-9]*|\.[0-9]+)(?:[eE][+-]?[0-9]+)?|[0-9]+)(?=$|[\s|{}\[\]$^!<>"''`();,+*/%=&\-]|:(?=[\s,\]})]|$)))|(?=(?:#+)''|!\{|[^\s#\])},;`+*/%=&|<>\-])'
      captures:
        1: constant.numeric.ral
      push: arith-operand-and-tail-body

  arith-operand-and-tail-body:
    - match: '([+\-*/%]|==|!=|<=|>=|<|>|&&|\|\|)|(?=[\])])'
      captures:
        1: keyword.operator.arithmetic.ral
      pop: true
    - include: arith-atoms

  arith-atoms:
    - include: string-bumped
    - include: comment
    - include: string-single
    - include: string-double
    - include: arithmetic
    - include: deref-paren
    - include: arith-deref-index
    - include: deref-plain
    - include: force-brace
    - include: force-sigil
    - match: '(?:(?:[0-9]+\.[0-9]*|\.[0-9]+)(?:[eE][+-]?[0-9]+)?|[0-9]+)(?=$|[\s|{}\[\]$^!<>"''`();,+*/%=&\-]|:(?=[\s,\]})]|$))'
      scope: constant.numeric.ral
    - include: block
    - match: '\['
      scope: punctuation.section.bracket.ral
      push: arith-collection
    - match: '\('
      push: arith-paren
    # Keep exponent signs inside malformed numeral words.
    - match: '(?:(?:[0-9]+\.[0-9]*|\.[0-9]+)(?:[eE][+-]?[0-9]+)?|[0-9]+|[^\s|{}\[\]$^!<>"''`();,:#?&+*/%=\-]|:(?![\s,\]})]|$))(?:[^\s|{}\[\]$^!<>"''`();,:+*/%=&\-]|:(?![\s,\]})]|$))*'

  arith-paren:
    - include: arith-inner
    - match: '\)'
      pop: true

  arith-collection:
    - match: '\]'
      scope: punctuation.section.bracket.ral
      pop: true
    - include: main

  arith-deref-index:
    - match: '(\$)([a-zA-Z_](?:[a-zA-Z0-9_-]*[a-zA-Z0-9_])?)(\[)'
      captures:
        1: punctuation.definition.variable.ral
        2: variable.other.ral
        3: punctuation.section.index.begin.ral
      push: arith-index-body

  arith-index-body:
    - meta_content_scope: variable.other.index-key.ral
    - match: '\]'
      scope: punctuation.section.index.end.ral
      pop: true
    - include: arith-index-key

  arith-index-key:
    - include: string-bumped
    - include: comment
    - include: string-single
    - include: string-double
    - match: '\['
      push: arith-nested-index

  arith-nested-index:
    - match: '\]'
      pop: true
    - include: arith-index-key

  # --- bindings and keywords ---

  let-binding:
    - match: '\b(let)\s+([a-zA-Z_][a-zA-Z0-9_-]*|_)\s*(=)'
      captures:
        1: keyword.other.let.ral
        2: variable.other.assignment.ral
        3: keyword.operator.assignment.ral

  return-keyword:
    - match: '\breturn(?=$|[\s|{}\[\]$^!<>"''`();,]|:(?=[\s,\]})]|$))'
      scope: keyword.control.return.ral

  lambda-params:
    - match: '\{\s*\|'
      scope: punctuation.section.lambda.begin.ral
      push: lambda-params-body

  lambda-params-body:
    - meta_scope: meta.lambda.parameters.ral
    - match: '[a-zA-Z_][a-zA-Z0-9_-]*'
      scope: variable.parameter.ral
    - match: '_'
      scope: variable.language.wildcard.ral
    - match: '\|'
      scope: punctuation.separator.lambda.ral
      pop: true

  # --- derefs and operators ---

  deref-paren:
    - match: '(\$\()([a-zA-Z_][a-zA-Z0-9_-]*)(\))'
      captures:
        1: punctuation.definition.variable.begin.ral
        2: variable.other.ral
        3: punctuation.definition.variable.end.ral

  deref-plain:
    - match: '(\$)([a-zA-Z_](?:[a-zA-Z0-9_-]*[a-zA-Z0-9_])?)'
      captures:
        1: punctuation.definition.variable.ral
        2: variable.other.ral

  spread:
    - match: '\.\.\.'
      scope: keyword.operator.spread.ral

  force-brace:
    - match: '!\{'
      scope: keyword.operator.force.begin.ral
      push: force-brace-body

  force-brace-body:
    - meta_scope: meta.force.ral
    - include: main
    - match: '\}'
      scope: keyword.operator.force.end.ral
      pop: true

  force-sigil:
    - match: '(!)(?=[a-zA-Z_$\{\(\[])'
      scope: keyword.operator.force.ral

  bypass:
    - match: '(\^)([^ \t\n|{}\[\]$<>"'',();]+)'
      captures:
        1: keyword.operator.bypass.ral
        2: entity.name.command.bypass.ral

  tilde:
    - match: '(?<![^\s\[({,;|])~(?=[\s/\])},;|]|$)'
      scope: constant.language.tilde.ral

  redirection:
    - match: '([0-9])?(>{1,2}|<|>&)\s*'
      captures:
        1: constant.numeric.fd.ral
        2: keyword.operator.redirect.ral

  pipe-operator:
    - match: '\|'
      scope: keyword.operator.pipe.ral

  chain-operator:
    - match: '\?'
      scope: keyword.operator.chain.ral

  # --- literals ---

  number:
    - match: '[+-]?(?:(?:[0-9]+\.[0-9]*|\.[0-9]+)(?:[eE][+-]?[0-9]+)?|[0-9]+)(?=$|[\s|{}\[\]$^!<>"''`();,]|:(?=[\s,\]})]|$))'
      scope: constant.numeric.ral

  boolean:
    - match: '\b(true|false)(?=$|[\s|{}\[\]$^!<>"''`();,]|:(?=[\s,\]})]|$))'
      scope: constant.language.boolean.ral

  unit:
    - match: '\(\)'
      scope: constant.language.unit.ral

  control-name:
    - match: '\b(if|for|try|case|while|spawn|gather|await|race|use|source|grant|within|map|filter|fold|reduce)(?=$|[\s|{}\[\]$^!<>"''`();,]|:(?=[\s,\]})]|$))'
      scope: keyword.control.ral

  block:
    - match: '\{'
      scope: punctuation.section.block.begin.ral
      push: block-body

  block-body:
    - include: main
    - match: '\}'
      scope: punctuation.section.block.end.ral
      pop: true

  # Consume whole words before scanning interior hashes or numeral suffixes.
  word:
    - match: '(?:[^\s|{}\[\]$^!<>"''`();,:#?&]|:(?![\s,\]})]|$))(?:[^\s|{}\[\]$^!<>"''`();,:]|:(?![\s,\]})]|$))*'

  punctuation:
    - match: '[\[\]]'
      scope: punctuation.section.bracket.ral
    - match: ','
      scope: punctuation.separator.comma.ral
    - match: ';'
      scope: punctuation.terminator.statement.ral
    - match: ':(?=[\s,\]})]|$)'
      scope: punctuation.separator.colon.ral
