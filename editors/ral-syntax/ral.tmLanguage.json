{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ral",
  "scopeName": "source.ral",
  "fileTypes": ["ral"],
  "patterns": [
    { "include": "#string-bumped" },
    { "include": "#comment" },
    { "include": "#string-double" },
    { "include": "#string-single" },
    { "include": "#arithmetic" },
    { "include": "#let-binding" },
    { "include": "#return-keyword" },
    { "include": "#lambda-params" },
    { "include": "#deref-paren" },
    { "include": "#deref-plain" },
    { "include": "#spread" },
    { "include": "#force-brace" },
    { "include": "#force-sigil" },
    { "include": "#bypass" },
    { "include": "#tilde" },
    { "include": "#redirection" },
    { "include": "#pipe-operator" },
    { "include": "#chain-operator" },
    { "include": "#number" },
    { "include": "#boolean" },
    { "include": "#unit" },
    { "include": "#control-name" },
    { "include": "#block" },
    { "include": "#collection" },
    { "include": "#word" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.ral",
      "match": "#.*$"
    },

    "string-bumped": {
      "name": "string.quoted.single.ral",
      "begin": "(#+)'",
      "end": "'\\1",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.ral" } },
      "endCaptures":   { "0": { "name": "punctuation.definition.string.end.ral" } }
    },

    "string-single": {
      "name": "string.quoted.single.ral",
      "begin": "'",
      "end": "'",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.ral" } },
      "endCaptures":   { "0": { "name": "punctuation.definition.string.end.ral" } }
    },

    "string-double": {
      "name": "string.quoted.double.ral",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.ral" } },
      "endCaptures":   { "0": { "name": "punctuation.definition.string.end.ral" } },
      "patterns": [
        { "include": "#string-escape" },
        { "include": "#interp-arith" },
        { "include": "#interp-force-brace" },
        { "include": "#interp-deref-paren" },
        { "include": "#interp-deref-index" },
        { "include": "#interp-force-plain" }
      ]
    },

    "string-escape": {
      "name": "constant.character.escape.ral",
      "match": "\\\\(?:[nrte\\\\0\"$!~]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]{1,6}\\}|\\r\\n?|\\n)"
    },

    "interp-arith": {
      "name": "meta.interpolation.arithmetic.ral",
      "begin": "\\$\\[",
      "end": "\\]",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.ral" } },
      "endCaptures":   { "0": { "name": "punctuation.section.interpolation.end.ral" } },
      "patterns": [
        { "include": "#arith-inner" }
      ]
    },

    "interp-force-brace": {
      "name": "meta.interpolation.force.ral",
      "begin": "!\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.ral" } },
      "endCaptures":   { "0": { "name": "punctuation.section.interpolation.end.ral" } },
      "patterns": [
        { "include": "$self" }
      ]
    },

    "interp-deref-paren": {
      "match": "(\\$\\()([a-zA-Z_][a-zA-Z0-9_-]*)(\\))",
      "captures": {
        "1": { "name": "punctuation.definition.variable.begin.ral" },
        "2": { "name": "variable.other.ral" },
        "3": { "name": "punctuation.definition.variable.end.ral" }
      }
    },

    "interp-deref-index": {
      "match": "(\\$)([a-zA-Z_](?:[a-zA-Z0-9_-]*[a-zA-Z0-9_])?)(\\[[^\\]]*\\])*",
      "captures": {
        "1": { "name": "punctuation.definition.variable.ral" },
        "2": { "name": "variable.other.ral" },
        "3": { "name": "punctuation.section.index.ral" }
      }
    },

    "interp-force-plain": {
      "name": "keyword.operator.force.ral",
      "match": "!(?=\\$(?:[a-zA-Z_]|\\(|\\[))"
    },

    "arithmetic": {
      "name": "meta.arithmetic.ral",
      "begin": "\\$\\[",
      "end": "\\]",
      "beginCaptures": { "0": { "name": "punctuation.section.arithmetic.begin.ral" } },
      "endCaptures":   { "0": { "name": "punctuation.section.arithmetic.end.ral" } },
      "patterns": [
        { "include": "#arith-inner" }
      ]
    },

    "arith-inner": {
      "patterns": [
        { "match": "not(?=$|[\\s|{}\\[\\]$^!<>\"'`();,+*/%=&\\-]|:(?=[\\s,\\]})]|$))" },
        { "include": "#arith-atom-expected" }
      ]
    },

    "arith-atom-expected": {
      "patterns": [
        { "include": "#arith-tag" },
        { "include": "#arith-force" },
        { "include": "#arith-operand-and-tail" },
        { "include": "#comment" },
        { "include": "#arith-binary" }
      ]
    },

    "arith-tag": {
      "begin": "`[a-zA-Z_][a-zA-Z0-9_-]*",
      "end": "(?=[\\])])",
      "patterns": [
        { "include": "#arith-atom-expected" }
      ]
    },

    "arith-force": {
      "begin": "!(?![={])",
      "beginCaptures": { "0": { "name": "keyword.operator.force.ral" } },
      "end": "(?=[\\])])",
      "patterns": [
        { "include": "#arith-atom-expected" }
      ]
    },

    "arith-binary": {
      "begin": "[+\\-*/%]|==|!=|<=|>=|<|>|&&|\\|\\|",
      "beginCaptures": { "0": { "name": "keyword.operator.arithmetic.ral" } },
      "end": "(?=[\\])])",
      "patterns": [
        { "include": "#arith-inner" }
      ]
    },

    "arith-operand-and-tail": {
      "comment": "After an atom, retain binary-operator expectation through whitespace and comments.",
      "begin": "([+-])(?=(?:(?:[0-9]+\\.[0-9]*|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?|[0-9]+)(?=$|[\\s|{}\\[\\]$^!<>\"'`();,+*/%=&\\-]|:(?=[\\s,\\]})]|$)))|(?=(?:#+)'|!\\{|[^\\s#!\\])},;`+*/%=&|<>\\-])",
      "beginCaptures": { "1": { "name": "constant.numeric.ral" } },
      "end": "(?=[\\])])",
      "patterns": [
        { "include": "#arith-binary" },
        { "include": "#arith-atoms" }
      ]
    },

    "arith-atoms": {
      "patterns": [
        { "include": "#string-bumped" },
        { "include": "#comment" },
        { "include": "#string-single" },
        { "include": "#string-double" },
        { "include": "#arithmetic" },
        { "include": "#deref-paren" },
        { "include": "#arith-deref-index" },
        { "include": "#deref-plain" },
        { "include": "#force-brace" },
        {
          "name": "constant.numeric.ral",
          "match": "(?:(?:[0-9]+\\.[0-9]*|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?|[0-9]+)(?=$|[\\s|{}\\[\\]$^!<>\"'`();,+*/%=&\\-]|:(?=[\\s,\\]})]|$))"
        },
        { "include": "#block" },
        { "include": "#collection" },
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            { "include": "#arith-inner" }
          ]
        },
        {
          "comment": "Keep exponent signs inside malformed numeral words.",
          "match": "(?:(?:[0-9]+\\.[0-9]*|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?|[0-9]+|[^\\s|{}\\[\\]$^!<>\"'`();,:#?&+*/%=\\-]|:(?![\\s,\\]})]|$))(?:[^\\s|{}\\[\\]$^!<>\"'`();,:+*/%=&\\-]|:(?![\\s,\\]})]|$))*"
        }
      ]
    },

    "arith-deref-index": {
      "begin": "(\\$)([a-zA-Z_](?:[a-zA-Z0-9_-]*[a-zA-Z0-9_])?)(\\[)",
      "end": "\\]",
      "contentName": "variable.other.index-key.ral",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.variable.ral" },
        "2": { "name": "variable.other.ral" },
        "3": { "name": "punctuation.section.index.begin.ral" }
      },
      "endCaptures": { "0": { "name": "punctuation.section.index.end.ral" } },
      "patterns": [
        { "include": "#arith-index-key" }
      ]
    },

    "arith-index-key": {
      "patterns": [
        { "include": "#string-bumped" },
        { "include": "#comment" },
        { "include": "#string-single" },
        { "include": "#string-double" },
        {
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            { "include": "#arith-index-key" }
          ]
        }
      ]
    },

    "collection": {
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": { "0": { "name": "punctuation.section.bracket.ral" } },
      "endCaptures": { "0": { "name": "punctuation.section.bracket.ral" } },
      "patterns": [
        { "include": "$self" }
      ]
    },

    "let-binding": {
      "match": "\\b(let)\\s+([a-zA-Z_][a-zA-Z0-9_-]*|_)\\s*(=)",
      "captures": {
        "1": { "name": "keyword.other.let.ral" },
        "2": { "name": "variable.other.assignment.ral" },
        "3": { "name": "keyword.operator.assignment.ral" }
      }
    },

    "return-keyword": {
      "match": "\\breturn(?=$|[\\s|{}\\[\\]$^!<>\"'`();,]|:(?=[\\s,\\]})]|$))",
      "name": "keyword.control.return.ral"
    },

    "lambda-params": {
      "name": "meta.lambda.parameters.ral",
      "begin": "\\{\\s*\\|",
      "end": "\\|",
      "beginCaptures": { "0": { "name": "punctuation.section.lambda.begin.ral" } },
      "endCaptures":   { "0": { "name": "punctuation.separator.lambda.ral" } },
      "patterns": [
        {
          "name": "variable.parameter.ral",
          "match": "[a-zA-Z_][a-zA-Z0-9_-]*"
        },
        {
          "name": "variable.language.wildcard.ral",
          "match": "_"
        }
      ]
    },

    "deref-paren": {
      "match": "(\\$\\()([a-zA-Z_][a-zA-Z0-9_-]*)(\\))",
      "captures": {
        "1": { "name": "punctuation.definition.variable.begin.ral" },
        "2": { "name": "variable.other.ral" },
        "3": { "name": "punctuation.definition.variable.end.ral" }
      }
    },

    "deref-plain": {
      "match": "(\\$)([a-zA-Z_](?:[a-zA-Z0-9_-]*[a-zA-Z0-9_])?)",
      "captures": {
        "1": { "name": "punctuation.definition.variable.ral" },
        "2": { "name": "variable.other.ral" }
      }
    },

    "spread": {
      "name": "keyword.operator.spread.ral",
      "match": "\\.\\.\\."
    },

    "force-brace": {
      "name": "meta.force.ral",
      "begin": "!\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "keyword.operator.force.begin.ral" } },
      "endCaptures":   { "0": { "name": "keyword.operator.force.end.ral" } },
      "patterns": [
        { "include": "$self" }
      ]
    },

    "force-sigil": {
      "match": "(!)(?=[a-zA-Z_$\\{\\(\\[])",
      "name": "keyword.operator.force.ral"
    },

    "bypass": {
      "match": "(\\^)([^ \\t\\n|{}\\[\\]$<>\"',();]+)",
      "captures": {
        "1": { "name": "keyword.operator.bypass.ral" },
        "2": { "name": "entity.name.command.bypass.ral" }
      }
    },

    "tilde": {
      "match": "(?<![^\\s\\[({,;|])~(?=[\\s/\\])},;|]|$)",
      "name": "constant.language.tilde.ral"
    },

    "redirection": {
      "match": "([0-9])?(>{1,2}|<|>&)\\s*",
      "captures": {
        "1": { "name": "constant.numeric.fd.ral" },
        "2": { "name": "keyword.operator.redirect.ral" }
      }
    },

    "pipe-operator": {
      "match": "\\|",
      "name": "keyword.operator.pipe.ral"
    },

    "chain-operator": {
      "match": "\\?",
      "name": "keyword.operator.chain.ral"
    },

    "number": {
      "name": "constant.numeric.ral",
      "match": "[+-]?(?:(?:[0-9]+\\.[0-9]*|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?|[0-9]+)(?=$|[\\s|{}\\[\\]$^!<>\"'`();,]|:(?=[\\s,\\]})]|$))"
    },

    "boolean": {
      "name": "constant.language.boolean.ral",
      "match": "\\b(true|false)(?=$|[\\s|{}\\[\\]$^!<>\"'`();,]|:(?=[\\s,\\]})]|$))"
    },

    "unit": {
      "name": "constant.language.unit.ral",
      "match": "\\(\\)"
    },

    "control-name": {
      "name": "keyword.control.ral",
      "match": "\\b(if|for|try|case|while|spawn|gather|await|race|use|source|grant|within|map|filter|fold|reduce)(?=$|[\\s|{}\\[\\]$^!<>\"'`();,]|:(?=[\\s,\\]})]|$))"
    },

    "block": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.block.begin.ral" } },
      "endCaptures":   { "0": { "name": "punctuation.section.block.end.ral" } },
      "patterns": [
        { "include": "$self" }
      ]
    },

    "word": {
      "comment": "Consume whole words before scanning interior hashes or numeral suffixes.",
      "match": "(?:[^\\s|{}\\[\\]$^!<>\"'`();,:#?&]|:(?![\\s,\\]})]|$))(?:[^\\s|{}\\[\\]$^!<>\"'`();,:]|:(?![\\s,\\]})]|$))*"
    },

    "punctuation": {
      "patterns": [
        { "match": "[\\[\\]]", "name": "punctuation.section.bracket.ral" },
        { "match": ",",      "name": "punctuation.separator.comma.ral" },
        { "match": ";",      "name": "punctuation.terminator.statement.ral" },
        { "match": ":(?=[\\s,\\]})]|$)", "name": "punctuation.separator.colon.ral" }
      ]
    }
  }
}
