;; ral macOS Seatbelt base profile: the policy-independent preamble
;; `core/src/sandbox/macos.rs::build_profile` lays a grant's rules over.
;; Everything here holds for every entry, whatever the grant.  Why each
;; rule: docs/ral-wiki/internals/seatbelt-profile.md.
;;
;; Shape adapted from BrianSwift/macOSSandboxBuild's `confined.sb`:
;;   https://github.com/BrianSwift/macOSSandboxBuild/blob/master/confined.sb
;; Paths are inlined at build time rather than passed as `(param …)`s,
;; a grant's admits being variable-length.

(version 1)
(deny default)

;; Sending only: a kill *into* the sandbox still lands.  Sibling
;; per-command children are separate instances, so not each other's.
(allow signal (target same-sandbox))

;; libdispatch and libmalloc probe these on init and abort if denied.
(allow sysctl-read)

;; Named, never wholesale: a Mach name is a door to a daemon acting on
;; your behalf outside this profile.  The refusals — launchservicesd,
;; the pasteboard, SecurityServer — are data in `macos.rs`'s
;; `withheld_doors`, so the denial hint can quote them; keep in step.
;; Not a resolver door: the resolver's socket is `network-outbound`.
(allow mach-lookup
  ;; dyld locates the shared cache through launchd, before main().
  (global-name "com.apple.dyld")
  ;; libnotify, on the first notify_register_*.
  (global-name "com.apple.system.notification_center")
  ;; getpwuid/getgrgid: `~`, whoami, id.
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.opendirectoryd.membership")
  ;; os_log; denied, every libSystem process would drown the denial
  ;; log `sandbox::diag` reads.
  (global-name "com.apple.system.logger")
  (global-name "com.apple.logd")
  (global-name "com.apple.diagnosticd"))

;; No network rule here, and that silence closes DNS under `net: false`:
;; admitting `network-outbound` for any local socket would let a
;; hostname carry bytes out as a query label.  `net: true` appends
;; `macos-net.sbpl`.

;; Seatbelt gates fork() separately from execve().
(allow process-fork)

;; dyld reads the root inode before main().
(allow file-read* (literal "/"))

;; `2>/dev/null` and libc open these for write though /dev is readable.
(allow file-write* (literal "/dev/null"))
(allow file-write* (literal "/dev/zero"))
(allow file-write* (literal "/dev/dtracehelper"))
(allow file-write* (literal "/dev/tty"))
(allow file-ioctl (literal "/dev/dtracehelper"))

;; libc's first localtime_r; outside every grant prefix, and rustc, cc
;; and ld SIGABRT in tzsetwall_basic without it.
(allow file-read* (literal "/private/var/db/timezone/icutz"))

;; libdispatch, on first queue creation — a POSIX shm name, not Mach.
(allow ipc-posix-shm (ipc-posix-name "apple.shm.notification_center"))

;; Unfiltered, as in every macOS build sandbox: an ioctl acts on a
;; descriptor already held, and the device nodes the dangerous ones need
;; cannot be opened here.  The open-time gate is the boundary.
(allow file-ioctl)

;; CoreFoundation and libdispatch, during framework init.
(allow ipc-posix-shm)
