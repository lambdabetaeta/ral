# ral prelude — standard library

# Strings — direct builtins: upper, lower, re-split, re-match,
# re-replace, re-replace-all, string-replace, intercalate, slice,
# re-find-match, re-find-matches, dedent, shell-quote, shell-split, lines.
# Regex builtins carry the `re-` prefix because the first argument is
# a regex, not a literal substring; `string-replace` is the
# literal-string counterpart that demands an exactly-once match.
# (`join` itself is the coreutils command for joining lines from two
# files; ral's list-of-strings join is `intercalate` — interpose a
# separator between every pair.)  Use `$name` to obtain a first-class
# value (a synthesised thunk pinned to the primitive).
## Split a string into its Unicode-whitespace-delimited words.
let words = { |s| re-find-matches '\S+' $s }
## Decode stdin as a list of words.
let from-words = {
    let s = !{from-string}
    words $s
}

# Paths and value coercions — each is a directly registered builtin
# (resolve-path, absolute-path, file-info, list-dir, temp-dir, temp-file,
# int, float, str).  Filesystem predicates and size/line-count wrappers
# live below under "Filesystem queries".

# Control flow
# `each`, `map`, `filter`, `sort-list`, `sort-list-by`, `fold`
# are builtins under their bare names, all data-last.
# `for` is the traditional loop form: for <list> <fn>.
## Loop over a list for side effects.
let for = { |list fn| each $fn $list }
## Reduce without an initial value; list must be non-empty.
let reduce = { |f items|
    if !{is-empty $items} { fail [status: 1, message: "reduce: the list is empty; use fold if you have an initial value"] } else {
        let [head, ...tail] = $items
        fold $f $head $tail
    }
}

## Reverse a list.  Uses `fold` so the iteration is one Rust loop with
## one closure invocation per element, avoiding the O(n) per-call
## evaluator overhead that explicit ral-level recursion incurs.  Cons
## (`[$x, ...$acc]`) is O(1) amortised on the persistent list rep.
let reverse = { |items|
    fold { |acc x| return [$x, ...$acc] } [] $items
}

## Last element of a non-empty list; fails on empty.
let last = { |items|
    if !{is-empty $items} {
        fail [status: 1, message: "last: empty list has no last element"]
    } else {
        let [head, ...rest] = $items
        if !{is-empty $rest} { return $head } else { last $rest }
    }
}

## Get a map value, returning default if key is absent.
let get = { |m key default|
    if !{has $m $key} { return $m[$key] } else { return $default }
}

# List combinators
## Take elements from the front while predicate holds.
let take-while = { |pred items|
    let _go = { |xs acc|
        if !{is-empty $xs} {
            let reversed = !{reverse $acc}
            return $reversed
        } else {
            let [head, ...rest] = $xs
            if !{$pred $head} { _go $rest [$head, ...$acc] } else {
                let reversed = !{reverse $acc}
                return $reversed
            }
        }
    }
    _go $items []
}
## Drop elements from the front while predicate holds.
let drop-while = { |pred items|
    if !{is-empty $items} { return [] } else {
        let [head, ...rest] = $items
        if !{$pred $head} {
            drop-while $pred $rest
        } else { return $items }
    }
}
## Take the first n elements.
let take = { |n items|
    let _go = { |k xs acc|
        if $[$k <= 0 || !{is-empty $xs}] {
            let reversed = !{reverse $acc}
            return $reversed
        } else {
            let [head, ...rest] = $xs
            _go $[$k - 1] $rest [$head, ...$acc]
        }
    }
    _go $n $items []
}
## Drop the first n elements.
let drop = { |n items|
    if $[$n <= 0 || !{is-empty $items}] { return $items } else {
        let [_, ...rest] = $items
        drop $[$n - 1] $rest
    }
}
## `s` repeated `n` times; empty when `n <= 0`.
let repeat = { |n s| intercalate '' !{map { |_| return $s } !{range 0 $n}} }
## Pad `s` on the left with `c` to width `w`; never truncates.
let pad-left = { |w c s| return "!{repeat $[$w - !{length $s}] $c}$s" }
## Pad `s` on the right with `c` to width `w`; never truncates.
let pad-right = { |w c s| return "$s!{repeat $[$w - !{length $s}] $c}" }
## The extension of a path's last component, as an Option: `a.tar.gz` has
## `` `just 'gz'``, while `Makefile` and the dotfile `.bashrc` have `` `none``.
let extension = { |p|
    if !{re-match '[^/]\.[^./]*$' $p} { return `just !{re-find-match '[^.]*$' $p} } else { return `none }
}
## Prepend n spaces to every non-empty line.
let indent = { |n s|
    let spaces = repeat $n ' '
    let lns = lines $s
    let indented = map { |l| if $[not !{equal $l ''}] { "$spaces$l" } else { $l } } $lns
    intercalate "\n" $indented
}

# Error handling — `try` itself is a control-operator keyword, not a builtin.
## Retry body up to n times on failure.
let retry = { |n body|
    try $body { |err|
        if $[$n > 1] { retry $[$n - 1] $body } else { fail $err }
    }
}

# Concurrency, cleanup, observability — each primitive (`spawn`,
# `watch`, `await`, `race`, `cancel`) is a builtin under its
# non-underscored name; see `core/src/builtins.rs` for the registry.
# `par` below is prelude code over `spawn` and `await`.

## Parallel map over `items` with at most `jobs` concurrent blocks.
##
## `jobs <= 0` lets every item run in its own concurrent block
## (effectively unbounded).  Output order matches input order
## regardless of the order in which blocks complete — `par` always
## awaits the oldest still-running handle, so the caller sees a stable
## mapping that mirrors `map`.  Each item runs as a `spawn { $f $x }`
## whose await record's `value` field is unwrapped into the result
## list (stdout/stderr are captured in the per-handle buffers, as for
## any `spawn`).
##
## Fail-fast: the first block failure cancels every still-running
## sibling before re-raising, so no worker outlives the call — a
## detached remainder grinding on after the caller saw the failure is
## a shell-job semantics `par` refuses to have.  Completed-but-unread
## siblings are discarded with the rest; exactly the first observed
## error surfaces, intact.
let par = { |f items jobs|
    let limit = if $[$jobs <= 0] { return !{length $items} } else { return $jobs }

    let _par_abort = { |handles e|
        each { |h| cancel $h } $handles
        fail $e
    }

    let _par_drain = { |handles acc|
        if !{is-empty $handles} {
            reverse $acc
        } else {
            let [h, ...hs] = $handles
            let r = try { await $h } { |e| _par_abort $hs $e }
            _par_drain $hs [$r[value], ...$acc]
        }
    }

    let _par_go = { |rest running acc|
        if !{is-empty $rest} {
            let vals = !{_par_drain $running []}
            return [...$acc, ...$vals]
        } else {
            if $[!{length $running} < $limit] {
                let [x, ...xs] = $rest
                let h = spawn { let v = $f $x; return $v }
                _par_go $xs [...$running, $h] $acc
            } else {
                let [h, ...hs] = $running
                let r = try { await $h } { |e| _par_abort $hs $e }
                _par_go $rest $hs [...$acc, $r[value]]
            }
        }
    }

    _par_go $items [] []
}

## True once a handle has settled, false while its block is still running.
## Total over a finished handle: a `settled` block (whether it returned or
## failed) reports `true`, only a still-running (`pending`) block reports
## `false`.  Non-blocking: `poll` samples without waiting.  Like `await`,
## it fails on a cancelled handle.
let is-done = { |h|
    let polled = poll $h
    case $polled [
        `settled: { |_| return true },
        `pending: { |_| return false }
    ]
}

## Run body; suppress failure and return unit.  For fire-and-forget commands
## where the outcome is irrelevant.
let attempt = { |body| try { !$body; return () } { |_| return () } }

## Run body; return true on POSIX exit 0, false on any error or non-zero status.
let succeeds = { |body| try { !$body; return true } { |_| return false } }

# Filesystem queries — `exists`, `is-file`, `is-dir`, `is-link`,
# `is-readable`, `is-writable` are native builtins (see
# `core/src/builtins/predicates.rs`); they resolve their path
# argument against the within-scoped cwd, which the bundled `test`
# wrappers they replaced did not.
## Count a file's lines by `from-lines`' rule, in bounded memory.
let line-count  = { |p| fold-lines { |n _| return $[$n + 1] } 0 < $p }
## true if a file has zero bytes or a directory has no entries.
let file-empty  = { |p|
    if !{is-dir $p} {
        is-empty !{list-dir $p}
    } else {
        equal !{file-info $p}[size] 0
    }
}

# Map utilities
## Map keys to [key, value] pairs.
let entries = { |m| map { |k| return [$k, $m[$k]] } !{keys $m} }
## Map keys to their values as a list.
let values = { |m| map { |k| return $m[$k] } !{keys $m} }
## Merge two maps; b's entries win on conflict.
let union = { |a b| fold { |m k| return [...$m, $k: $b[$k]] } $a !{keys $b} }
## Keys present in both maps, with a's values.
let intersection = { |a b| fold { |m k| return [...$m, $k: $a[$k]] } [:] !{filter { |k| has $b $k } !{keys $a}} }
## Keys in a but not in b, with a's values.
let difference = { |a b| fold { |m k| if !{has $b $k} { return $m } else { return [...$m, $k: $a[$k]] } } [:] !{keys $a} }

# Standard library
## The identity function: returns its argument unchanged.  Useful as the
## key for `-by` combinators when the element is already the magnitude.
let id = { |x| return $x }

## Sum a list of numbers.
let sum = { |items| fold { |acc x| return $[$acc + $x] } 0 $items }

## The larger of two numbers.
let max = { |a b| if $[$a >= $b] { return $a } else { return $b } }
## The smaller of two numbers.
let min = { |a b| if $[$a <= $b] { return $a } else { return $b } }
## The largest element of a non-empty list.
let maximum = { |xs|
    if !{is-empty $xs} { fail [status: 1, message: "maximum: the list is empty"] } else { reduce $max $xs }
}
## The smallest element of a non-empty list.
let minimum = { |xs|
    if !{is-empty $xs} { fail [status: 1, message: "minimum: the list is empty"] } else { reduce $min $xs }
}

## Cartesian product of two lists, each pair combined by `f`.  Build a
## record in `f` to mix element types — lists are homogeneous — and to chain
## into higher dimensions; this is the meshgrid of a benchmark matrix:
##   let grid = cross $progs $strats { |p s| [prog: $p, strat: $s] }
##   cross $grid !{range 1 4} { |row r| [...$row, rep: $r] }
let cross = { |a b f| flat-map { |x| map { |y| $f $x $y } $b } $a }

## Partition `xs` into a map from string key to the list of elements that
## share it, computed by `key-fn`; first-seen order is preserved within
## each group.  Keys are strings (map keys always are) — build a composite
## key with interpolation, e.g. `{ |r| "$r[prog]/$r[strat]" }`.
let group-by = { |key-fn xs|
    fold { |acc x|
        let k = !{key-fn $x}
        if !{has $acc $k} { [...$acc, $k: [...$acc[$k], $x]] } else { [...$acc, $k: [$x]] }
    } [:] $xs
}

## The element of `xs` whose key is the median, ordered by `key-fn`.
## Lower-middle on even length; fails on the empty list.
let median-by = { |key-fn xs|
    if !{is-empty $xs} {
        fail [status: 1, message: "median-by: empty list has no median"]
    } else {
        let sorted = sort-list-by $key-fn $xs
        return $sorted[$[(!{length $sorted} - 1) / 2]]
    }
}

## The median element of `xs` ordered by its own value.
let median = { |xs| median-by $id $xs }

## Zip two lists into a list of pairs (tail-recursive).
let zip = { |a b|
    let _go = { |xs ys acc|
        if $[!{is-empty $xs} || !{is-empty $ys}] {
            let reversed = !{reverse $acc}
            return $reversed
        } else {
            let [xh, ...xt] = $xs
            let [yh, ...yt] = $ys
            _go $xt $yt [[$xh, $yh], ...$acc]
        }
    }
    _go $a $b []
}

## Map f over items, then flatten one level.
let flat-map = { |f items|
    let mapped = !{map $f $items}
    concat $mapped
}

## Find the first element matching pred, as an Option: `` `just`` the
## matching element, or `` `none`` when nothing matches.
let first = { |pred items|
    if !{is-empty $items} { return `none } else {
        let [head, ...rest] = $items
        if !{$pred $head} { return `just $head } else { first $pred $rest }
    }
}

## Eliminate an Option: the payload of `` `just``, or `default` for `` `none``.
let option-or = { |default opt|
    case $opt [
        `none: { |_| return $default },
        `just: { |x| return $x }
    ]
}

## Zip items with their indices: enumerate $xs → [[index: 0, item: x0], ...].
let enumerate = { |items|
    let count = !{length $items}
    map { |i| return [index: $i, item: $items[$i]] } !{range 0 $count}
}

## Flatten a list of lists one level (tail-recursive).
let concat = { |xss|
    let _go = { |remaining acc|
        if !{is-empty $remaining} {
            return $acc
        } else {
            let [head, ...rest] = $remaining
            _go $rest [...$acc, ...$head]
        }
    }
    _go $xss []
}

# Streaming (stdin, line by line).  `fold-lines` is a builtin; `map-lines`
# and `filter-lines` are ergonomic wrappers around it.
#
# Each `echo` below is its callback's *tail*, not a statement before one, and
# that is what makes these stages produce bytes rather than chatter: a
# statement's write escapes to the visible stream, a tail's write is the
# computation's payload and so is what a downstream stage reads.
#
# `filter-lines` spells its empty branch out for that reason.  An `if` with no
# `else` is a statement form — it runs its branch for effect and returns unit —
# so the `echo` would be chatter, and a filter whose output escapes instead of
# riding the payload cannot feed a downstream stage.
## Map a function over stdin lines, echoing results.
let map-lines = { |f|
    fold-lines { |_ line| echo !{$f $line} } ()
}
## Filter stdin lines by a predicate.
let filter-lines = { |pred|
    fold-lines { |_ line| if !{$pred $line} { echo $line } else {} } ()
}
## Apply a function to each stdin line.
let each-line = { |f|
    fold-lines { |_ line| !{$f $line}; return () } ()
}

# ANSI styling — `styled` looks up its code and asks `_ansi-ok` when it
# writes, so the wrap is a no-op wherever colour is unsupported; no prelude
# constant closes over that fact, since a prelude binding can only be a
# value or a thunk (§6.2) and "is stdout a colour terminal" is neither.
## Wrap `text` in an ANSI style code, resetting after: `style` is `reset`,
## `bold`, `dim`, or one of `red green yellow blue magenta cyan`. Plain text
## when colour is unsupported.
let styled = { |style text|
    if !{_ansi-ok} {
        let code =
            if    !{equal $style 'reset'}   { '\e[0m'    }
            elsif !{equal $style 'bold'}    { '\e[1m'    }
            elsif !{equal $style 'dim'}     { '\e[2m'    }
            elsif !{equal $style 'red'}     { '\e[0;31m' }
            elsif !{equal $style 'green'}   { '\e[0;32m' }
            elsif !{equal $style 'yellow'}  { '\e[0;33m' }
            elsif !{equal $style 'blue'}    { '\e[0;34m' }
            elsif !{equal $style 'magenta'} { '\e[0;35m' }
            elsif !{equal $style 'cyan'}    { '\e[0;36m' }
            else { fail [status: 2, message: "styled: unknown style '$style'"] }
        return "$code$text\e[0m"
    } else {
        return $text
    }
}

# Editor state — all _ed-* operations are host builtins registered by
# the ral crate (see ral/src/repl/plugin/ed_builtins.rs).  The underscore
# prefix hides them from `help`; plugin handlers call them directly
# without going through any prelude wrapper layer.

## Test if x is an element of items.
let elem = { |x items|
    if !{is-empty $items} { return false } else {
        let [head, ...rest] = $items
        if !{equal $head $x} { return true } else { elem $x $rest }
    }
}

## Test if items contains x (collection-first; delegates to `elem`).
let contains = { |items x| elem $x $items }

## De-duplicate a list, keeping the first occurrence of each element
## (compared with `equal`); the result preserves first-seen order.
let nub = { |xs| fold { |acc x| if !{elem $x $acc} { $acc } else { [...$acc, $x] } } [] $xs }

## Spawn a thunk under audit and return the handle.  The spawned block
## never fails (failure is data in the audit report), so `await $h` is
## always safe and the handle survives run boundaries.
let defer = { |body| spawn { audit { !$body } } }

## The `` `command`` facts of an audit report's trail, in trail order;
## every other kind of fact is passed over.  Usage:
## `each { |c| echo $c[argv][0] } !{commands $r}`.
let commands = { |report|
    fold { |acc o|
        case $o[what] [
            `command: { |c| return [...$acc, $c] },
            `write:   { |_| return $acc },
            `read:    { |_| return $acc },
            `grep:    { |_| return $acc },
            `check:   { |_| return $acc },
            `worker:  { |_| return $acc },
            `act:     { |_| return $acc }
        ]
    } [] $report[trail]
}

## True when the audited body returned, false when it failed.
let succeeded = { |report|
    case $report[outcome] [
        `ok:  { |_| return true },
        `err: { |_| return false }
    ]
}

## Decode the stdout/stderr Bytes from an `await` result into a String.
## Usage: `bytes-to-string $r[stdout]`.
let bytes-to-string = { |bytes| to-bytes $bytes | from-string }
