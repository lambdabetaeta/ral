# Opt-in Git config-read extension for `--extend-base`.
#
# `reasonable` and `read-only` already read `~/.gitconfig` as part of
# their default fs grant.  This file is for the tighter bases
# (`minimal`, `confined`): they grant no home reads, and they admit
# only the *system* git under `/usr/bin/` — a Homebrew git under
# `/opt/homebrew/bin` is not on their exec subpaths at all:
#
#     exarch --base minimal   --extend-base exarch/examples/git.exarch.ral
#     exarch --base confined  --extend-base exarch/examples/git.exarch.ral
#
# It adds `~/.gitconfig` + `` `xdg-config git `` for read, so git finds
# user.name / user.email / aliases; and `` `name git `` for exec, so git
# is admitted wherever it resolves — including a Homebrew install the
# base's binary-dir subpaths don't cover.
#
# No credential-deny block is needed: `--extend-base` preserves the
# base's `deny_paths` — gh/op/gcloud and the rest stay denied — so an
# overlay never has to re-state a veto to keep it.

return [
  fs: [
    read: [
      `home .gitconfig,
      `xdg-config git,
    ],
  ],
  exec: [
    allow: [`name git],
  ],
]
