# Opt-in Git config-read extension for `--extend`.
#
# `reasonable` and `read-only` already read `~/.gitconfig` as part of
# their default fs grant.  This file is for the tighter bases
# (`minimal`, `confined`): they grant no home reads, and they admit
# only the platform's tool roots (`system`; `confined` also
# `homebrew`), so under `minimal` a Homebrew git is not on its exec
# subpaths at all:
#
#     exarch --base minimal   --extend exarch/examples/git.exarch.ral
#     exarch --base confined  --extend exarch/examples/git.exarch.ral
#
# It adds `~/.gitconfig` + `` `xdg-config git `` for read, so git finds
# user.name / user.email / aliases; and `` `name git `` for exec, so git
# is admitted by name wherever it resolves, a Homebrew install under
# `minimal` included.
#
# No credential-deny block is needed: `--extend` preserves the
# base's `deny_paths` — gh/op/gcloud and the rest stay denied — so an
# overlay never has to re-state a veto to keep it.

return [
  fs: [
    read: [
      `home .gitconfig,
      `xdg-config git,
    ],
  ],
  exec: [
    allow: [`name git],
  ],
]
