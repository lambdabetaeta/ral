#!/usr/bin/env ral

# Grep with surrounding-line context, like `grep -rn -C 2 PATTERN`.
#
#     ral grep-context.ral 'TODO'           # search cwd
#     ral grep-context.ral 'TODO' src/      # scope to src/
#
# `grep-files PATTERN` returns a list of `[file, line, text]`
# records from a recursive walk of cwd.  The bash post-grep dance is
# to re-parse `file:line:text` back into pieces; here the pieces
# never left.  `view-text-around PATH LINE PEEK` reads the file
# centred on a given 1-based line — composing them is one loop, no
# parsing — and tags each line with the witness `edit` checks.

if !{is-empty $args} {
    echo 'usage: grep-context.ral PATTERN [DIR]' 1>&2
    exit 2
}

let [pattern, ...rest] = $args
let where = if !{is-empty $rest} { return '.' } else { return $rest[0] }

within [dir: $where] {
    let hits = !{grep-files $pattern}

    if !{is-empty $hits} {
        echo 'no matches'
        exit 1
    }

    for $hits { |h|
        echo "!{styled $ansi-cyan "==> $h[file]:$h[line]"}"
        view-text-around $h[file] $h[line] 2
        echo ''
    }
}
