# `read-only` bake-in.  Same shape as `reasonable` for reads and
# exec, but the agent cannot modify the project tree — writes are
# restricted to scratch directories only.
#
# Use when the agent's job is to investigate, review, or report on a
# tree without modifying it: code review, audit, "explain this
# repo", static analysis flows.  Network is on so the agent can
# fetch context (e.g. `gh pr view`, fetch upstream docs).
#
# To allow writes for a specific subtree, layer a `--restrict` (which
# can only further attenuate, not widen).  To start broader, use
# `reasonable` and lock down via deny.

return [
  audit: false,
  net:   true,

  shell: [chdir: true],

  # Reads as broad as `reasonable`: the agent should be able to read
  # the full project tree, system caches, tool configs.  All the
  # usual toolchain caches stay readable so e.g. `cargo metadata`
  # can resolve without rebuilding.
  fs: [
    read: [
      'cwd:',                  # the project tree the agent is reviewing
      '/tmp',
      'tempdir:',              # `$TMPDIR` on macOS — distinct from /tmp
      'xdg:config',            # ${XDG_CONFIG_HOME:-~/.config}
      'xdg:data',              # ${XDG_DATA_HOME:-~/.local/share}
      'xdg:cache',             # ${XDG_CACHE_HOME:-~/.cache}
      'xdg:state',             # ${XDG_STATE_HOME:-~/.local/state}
      'xdg:bin',               # ${XDG_BIN_HOME:-~/.local/bin}
      '~/Library/Caches',      # macOS-native CLI caches outside the XDG world
      '~/.cargo/registry',
      '~/.cargo/git',
      '~/.rustup',
      '~/go',
      '~/.npm',
      '~/.gem',
      '~/.bundle',
      '~/.gradle/caches',
      '~/.m2/repository',
      '~/.pyenv',
      '~/.rbenv',
      '~/.nvm',

      # Git config — `git log`, `git show`, `git diff` are core to
      # the review use case.  See `reasonable` for the credential
      # surface analysis: SSH keys and gpg keys stay unadmitted, so
      # authenticated network-git fails without explicit opt-in.
      '~/.gitconfig',
      'xdg:config/git',
    ],

    # Writes only to scratch — the project tree is off-limits.  This is
    # the load-bearing difference vs `reasonable`: `cwd:` is read-only,
    # and any tool that wants to modify the tree fails closed.  Tools
    # that need a workspace can use `$EXARCH_SCRATCH` (under
    # `tempdir:`) as their scratch root.
    write: [
      '/tmp',
      'tempdir:',
    ],

    # Same credential carve-outs as `reasonable`: these are present in
    # `xdg:config` (read above) but the contents are OAuth tokens and
    # session secrets the agent should never see, even read-only.
    deny: [
      'xdg:config/gh',         # gh CLI — hosts.yml has the GitHub OAuth token
      'xdg:config/op',         # 1Password CLI session
      'xdg:config/gcloud',     # Google Cloud SDK OAuth
    ],
  ],

  # Exec mirrors `reasonable` — the agent has the same toolset.  No
  # write capability means `rm`, `mv`, `cp`, `mkdir`, `touch`,
  # `truncate` and friends are still admitted as commands but fail at
  # the fs gate when their target lies under `cwd:`.  This is
  # intentional: the agent can attempt the action and observe the
  # denial, rather than having "tool not found" surprise.
  exec: [
    'xdg:bin/':            'allow',
    'system:':             'allow',   # the platform's tool roots — see core/src/path/sigil.rs
    '/usr/local/bin/':     'allow',
    '/usr/local/sbin/':    'allow',
    '/usr/sbin/':          'allow',
    '/sbin/':              'allow',
    'cwd:/':               'allow',
    '/tmp/':               'allow',
    'tempdir:/':           'allow',

    # Coreutils
    base64:    'allow',
    basename:  'allow',
    cat:       'allow',
    comm:      'allow',
    cp:        'allow',
    cut:       'allow',
    date:      'allow',
    df:        'allow',
    dirname:   'allow',
    du:        'allow',
    echo:      'allow',
    env:       'allow',
    head:      'allow',
    hostname:  'allow',
    join:      'allow',
    ln:        'allow',
    ls:        'allow',
    mkdir:     'allow',
    mktemp:    'allow',
    mv:        'allow',
    nproc:     'allow',
    paste:     'allow',
    printenv:  'allow',
    printf:    'allow',
    pwd:       'allow',
    readlink:  'allow',
    realpath:  'allow',
    rm:        'allow',
    rmdir:     'allow',
    seq:       'allow',
    sha256sum: 'allow',
    sha512sum: 'allow',
    shuf:      'allow',
    sleep:     'allow',
    sort:      'allow',
    tac:       'allow',
    tail:      'allow',
    tee:       'allow',
    test:      'allow',
    touch:     'allow',
    tr:        'allow',
    truncate:  'allow',
    uname:     'allow',
    uniq:      'allow',
    wc:        'allow',
    whoami:    'allow',
    yes:       'allow',

    # Shells.  `cmd`/`powershell`/`pwsh` are the Windows analogues of
    # bash/zsh — `system:` admits them unconditionally via
    # `%SystemRoot%\System32` and the PowerShell home, so they get the
    # same deny.
    sh:   'allow',
    bash: 'deny',
    zsh:  'deny',
    cmd:        'deny',
    powershell: 'deny',
    pwsh:       'deny',

    # Version control.  `git` is admitted; review work needs
    # `git log`, `git diff`, `git show`.  Writes go to scratch only,
    # so `git commit` (which writes objects into cwd:/.git) fails by
    # fs gate — the agent can read history but not rewrite it.  See
    # `reasonable` for the credential-helper analysis.
    git: 'allow',
    gh:  'allow',

    # Net fetch
    curl: 'allow',
    wget: 'allow',

    # Search / inspect
    rg:    'allow',
    fd:    'allow',
    jq:    'allow',
    yq:    'allow',
    awk:   'allow',
    gawk:  'allow',
    find:  'allow',
    xargs: 'allow',
    file:  'allow',
    which: 'allow',

    # Scripting runtimes (one-off scripts, common as tooling)
    python:  'allow',
    python3: 'allow',

    # Archives
    tar:     'allow',
    gzip:    'allow',
    gunzip:  'allow',
    bzip2:   'allow',
    bunzip2: 'allow',
    xz:      'allow',
    zip:     'allow',
    unzip:   'allow',

    # Diff / patch / docs
    diff:  'allow',
    patch: 'allow',
    less:  'allow',
    man:   'allow',

    # Process inspection (read-only)
    ps:    'allow',
    lsof:  'allow',
    pgrep: 'allow',
  ],
]
