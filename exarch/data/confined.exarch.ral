# `confined` bake-in.  Build-jail profile shaped after
# BrianSwift/macOSSandboxBuild's `confined.sb`: tight reads (working
# tree + scratch + system base), tight writes (working tree + scratch),
# no network, exec admits host binaries by subpath — the per-name
# entries below name the bundled tools, which have no path to match.
#
# Use when the agent's job is to compile or process *this one tree*
# and nothing else: `--base confined` for ad-hoc invocations,
# `--base confined --extend extra.ral` to widen for one tool.

return [
  net:   `offline,   # no network — confined.sb has the same default

  # The working tree, plus scratch directories.  Nothing else readable;
  # nothing else writable.  System paths needed by the platform runtime
  # (libc, dyld, /private/etc, …) come automatically from the read
  # floor — see `core/src/capability/fs.rs::floor`.
  fs: [
    read: [
      `cwd .,          # working tree
      `tempdir .,      # $TMPDIR (per-session scratch)
      `absolute /tmp,  # legacy scratch
    ],
    write: [
      `cwd .,  # build artefacts land here
      `tempdir .,
      `absolute /tmp,
    ],
  ],

  # Host binaries are admitted by subpath, never enumerated: the build
  # sandbox trusts whatever lives in the platform's tool roots
  # (`dir `system`, and `dir `homebrew` for a Homebrew tree when the host
  # has one; both are rows of `core/src/guard/toolchains.rs`) — a build
  # jail plausibly needs a Homebrew-installed compiler.  Apple's
  # toolchain (CommandLineTools, Xcode) is among the `system` roots, so
  # `gcc → cc1 → as → ld` resolves without listing each tool here.
  exec: [
    allow: [
      `dir `system,                   # sh, bash, uname, dirname, env, sed, awk, …
      `dir `homebrew,                 # Homebrew-installed tools
      `dir `absolute /usr/local/bin,  # user-installed CLI tools
      `dir `cwd .,                    # ./configure, ./build.sh, etc.
      `dir `tempdir .,                # build-tree-shadowed scratch
      `dir `absolute /tmp,

      # The coreutils linked into the ral binary (`core/src/uutils.rs`).
      # These are the one exception to "host binaries by subpath": a
      # bundled tool is spawned by bare name and never resolved on disk, so
      # no prefix above can reach it and it must be named.  Silence here is
      # not tightness — it is an agent that cannot `ls`.  `cmp`, `diff` and
      # `rg` bundle only under non-default features, so they are host
      # binaries here; a build that turns those on fails
      # `every_grantable_base_settles_the_bundled_tools`, which names them.
      #
      # `rm`, `mv` and `truncate` are admitted like any other: what a
      # confined child may destroy is settled by the `fs.write` prefixes
      # above, which stop at the working tree and scratch.  Withholding the
      # verbs as well would break `make clean` without protecting one byte
      # the fs guard does not already hold.
      #
      # The `unix:` half of the set (`id`, `kill`, `stat`, `tac`, `test`,
      # `timeout`) cannot link on Windows; decoding drops a name this platform
      # bundles nowhere, so listing them here stays honest on every host.
      `name base64,
      `name basename,
      `name cat,
      `name comm,
      `name cp,
      `name cut,
      `name date,
      `name df,
      `name dirname,
      `name du,
      `name env,
      `name head,
      `name hostname,
      `name id,
      `name join,
      `name kill,
      `name ln,
      `name ls,
      `name mkdir,
      `name mktemp,
      `name mv,
      `name nproc,
      `name paste,
      `name printenv,
      `name printf,
      `name pwd,
      `name readlink,
      `name realpath,
      `name rm,
      `name rmdir,
      `name seq,
      `name sha256sum,
      `name sha512sum,
      `name shuf,
      `name sleep,
      `name sort,
      `name split,
      `name stat,
      `name tac,
      `name tail,
      `name tee,
      `name test,
      `name timeout,
      `name touch,
      `name tr,
      `name truncate,
      `name uname,
      `name uniq,
      `name wc,
      `name whoami,
      `name yes,
    ],
  ],
]
