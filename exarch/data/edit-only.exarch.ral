# `edit-only` bake-in.  Same shape as `read-only` for reads and
# exec, but the agent may edit the project tree — writes go to the
# working directory (plus ephemeral scratch/temp for tooling).
#
# Use when the agent's job is to edit the project tree — apply patches,
# refactor, fix — without running a build or test suite.  Network is on
# so the agent can fetch context (e.g. `gh pr view`, upstream docs).
#
# To forbid writes to a specific subtree, layer a `--restrict` (which
# can only further attenuate, not widen).  To start read-only, use
# `read-only`; to start broader, use `reasonable` and lock down via deny.

return [
  gpu: `withheld,  # no GPU; `reasonable` and `dangerous` leave it on

  # Reads as broad as `reasonable`: the agent should be able to read
  # the full project tree, system caches, tool configs.  All the
  # usual toolchain caches stay readable so e.g. `cargo metadata`
  # can resolve without rebuilding.
  fs: [
    read: [
      `cwd .,                # the project tree the agent is editing
      `absolute /tmp,
      `tempdir .,            # `$TMPDIR` on macOS — distinct from /tmp
      `scratch .,            # the session's own scratch (`$EXARCH_SCRATCH`)
      `xdg-config .,         # ${XDG_CONFIG_HOME:-~/.config}
      `xdg-data .,           # ${XDG_DATA_HOME:-~/.local/share}
      `xdg-cache .,          # ${XDG_CACHE_HOME:-~/.cache}
      `xdg-state .,          # ${XDG_STATE_HOME:-~/.local/state}
      `xdg-bin .,            # ${XDG_BIN_HOME:-~/.local/bin}
      `home Library/Caches,  # macOS-native CLI caches outside the XDG world
      `home .cargo/registry,
      `home .cargo/git,
      `home .rustup,
      `home go,
      `home .npm,
      `home .gem,
      `home .bundle,
      `home .gradle/caches,
      `home .m2/repository,
      `home .pyenv,
      `home .rbenv,
      `home .nvm,

      # Git config — `git log`, `git show`, `git diff` are core to
      # the editing use case.  See `reasonable` for the credential
      # and signing analysis.
      `home .gitconfig,
      `home .gitignore_global,
      `xdg-config git,
    ],
    # Writes go to the working tree (the folder being edited) plus
    # ephemeral scratch directories.  Unlike `read-only`, `cwd .` is
    # writable so the agent can apply edits.
    write: [
      `cwd .,
      `absolute /tmp,
      `tempdir .,
      `scratch .,
    ],

    # Same credential denies as `reasonable` — gh, op, gcloud tokens
    # should never be readable, even in an editing session.
    # exarch's and synod's own credential files are denied in
    # composition (`policy::for_invocation`), not here.
    deny: [
      `xdg-config gh,
      `xdg-config op,
      `xdg-config gcloud,
    ],
  ],

  # Exec mirrors `reasonable` — the agent has the same toolset.
  # Unlike `read-only`, the write set includes `cwd .` so file
  # mutations succeed.
  #
  # And unlike either, no directory this profile can *write* is
  # admitted here: `reasonable`'s `dir `cwd .`, `dir `absolute /tmp`,
  # `dir `tempdir .` and `dir `scratch .` admits are absent.  A directory that is both writable and
  # exec-admitted makes every deny below advisory — `cp $(which git)
  # ./g` and run `./g`, a copy no name veto and no `#"/git$"` regex
  # ever sees.  An editing agent runs tools, not the tree it edits, so
  # the admits cost nothing here and their absence is what lets the
  # denies mean something.
  #
  # That holds only where `` `cwd . `` covers no admitted directory.
  # Launched from `~`, it covers `` `dir `xdg-bin . ``, which is then
  # both writable and runnable, and the `git` veto below is advisory.
  # To see which folders a launch leaves so, run from the directory in
  # question:
  #
  #     ral --audit --capabilities edit-only.exarch.ral -c true
  #
  # and read the `deputy` checks of the trail it prints; each names a
  # prefix that is both writable and runnable.
  exec: [
    allow: [
      `dir `xdg-bin .,
      `dir `system,    # the platform's tool roots (table: core/src/authority/grant/toolchains.rs)
      `dir `homebrew,  # the Homebrew prefixes present (same table)
      `dir `absolute /usr/local/bin,
      `dir `absolute /usr/local/sbin,
      `dir `absolute /usr/sbin,
      `dir `absolute /sbin,

      # Coreutils
      `name base64,
      `name basename,
      `name cat,
      `name comm,
      `name cp,
      `name cut,
      `name date,
      `name df,
      `name dirname,
      `name du,
      `name echo,
      `name env,
      `name head,
      `name hostname,
      `name id,
      `name join,
      `name kill,
      `name ln,
      `name ls,
      `name mkdir,
      `name mktemp,
      `name mv,
      `name nproc,
      `name paste,
      `name printenv,
      `name printf,
      `name pwd,
      `name readlink,
      `name realpath,
      `name rm,
      `name rmdir,
      `name seq,
      `name sha256sum,
      `name sha512sum,
      `name shuf,
      `name sleep,
      `name sort,
      `name split,
      `name stat,
      `name tac,
      `name tail,
      `name tee,
      `name test,
      `name timeout,
      `name touch,
      `name tr,
      `name truncate,
      `name uname,
      `name uniq,
      `name wc,
      `name whoami,
      `name yes,

      # Shells.  `sh` only; the denied ones are below.
      `name sh,

      # Version control.  `gh` is admitted for PR review and issue fetching;
      # `git` is denied below.
      `name gh,

      # Net fetch
      `name curl,
      `name wget,

      # Search / inspect
      `name rg,
      `name fd,
      `name jq,
      `name yq,
      `name awk,
      `name gawk,
      `name find,
      `name xargs,
      `name file,
      `name which,

      # Scripting runtimes (one-off scripts, common as tooling)
      `name python,
      `name python3,

      # Archives
      `name tar,
      `name gzip,
      `name gunzip,
      `name bzip2,
      `name bunzip2,
      `name xz,
      `name zip,
      `name unzip,

      # Diff / patch / docs
      `name cmp,
      `name diff,
      `name patch,
      `name less,
      `name man,

      # Process inspection (read-only)
      `name ps,
      `name lsof,
      `name pgrep,
    ],
    deny: [
      # Shells.  `cmd`/`powershell`/`pwsh` are the Windows analogues of
      # bash/zsh — `system` admits them unconditionally via
      # `%SystemRoot%\System32` and the PowerShell home, so they get the
      # same deny.
      `name bash,
      `name zsh,
      `name cmd,
      `name powershell,
      `name pwsh,

      # Version control.  `git` is denied so that committing stays a
      # human decision: bar the launch-from-`~` case above, no admitted
      # directory is writable, so there is nowhere to put a copy of it
      # that this profile would then run.  The veto is still a veto over *names*, not over what
      # a binary does — an admitted tool that shells out to a library
      # rather than to `git` is not what it stops.  Use ral builtins
      # (`grep-files`, `view-text`, `edit-replace`) for code exploration and
      # modification; use `gh pr view` or `curl` to fetch remote context.
      # `gh` remains admitted for PR review and issue fetching.
      `name git,
    ],
  ],
]
