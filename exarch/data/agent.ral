# exarch agent helper library — sourced into the shell at boot

## `view-text`, `view-hash`, `grep-files`, `edit-hash`, and `edit-replace` are exarch
## host builtins (`exarch/src/shell_eval/builtins.rs`): each reads the whole file in
## Rust, below the redirect frame, and is a single logical surface.  `view-hash` and
## `edit-hash` share one witness algorithm, so the hash a read shows is exactly the
## handle `edit-hash` checks; `view-text` is the same range without the witness,
## which `edit-replace` does not need.  The two helpers below re-centre each range.

## Around a file, show `peek` lines on each side of `line` (`2*peek + 1` total),
## clamped at the top of the file: `view-text-around foo.rs 120 3`.
let view-text-around = { |path line peek|
    let lo = if $[$line > $peek] { return $[$line - $peek] } else { return 1 }
    view-text $path $lo $[$line + $peek + 1]
}

## The same window with each line's witness, for an `edit-hash` that follows.
let view-hash-around = { |path line peek|
    let lo = if $[$line > $peek] { return $[$line - $peek] } else { return 1 }
    view-hash $path $lo $[$line + $peek + 1]
}

# --- task management ---------------------------------------------------------
# Schema: { id: Int, desc: String, status: `open|`doing|`blocked|`done, tags: [String], notes: String }
# Id allocation: max(ids) + 1; freed ids are recycled.
# The list lives on the "tasks" pin, not in a binding: every mutating tag of
# `exarch-tasks` reads the register through `tasks-list`, changes it, and
# writes it back through `tasks-sync`, so state survives blocks, `within`,
# and skipped rebinds.  `exarch-pins` is foreground-only, so `exarch-tasks`
# is too — not inside `spawn { … }`, and not as a stage of a `|` pipeline.
# The pin clears when no work is left, so a finished board stops being named
# by the boundary nudge.  No Rust knows what a task or a goal is: both kits
# below are pure prelude over `exarch-pins`.

let task-new = { |id desc|
  [ id: $id, desc: $desc, status: `open, tags: [], notes: "" ]
}

let task-statuses = [`open, `doing, `blocked, `done]

# --- per-field setters ---

let task-set-status = { |t v| [id: $t[id], desc: $t[desc], status: $v,         tags: $t[tags], notes: $t[notes]] }
let task-set-tags   = { |t v| [id: $t[id], desc: $t[desc], status: $t[status], tags: $v,       notes: $t[notes]] }
let task-set-notes  = { |t v| [id: $t[id], desc: $t[desc], status: $t[status], tags: $t[tags], notes: $v        ] }

## Tags render as one comma-joined, bracketed span on the tasks card, so a
## tag holding `,` or `]` would be unreadable back out; refuse it rather than
## corrupt the round trip.  `where` names the tag that was asked for.
let check-tag = { |where g|
  if !{re-match #'[,\]]'# $g} {
    fail [status: 1, message: "exarch-tasks `$where: tag '$g' may not contain ',' or ']' — tags render as a comma-joined, bracketed span on the tasks card"]
  } else { () }
}

# --- id allocation ---

let tasks-next-id = { |ts|
  let ids = map { |t| $t[id] } $ts
  if !{is-empty $ids} { 1 }
    else { $[!{fold { |acc x| if $[$x > $acc] { $x } else { $acc } } 0 $ids} + 1] }
}

# --- the tasks card, and its inverse ------------------------------------------
# `tasks-card` and `tasks-decode` are the kit's serialization pair: a strong
# `text` heading, a `measure` gauge, then a `fields` matrix, one row per task,
# `label: "#<id>"`, `value` a `text` of exactly four positionally-decoded
# spans — status word (chrome by status: done->ok, doing->warn, blocked->bad,
# open->muted), the two-space-led description, the tag list (empty or " [a,b]"),
# and the notes (empty or " -- text").  Rendering tags and notes is what a
# readable register demands: a field the card never shows cannot survive a read
# back.  The heading is the card's own label, the way `exarch-goal `set`` writes
# one: a leading one-line `text` mark is what the framed renderer lifts into the
# top rule, so the gauge counts what is completed rather than doubling as the title.

let tasks-card = { |ts|
  let row = { |t|
    let chrome =
      if    !{equal $t[status] `done}    { [role: "ok",    word: "done"] }
      elsif !{equal $t[status] `doing}   { [role: "warn",  word: "doing"] }
      elsif !{equal $t[status] `blocked} { [role: "bad",   word: "blocked"] }
      else                                { [role: "muted", word: "open"] }
    let tag-str  = if !{is-empty $t[tags]}  { "" } else { " [!{intercalate "," $t[tags]}]" }
    let note-str = if !{equal $t[notes] ""} { "" } else { " -- $t[notes]" }
    [label: "#$t[id]", value: `text [spans: [
      [role: $chrome[role], text: $chrome[word]],
      [role: "", text: "  $t[desc]"],
      [role: "", text: $tag-str],
      [role: "", text: $note-str],
    ]]]
  }
  `card [`text [spans: [[role: "strong", text: "tasks"]]],
         `measure [label: "completed", value: !{length !{filter { |t| equal $t[status] `done} $ts}}, max: !{length $ts}],
         `fields [rows: !{map $row $ts}]]
}

## `marks` is one homogeneous list, so single-tag `case`s over different
## elements would close its element type around whichever table ran first;
## the one `describe` case names every tag, keeping the list one type.
let tasks-decode = { |v|
  if !{equal $v ()} { [] }
  else {
    try {
      case $v [
        `card: { |marks|
          let describe = { |m| case $m [
            `text:    { |_|          [kind: "text",    rows: []] },
            `measure: { |_|          [kind: "measure", rows: []] },
            `fields:  { |[rows: rs]| [kind: "fields",  rows: $rs] },
          ] }
          let [d0, d1, d2] = map $describe $marks
          if !{equal $d0[kind] "text"}    { () } else { fail [status: 1, message: "not task-shaped"] }
          if !{equal $d1[kind] "measure"} { () } else { fail [status: 1, message: "not task-shaped"] }
          if !{equal $d2[kind] "fields"}  { () } else { fail [status: 1, message: "not task-shaped"] }
          map { |r|
            let [label: lbl, value: valv] = $r
            case $valv [
              `text: { |[spans: sp]|
                let [s0, s1, s2, s3] = $sp
                let [text: word]     = $s0
                let [text: dtext]    = $s1
                let [text: tagtext]  = $s2
                let [text: notetext] = $s3
                let status =
                  if    !{equal $word "done"}    { `done }
                  elsif !{equal $word "doing"}   { `doing }
                  elsif !{equal $word "blocked"} { `blocked }
                  elsif !{equal $word "open"}    { `open }
                  else  { fail [status: 1, message: "not task-shaped"] }
                let tags =
                  if !{equal $tagtext ""} { [] }
                  else { re-split "," !{slice $tagtext 2 $[!{length $tagtext} - 3]} }
                let notes = if !{equal $notetext ""} { "" } else { slice $notetext 4 $[!{length $notetext} - 4] }
                [ id: !{int !{slice $lbl 1 $[!{length $lbl} - 1]}}, desc: !{slice $dtext 2 $[!{length $dtext} - 2]},
                  status: $status, tags: $tags, notes: $notes ]
              },
            ]
          } $d2[rows]
        },
      ]
    } { |_|
      fail [status: 1, message: "exarch-tasks: the card under the 'tasks' pin is not task-shaped — expected `text [spans: [heading]] then `measure [label, value, max] then `fields [rows: [[label: \"#<id>\", value: `text [spans: [status, desc, tags, notes]]], …]], four spans per row"]
    }
  }
}

let tasks-list = { tasks-decode !{exarch-pins `read "tasks"} }

## The kit's one write point: an empty or all-`done` list clears the slot —
## no outstanding work, no pin — otherwise it holds `tasks-card`'s rendering.
## Answers `ts` unchanged, so every `exarch-tasks` arm can end by calling this.
let tasks-sync = { |ts|
  if !{is-empty !{filter { |t| $[not !{equal $t[status] `done}] } $ts}} { exarch-pins `clear "tasks" }
  else { exarch-pins `set [key: "tasks", body: !{tasks-card $ts}] }
  $ts
}

## Rewrite the task with `id` through `f`, leaving the rest alone: the shape
## every field-changing tag below has in common.
let tasks-edit = { |id f|
  tasks-sync !{map { |t| if $[$t[id] == $id] { $f $t } else { $t } } !{tasks-list}}
}

## The task kit's one entry point: every arm answers the task list after the
## transition, `list` being the arm that transitions nothing. This uniformity
## is load-bearing, not a style choice — a ral closure has one return type
## across all `case` arms.  An invalid `status` `warn`s and answers the list
## unchanged rather than failing the caller's script.
let exarch-tasks = { |cmd|
  case $cmd [
    `list:   { |_| !{tasks-list} },
    `clear:  { |_| tasks-sync [] },
    `add:    { |desc|
                 let ts = !{tasks-list}
                 tasks-sync [...$ts, !{task-new !{tasks-next-id $ts} $desc}] },
    `remove: { |id| tasks-sync !{filter { |t| $[$t[id] != $id] } !{tasks-list}} },
    `status: { |[id: id, status: s]|
                 if !{elem $s $task-statuses} { tasks-edit $id { |t| task-set-status $t $s } }
                 else {
                   warn "exarch-tasks `status: invalid status -- !{to-string $s | from-string} (expected open|doing|blocked|done)"
                   !{tasks-list}
                 } },
    `tag:    { |[id: id, tag: g]|    check-tag "tag" $g
                                     tasks-edit $id { |t| task-set-tags $t [...$t[tags], $g] } },
    `untag:  { |[id: id, tag: g]|    tasks-edit $id { |t| task-set-tags $t !{filter { |x| $[not !{equal $x $g}] } $t[tags]} } },
    `note:   { |[id: id, note: n]|   tasks-edit $id { |t| task-set-notes $t $n } },
    `retag:  { |[id: id, tags: gs]|  for $gs { |g| check-tag "retag" $g }
                                     tasks-edit $id { |t| task-set-tags $t $gs } },
    `save:   { |path|
                 ## `to-json`/`from-json` do not round-trip a bare variant (a JSON tag
                 ## reads back as a record, not `status` itself), so `status` crosses
                 ## the file as its word and is translated back on the way in; every
                 ## other field is already JSON-native.
                 let ts = !{tasks-list}
                 to-json !{map { |t|
                   let word =
                     if    !{equal $t[status] `done}    { "done" }
                     elsif !{equal $t[status] `doing}   { "doing" }
                     elsif !{equal $t[status] `blocked} { "blocked" }
                     else                                { "open" }
                   task-set-status $t $word
                 } $ts} > $path
                 $ts },
    `load:   { |path|
                 let ts = map { |t|
                   let status =
                     if    !{equal $t[status] "done"}    { `done }
                     elsif !{equal $t[status] "doing"}   { `doing }
                     elsif !{equal $t[status] "blocked"} { `blocked }
                     else                                 { `open }
                   task-set-status $t $status
                 } !{from-json < $path}
                 for $ts { |t| for $t[tags] { |g| check-tag "load" $g } }
                 tasks-sync $ts },
  ]
}

# --- goal ----------------------------------------------------------------------

## Pin a session goal so the periodic nudge reminder keeps it visible: a
## single plain-text card under the "goal" register key, replaced by a later
## `set` and idempotent to `clear` with nothing pinned.  Both arms answer Unit.

let exarch-goal = { |cmd|
  case $cmd [
    `set:   { |text| exarch-pins `set [key: "goal", body: `card [`text [spans: [[role: "strong", text: "goal"]]],
                                                                  `text [spans: [[role: "", text: $text]]]]] },
    `clear: { |_|    exarch-pins `clear "goal" },
  ]
}
