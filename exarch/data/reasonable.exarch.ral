# `reasonable` bake-in.  Coreutils + a curated everyday-tooling set
# (shells, version control, net fetch, search/inspect, scripting,
# archives), plus directory-based allowance (trailing-`/` keys in
# `exec`) for the standard system / package-manager binary dirs, plus
# everything already on `$PATH` via the `path:` sigil, so
# build drivers (cargo, make, cc, npm, …) work out of the box and
# user-installed tooling is automatically visible.
# In spirit similar to Claude Code's default tool set.  The OS
# sandbox (Seatbelt fs/net rules) still does the real work — a
# permissive exec list paired with a strict fs grant means the
# agent can run cargo but can't write outside cwd / read your SSH
# keys / open arbitrary network endpoints.
#
# Default base when `--base` is omitted.

return [
  audit: false,
  net:   true,

  shell: [chdir: true],

  # Build-toolchain caches, user-installed toolchains, and the
  # project tree itself.  The OS sandbox layer's system paths
  # (CommandLineTools, /opt/homebrew, /etc/alternatives, …) are
  # added separately; this section covers what the OS layer can't
  # bake in.
  #
  # Path-prefix sigils are expanded before grant matching:
  #   * `~` / `~user` — the usual shell tilde rule.
  #   * `xdg:NAME[/sub]` — an XDG basedir, honouring `XDG_*_HOME` env
  #     vars with the Linux defaults universally.
  #   * `cwd:[/sub]` — the working directory at session start.
  #   * `tempdir:[/sub]` — `std::env::temp_dir()`.
  #
  # See `core/src/path/sigil.rs` for the recognised tokens.
  #
  # Tool-specific caches and registries (~/.cargo/registry,
  # ~/.gradle/caches, ~/.m2/repository, …) are scoped to the cache
  # subpath rather than the tool root, since the root usually holds
  # adjacent credential files: ~/.cargo/credentials.toml is the
  # crates.io publish token, ~/.gradle/gradle.properties and
  # ~/.m2/settings.xml hold repository credentials.
  #
  # The XDG basedirs are all readable so tools find their configs,
  # data files, and binaries — but only `xdg:cache` is writable.
  # Two reasons for the asymmetry:
  #
  #   * `xdg:bin/` in `exec` admits any resolved path under it. Write
  #     access there would let a sandboxed process drop a binary the
  #     next call auto-admits — a sandbox escape via filesystem.
  #
  #   * `xdg:config` holds credentials for many tools (gh, op,
  #     gcloud OAuth tokens, …).  Read is accepted as a
  #     data-exfiltration risk; write would let an agent rewrite
  #     those configs.
  fs: [
    read: [
      'cwd:',                   # the project tree the agent is working in
      'gitdir:',               # the actual git directory (handles worktrees)
      '/tmp',
      'tempdir:',               # `$TMPDIR` on macOS — distinct from /tmp
      'xdg:config',             # ${XDG_CONFIG_HOME:-~/.config}
      'xdg:data',               # ${XDG_DATA_HOME:-~/.local/share}
      'xdg:cache',              # ${XDG_CACHE_HOME:-~/.cache}
      'xdg:state',              # ${XDG_STATE_HOME:-~/.local/state}
      'xdg:bin',                # ${XDG_BIN_HOME:-~/.local/bin}
      '~/Library/Caches',       # macOS-native CLI caches outside the XDG world
      '~/.cargo/bin',       # rustup shims (cargo, rustc, clippy, rustfmt, …)
      '~/.cargo/registry',
      '~/.cargo/git',
      '~/.rustup',
      '~/go',
      '~/.npm',
      '~/.gem',
      '~/.bundle',
      '~/.gradle/caches',
      '~/.m2/repository',
      '~/.pyenv',
      '~/.rbenv',
      '~/.nvm',
      '~/.volta',              # Volta (Node.js version manager)
      '~/.ghcup',              # GHCup Haskell toolchain
      '~/.cabal',              # Cabal — bin/, store/, packages/
      '~/.stack',              # Haskell Stack — programs/, snapshots/
      '~/.opam',               # OCaml opam switch installs
      '~/.asdf',               # asdf version manager
      '~/.sdkman',             # SDKMAN (Java, Kotlin, Scala, Maven, …)

      # Git config.  Every git invocation (including `git status`)
      # reads ~/.gitconfig for user.name / user.email / aliases.  The
      # xdg variant covers `git config --global` when XDG_CONFIG_HOME
      # is set.  SSH keys (~/.ssh) and GPG keys (~/.gnupg) stay
      # unreadable, so SSH push and signed commits fail by lack of
      # admit; HTTPS push via osxkeychain remains possible on macOS
      # since securityd is reached over Mach IPC, not the filesystem.
      '~/.gitconfig',
      '~/.gitignore_global',     # path `core.excludesfile` points at by default
      'xdg:config/git',
    ],
    # Writes go to ephemeral / recoverable surfaces only — the working
    # tree, scratch directories, and `xdg:cache`.  The XDG spec defines
    # cache contents as re-derivable, so a hallucinating agent that
    # corrupts `~/.cache/foo` causes at most a re-fetch.  Modern tooling
    # (uv, pnpm, bun, mise, ruff, hatch, …) respects `$XDG_CACHE_HOME`
    # and lands its writes there automatically.
    #
    # The user's real cache dirs (~/.cargo/registry, ~/.npm,
    # ~/.gradle/caches, …) stay *read*-only — they're persistent caches
    # the user pre-warmed; agent writes there would force re-fetches in
    # their later non-agent shells.  Legacy tools that ignore XDG (cargo,
    # npm, gradle, maven, go) get redirected to `$EXARCH_SCRATCH`/<tool>
    # at session entry by exarch's runtime, so `cargo build` and friends
    # work without the agent having to know any redirection protocol.
    #
    # `xdg:config`, `xdg:data`, `xdg:state`, `xdg:bin` stay non-writable:
    # tool configs (gitconfig, npmrc) shouldn't be silently rewritten;
    # persistent state (browser data, history) shouldn't be corrupted;
    # and write-to-`xdg:bin` would let an agent drop a binary the next
    # call auto-admits via the `exec` `xdg:bin/` subpath — sandbox
    # escape via filesystem.
    write: [
      'cwd:',
      '/tmp',
      'tempdir:',
      'xdg:cache',
      'gitdir:',
    ],

    # Per-tool credential subdirs of `xdg:config`.  The broad `xdg:config`
    # read above is intentional (tools mysteriously break without their
    # config), but a few well-known dirs hold OAuth tokens or session
    # secrets the agent should never see, even read-only.  These are
    # overlaid as denies; same shape as `.exarch.ral`'s self-deny.
    deny: [
      'xdg:config/gh',      # gh CLI — hosts.yml has the GitHub OAuth token
      'xdg:config/op',      # 1Password CLI session
      'xdg:config/gcloud',  # Google Cloud SDK OAuth
    ],
  ],

  # Directory-based exec admittance.  A key ending in `/` is a subpath
  # prefix: any binary whose resolved absolute path lies inside the
  # directory is admitted with `'allow'`.  Per-name entries below win on
  # more-specific match; a literal key always wins over a directory prefix.
  # even though `/bin/bash` is under `/bin/`.
  exec: [
    # Admit every binary on PATH.  Expands at freeze time: each `:`
    # separator in `$PATH` becomes a `dirs` entry with this verdict.
    # Per-name entries still beat the directory entries
    # because literal keys win on more-specific match.
    'path:': 'allow',

    'xdg:bin/':            'allow',   # ${XDG_BIN_HOME:-~/.local/bin}
    'system:':             'allow',   # the platform's tool roots — see core/src/path/sigil.rs
    '/usr/local/bin/':     'allow',
    '/usr/local/sbin/':    'allow',
    '/usr/sbin/':          'allow',
    '/sbin/':              'allow',
    'cwd:/':               'allow',   # scripts the agent drops into the project tree
    '/tmp/':               'allow',   # scratch builds (autotools `./configure`, ad-hoc scripts)
    'tempdir:/':           'allow',   # `$TMPDIR` on macOS — distinct from /tmp
    '~/.cargo/bin/':        'allow',   # rustup shims — cargo, rustc, clippy, rustfmt, …
    '~/.rustup/toolchains/': 'allow', # toolchain binaries the shims dispatch to

    # Go — official installer lands in /usr/local/go/bin/;
    # `go install` writes user tools to ~/go/bin/ (GOPATH/bin default).
    '/usr/local/go/bin/':    'allow',
    '~/go/bin/':             'allow',

    # Node.js / JavaScript
    '~/.nvm/versions/':      'allow',  # nvm — resolves through all versions/<v>/bin/
    '~/.volta/bin/':         'allow',  # Volta shims (node, npm, yarn, pnpm, …)

    # Ruby — rbenv dispatches through shims before exec'ing the versioned binary.
    '~/.rbenv/shims/':       'allow',
    '~/.rbenv/versions/':    'allow',

    # Python — pyenv, same two-layer dispatch as rbenv.
    '~/.pyenv/shims/':       'allow',
    '~/.pyenv/versions/':    'allow',

    # Haskell — GHCup is the recommended installer (GHC, Cabal, HLS);
    # Cabal and Stack each maintain their own installed-executables dirs.
    '~/.ghcup/bin/':         'allow',
    '~/.cabal/bin/':         'allow',
    '~/.stack/programs/':    'allow',  # Stack-managed GHC toolchains

    # OCaml — opam switch bins live at ~/.opam/<switch>/bin/ so the whole
    # tree needs a subpath prefix.
    '~/.opam/':              'allow',

    # Universal version managers (cover multiple languages each).
    '~/.asdf/shims/':        'allow',
    '~/.asdf/installs/':     'allow',
    '~/.sdkman/candidates/': 'allow',  # Java, Kotlin, Scala, Groovy, Maven, …

    # Coreutils
    base64:    'allow',
    basename:  'allow',
    cat:       'allow',
    comm:      'allow',
    cp:        'allow',
    cut:       'allow',
    date:      'allow',
    df:        'allow',
    dirname:   'allow',
    du:        'allow',
    echo:      'allow',
    env:       'allow',
    head:      'allow',
    hostname:  'allow',
    id:        'allow',
    join:      'allow',
    kill:      'allow',
    ln:        'allow',
    ls:        'allow',
    mkdir:     'allow',
    mktemp:    'allow',
    mv:        'allow',
    nproc:     'allow',
    paste:     'allow',
    printenv:  'allow',
    printf:    'allow',
    pwd:       'allow',
    readlink:  'allow',
    realpath:  'allow',
    rm:        'allow',
    rmdir:     'allow',
    seq:       'allow',
    sha256sum: 'allow',
    sha512sum: 'allow',
    shuf:      'allow',
    sleep:     'allow',
    sort:      'allow',
    split:     'allow',
    stat:      'allow',
    tac:       'allow',
    tail:      'allow',
    tee:       'allow',
    test:      'allow',
    timeout:   'allow',
    touch:     'allow',
    tr:        'allow',
    truncate:  'allow',
    uname:     'allow',
    uniq:      'allow',
    wc:        'allow',
    whoami:    'allow',
    yes:       'allow',

    # Shells
    sh:   'allow',

    # Version control.  `git` is admitted; the fs grant above adds
    # ~/.gitconfig and xdg:config/git for read so commits and the
    # rest of the local-only subcommands work.  Credential and
    # signing helpers fail by separate lack of admit: ~/.ssh and
    # ~/.gnupg are not in fs reads, so SSH push and `commit -S` die
    # naturally.  HTTPS push via osxkeychain on macOS still works
    # because securityd is reached over Mach IPC.
    git: 'allow',
    gh:  'allow',

    # Net fetch
    curl: 'allow',
    wget: 'allow',

    # Search / inspect
    rg:    'allow',
    fd:    'allow',
    jq:    'allow',
    yq:    'allow',
    awk:   'allow',
    gawk:  'allow',
    find:  'allow',
    xargs: 'allow',
    file:  'allow',
    which: 'allow',

    # Scripting runtimes (one-off scripts, common as tooling)
    python:  'allow',
    python3: 'allow',

    # Archives
    tar:     'allow',
    gzip:    'allow',
    gunzip:  'allow',
    bzip2:   'allow',
    bunzip2: 'allow',
    xz:      'allow',
    zip:     'allow',
    unzip:   'allow',

    # Diff / patch / docs
    diff:  'allow',
    patch: 'allow',
    less:  'allow',
    man:   'allow',

    # Process inspection (read-only)
    ps:    'allow',
    lsof:  'allow',
    pgrep: 'allow',
  ],
]
