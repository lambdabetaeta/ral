# `reasonable` bake-in.  Coreutils + a curated everyday-tooling set
# (shells, version control, net fetch, search/inspect, scripting,
# archives), plus directory-based allowance (`dir` targets in
# `exec`) for the system and package-manager tool roots (the selectors
# of `core/src/guard/toolchains.rs`), plus
# everything already on `$PATH` via the `path` selector, so
# build drivers (cargo, make, cc, npm, …) work out of the box and
# user-installed tooling is automatically visible.
# In spirit similar to Claude Code's default tool set.  The OS
# sandbox (Seatbelt fs/net rules) still does the real work — a
# permissive exec list paired with a strict fs grant means the
# agent can run cargo but can't write outside cwd / read your SSH
# keys / open arbitrary network endpoints.
#
# Default base when `--base` is omitted.

# rustup's lock file and the `self-update` directory beside it, under a
# usable (non-empty, absolute) `RUSTUP_HOME`, else `~/.rustup`.  `env` is
# the host's here: exarch does not redirect `RUSTUP_HOME`.
let host-env = !{env}
let rustup-home = if !{has $host-env RUSTUP_HOME} { return $host-env[RUSTUP_HOME] } else { return '' }
let rustup-at = { |sub|
  if !{re-match #'^(/|[A-Za-z]:[/\\])'# $rustup-home} {
    return `absolute "$rustup-home/$sub"
  } else {
    return `home ".rustup/$sub"
  }
}
let self-update = !{rustup-at self-update}
let self-update-lock = !{rustup-at self-update/self-update.lock}

return [
  # Build-toolchain caches, user-installed toolchains, and the
  # project tree itself.  The OS sandbox layer's readable system
  # paths (CommandLineTools, Homebrew, /etc/alternatives, …)
  # are added separately, and the tool roots that may run come from the
  # `dir` selectors below (the table in `core/src/guard/toolchains.rs`),
  # which running reads make readable too; this section covers what
  # neither can bake in.
  #
  # Places are frozen when the grant is decoded:
  #   * `home SUB` — SUB under the home directory.
  #   * `xdg-NAME SUB` — SUB under an XDG basedir, honouring `XDG_*_HOME`
  #     env vars with the Linux defaults universally.
  #   * `cwd SUB` — SUB under the working directory at session start.
  #   * `tempdir SUB` — SUB under `std::env::temp_dir()`.
  #   * `gitdir SUB` — SUB under the git directory of the repository the cwd is in.
  #     Where `.git` is a *file* naming that directory, the directory must
  #     name this working tree back (a linked worktree's `gitdir` file, or
  #     `core.worktree` in a `--separate-git-dir` config) — the file itself
  #     sits in the tree this grant makes writable, so on its own it would
  #     choose the grant.  A pointer nothing claims refuses the session.
  #
  # `absolute P` names an absolute path; `.` as SUB is the anchor itself.
  #
  # Tool-specific caches and registries (~/.cargo/registry,
  # ~/.gradle/caches, ~/.m2/repository, …) are scoped to the cache
  # subpath rather than the tool root, since the root usually holds
  # adjacent credential files: ~/.cargo/credentials.toml is the
  # crates.io publish token, ~/.gradle/gradle.properties and
  # ~/.m2/settings.xml hold repository credentials.
  #
  # The XDG basedirs are all readable so tools find their configs,
  # data files, and binaries — but none is writable.  Among the reasons:
  #
  #   * `xdg-bin` is on the human's `$PATH`. A program dropped there
  #     outlives the session and is run tomorrow by the user, with the
  #     user's authority — not this projection's.
  #
  #   * `xdg-config` holds credentials for many tools (gh, op,
  #     gcloud OAuth tokens, …).  Read is accepted as a
  #     data-exfiltration risk; write would let an agent rewrite
  #     those configs.
  fs: [
    read: [
      `cwd .,                # the project tree the agent is working in
      `gitdir .,             # the actual git directory (handles worktrees)
      `absolute /tmp,
      `tempdir .,            # `$TMPDIR` on macOS — distinct from /tmp
      `xdg-config .,         # ${XDG_CONFIG_HOME:-~/.config}
      `xdg-data .,           # ${XDG_DATA_HOME:-~/.local/share}
      `xdg-cache .,          # ${XDG_CACHE_HOME:-~/.cache}
      `xdg-state .,          # ${XDG_STATE_HOME:-~/.local/state}
      `xdg-bin .,            # ${XDG_BIN_HOME:-~/.local/bin}
      `home Library/Caches,  # macOS-native CLI caches outside the XDG world
      `home .cargo/registry,
      `home .cargo/git,
      `home go,
      `home .npm,
      `home .gem,
      `home .bundle,
      `home .gradle/caches,
      `home .m2/repository,
      `home .cabal,          # Cabal — store/, packages/ (its `bin` runs via `cabal`)
      `home .stack,          # Haskell Stack — snapshots/ (its `programs` run via `stack`)

      # Git config.  Every git invocation (including `git status`)
      # reads ~/.gitconfig for user.name / user.email / aliases.  The
      # xdg variant covers `git config --global` when XDG_CONFIG_HOME
      # is set.  SSH keys (~/.ssh) and GPG keys (~/.gnupg) stay
      # unreadable, so SSH push and signed commits fail by lack of
      # admit.  HTTPS push fails too, by a door rather than a path:
      # osxkeychain asks securityd, which the base profile withholds
      # because the same door hands out keychain items.
      `home .gitconfig,
      `home .gitignore_global,  # path `core.excludesfile` points at by default
      `xdg-config git,
    ],
    # A session writes no cache that the user's own tools read.  Most
    # caches are trusted on use, so a write there by a prompt-injected
    # agent outlives the session and runs unconfined in the user's next
    # build.  Every cache a session writes lives in its scratch,
    # `$EXARCH_SCRATCH`, which is deleted when the session ends: exarch's
    # runtime points `$XDG_CACHE_HOME` and the legacy tool homes (cargo,
    # npm, gradle, maven, go, …) there at session entry, so `cargo build`
    # and friends work without the agent having to know any redirection
    # protocol.  The user's real caches (~/.cache, ~/.cargo/registry,
    # ~/.npm, ~/.gradle/caches, …) stay *read*-only.
    #
    # `xdg-config`, `xdg-data`, `xdg-cache`, `xdg-state`, `xdg-bin` stay
    # non-writable for one reason in three dresses: each is read later by
    # something this projection does not confine.  A program under
    # `xdg-bin` is run tomorrow by the user off their own `$PATH`; a
    # rewritten gitconfig or npmrc is obeyed by the user's own git and npm
    # (`core.pager` is a command); persistent state and caches are trusted
    # by whatever wrote them.
    #
    # The writable set below is not free of that hazard — `cwd` and
    # `gitdir` hold hooks, `.envrc`, `package.json` scripts, Makefiles,
    # all of which the user's unconfined tooling executes on sight.  No
    # capability names that class today; see the wiki's `design/grant`.
    write: [
      `cwd .,
      `absolute /tmp,
      `tempdir .,
      `gitdir .,
      $self-update-lock,  # rustup locks it on every proxy run; `self-update` is not run (exec below)
    ],

    # Per-tool credential subdirs of `xdg-config`.  The broad `xdg-config`
    # read above is intentional (tools mysteriously break without their
    # config), but a few well-known dirs hold OAuth tokens or session
    # secrets the agent should never see, even read-only.  `~/.dotnet`
    # runs, and so is read, whenever `$PATH` holds it; its `corefx`
    # subtree is .NET's certificate store.  These are overlaid as denies;
    # same shape as `.exarch.ral`'s self-deny.  exarch's and synod's own
    # credential files are denied in composition
    # (`policy::for_invocation`), not here.
    deny: [
      `xdg-config gh,      # gh CLI — hosts.yml has the GitHub OAuth token
      `xdg-config op,      # 1Password CLI session
      `xdg-config gcloud,  # Google Cloud SDK OAuth
      `home .dotnet/corefx,  # PKCS#12 files with private keys
    ],
  ],

  # Directory-based exec admittance.  A `dir` target is a subpath
  # prefix: any binary whose resolved absolute path lies inside the
  # directory is admitted.  Allowances only add; specificity decides
  # nothing.  An exclusion beats every allowance, however specific.
  exec: [
    allow: [
      # Admit every binary on PATH.  Expands at freeze time: each `:`
      # separator in `$PATH` becomes a `dir` entry.
      `dir `path,

      `dir `xdg-bin .,  # ${XDG_BIN_HOME:-~/.local/bin}
      `dir `system,     # the platform's tool roots (table: core/src/guard/toolchains.rs)
      `dir `homebrew,   # the Homebrew prefixes present (same table)
      `dir `absolute /usr/local/bin,
      `dir `absolute /usr/local/sbin,
      `dir `absolute /usr/sbin,
      `dir `absolute /sbin,
      # These three are writable as well as admitted — a general agent
      # builds and runs what it built.  The fs and net grants are what
      # confine this profile; use `edit-only` or `read-only`, where no
      # admitted directory is writable, when the boundary has to hold
      # against the agent rather than steer it (wiki: design/grant
      # §Concessions).
      `dir `cwd .,                    # scripts the agent drops into the project tree
      `dir `absolute /tmp,            # scratch builds (autotools `./configure`, ad-hoc scripts)
      `dir `tempdir .,                # `$TMPDIR` on macOS — distinct from /tmp

      # Every other selector of the table in core/src/guard/toolchains.rs,
      # by ecosystem: what a manager installs and its shims dispatch into.
      `dir `macports, `dir `nix, `dir `pkgsrc,
      `dir `rustup, `dir `cargo,  # cargo's shims dispatch into rustup's root
      `dir `go,
      `dir `nvm, `dir `fnm, `dir `volta, `dir `pnpm, `dir `npm, `dir `bun, `dir `deno,
      `dir `pyenv, `dir `uv, `dir `pipx, `dir `poetry, `dir `pdm, `dir `pipenv,
      `dir `hatch, `dir `virtualenvwrapper, `dir `conda,
      `dir `rbenv,
      `dir `ghcup, `dir `cabal, `dir `stack,
      `dir `opam, `dir `elan, `dir `juliaup,
      `dir `sdkman, `dir `jdk, `dir `coursier,
      `dir `asdf, `dir `mise, `dir `dotnet, `dir `texlive,
      `dir `scoop, `dir `chocolatey, `dir `winget,

      # The per-name entries below are not a second opinion on what the
      # directories above already admit.  The coreutils linked into the ral
      # binary (`core/src/uutils.rs`) are spawned by bare name and never
      # resolved on disk, so no prefix above can reach one: a bundled tool
      # left unnamed here is unrunnable.  `cmp`, `diff` and `rg` bundle only
      # under non-default features, and are named too so this profile holds
      # whichever way the binary was built.  The rest are host binaries,
      # named so the everyday set does not depend on what `$PATH` happened
      # to hold when the profile froze.
      #
      # Coreutils
      `name base64,
      `name basename,
      `name cat,
      `name comm,
      `name cp,
      `name cut,
      `name date,
      `name df,
      `name dirname,
      `name du,
      `name echo,
      `name env,
      `name head,
      `name hostname,
      `name id,
      `name join,
      `name kill,
      `name ln,
      `name ls,
      `name mkdir,
      `name mktemp,
      `name mv,
      `name nproc,
      `name paste,
      `name printenv,
      `name printf,
      `name pwd,
      `name readlink,
      `name realpath,
      `name rm,
      `name rmdir,
      `name seq,
      `name sha256sum,
      `name sha512sum,
      `name shuf,
      `name sleep,
      `name sort,
      `name split,
      `name stat,
      `name tac,
      `name tail,
      `name tee,
      `name test,
      `name timeout,
      `name touch,
      `name tr,
      `name truncate,
      `name uname,
      `name uniq,
      `name wc,
      `name whoami,
      `name yes,

      # Shells
      `name sh,

      # Version control.  What git can and cannot do here follows from the
      # fs reads above (~/.gitconfig yes, ~/.ssh and ~/.gnupg no); cargo
      # fetches git dependencies through this binary — see PROFILES.md.
      `name git,
      `name gh,

      # Net fetch
      `name curl,
      `name wget,

      # Search / inspect
      `name rg,
      `name fd,
      `name jq,
      `name yq,
      `name awk,
      `name gawk,
      `name find,
      `name xargs,
      `name file,
      `name which,

      # Scripting runtimes (one-off scripts, common as tooling)
      `name python,
      `name python3,

      # Archives
      `name tar,
      `name gzip,
      `name gunzip,
      `name bzip2,
      `name bunzip2,
      `name xz,
      `name zip,
      `name unzip,

      # Diff / patch / docs
      `name cmp,
      `name diff,
      `name patch,
      `name less,
      `name man,

      # Process inspection (read-only)
      `name ps,
      `name lsof,
      `name pgrep,
    ],

    # rustup stages the updater it later runs unconfined in `self-update`,
    # whose lock is writable above: it must never run, whatever `rustup`
    # admits.  An exclusion beats every allowance.
    deny: [
      `dir $self-update,
    ],
  ],
]
