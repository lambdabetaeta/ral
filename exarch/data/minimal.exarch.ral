# `minimal` bake-in.  The smallest base that's actually useful as a
# starting point for additive `--extend` composition: the
# platform's tool roots (`dir `system`, a row of the table in
# `core/src/guard/toolchains.rs`) + cwd + scratch, network on, chdir
# allowed.  Nothing from the
# user's home except scratch: `xdg-bin` is not admitted (so a fresh
# tool dropped in `~/.local/bin` is a deliberate choice via
# `--extend`, not an implicit one); a Homebrew tree is not admitted
# and is left unlisted, so brew tools are added by `--extend` (for
# example a file that allows `` `dir `homebrew ``); toolchain caches
# and `~/Library` are not readable.
#
# The contrast with `reasonable`: this is "system tools only,
# nothing pulled from my home or homebrew, network on so I can
# fetch what I tell it to fetch."  The contrast with `confined`:
# minimal has network on; confined doesn't.  The contrast with
# `dangerous + --restrict`: minimal is a curated starting point;
# dangerous-with-restrict is a bespoke profile written from scratch.
#
# `cwd` and `tempdir` places are resolved by the freeze pass at
# session start, so the per-invocation working directory bakes in
# without exarch having to inject anything dynamically.
#
# Edit this file to change what `--base minimal` admits.  The
# contents are baked into the exarch binary at build time via
# `include_str!`.

return [
  # Reads and writes mirror the threat model of `reasonable`.  A session
  # writes no cache that the user's own tools read: writes go only to the
  # working tree and scratch, and exarch's runtime points
  # `$XDG_CACHE_HOME` and the legacy tool homes (cargo, npm, gradle, …)
  # at `$EXARCH_SCRATCH`, which is deleted when the session ends.
  fs: [
    read: [
      `cwd .,
      `absolute /tmp,
      `tempdir .,
    ],
    write: [
      `cwd .,
      `absolute /tmp,
      `tempdir .,
    ],
  ],

  # Subpath admittance for the platform's tool roots, plus cwd and
  # scratch.  No per-name enumeration of coreutils: every coreutil
  # lives under a tool root and gets admitted by the subpath rule.
  # This admits more than coreutils — `make`, `find`, `xargs`, `git`,
  # `curl`, `tar`, `awk`, `sed`, `pkg-config`, `clang`, … — which
  # matches what users actually want from "tight but functional."
  #
  # `system` is the platform's own tool roots (see
  # `core/src/guard/toolchains.rs`) and carries no Homebrew tree.
  # Apple's toolchain (CommandLineTools, Xcode) is folded in by
  # `system`, so building from source works without listing each tool
  # here.
  #
  # `bash` and `zsh` live under a tool root (admitted by `system`
  # above), but a `name` exclusion beats the subpath allowance.
  # Autoconf-style `configure` scripts and `make` recipes shell out
  # via `/bin/sh -c` and need `sh` itself; bash/zsh are agent
  # quality-of-life only.  `cmd`/`powershell`/`pwsh` are the Windows
  # analogues of the same call — `system` admits them unconditionally
  # via `%SystemRoot%\System32`, so they get the same deny bash/zsh do.
  exec: [
    allow: [
      `dir `system,
      `dir `cwd .,
      `dir `absolute /tmp,
      `dir `tempdir .,
    ],
    deny: [
      `name bash,
      `name zsh,
      `name cmd,
      `name powershell,
      `name pwsh,
    ],
  ],
]
