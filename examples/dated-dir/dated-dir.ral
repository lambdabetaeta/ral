#!/usr/bin/env ral
# Footgun: the bash script runs `$(date +%F)` twice — once to make the
# directory, once to print it.  A run that straddles midnight makes the
# two calls disagree, so it reports a path it never created.  Here the
# date is captured once and reused.

let [base] = $ARGS

let day  = date +%F | from-line
let path = "$base/$day"

mkdir -p $path
echo $path
