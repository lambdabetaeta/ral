#!/usr/bin/env ral
# Footgun: the jq spell hand-rolls the header/row correspondence —
# `(.[0] | keys_unsorted)` then `.[$k[]]` — a fragile program string
# that is easy to get subtly wrong when edited.  to-csv is one typed
# call over the decoded records: it derives the header and
# RFC-4180-quotes every field itself.

let [path] = $ARGS
let rows = from-json < $path
to-csv $rows
