#!/usr/bin/env ral
# Footgun: the common `eval "echo \"$(cat tpl)\""` expands every shell construct
# in the file, so a template containing `$(rm -rf ~)` runs on fill.  Here the
# template is inert data: we find `${NAME}` placeholders and substitute only
# known environment keys, executing nothing.

let [path] = $ARGS
let tpl   = from-string < $path
let phs   = re-find-matches '\$\{[A-Z_][A-Z0-9_]*\}' $tpl
let names = nub !{map { |ph| return !{slice $ph 2 $[!{length $ph} - 3]} } $phs}

let filled = fold { |acc name|
    let val = try { return $ENV[$name] } { |_| return '' }
    let pat = intercalate '' ['\$\{', $name, '\}']
    return !{re-replace-all $pat $val $acc}
} $tpl $names

echo $filled
