#!/usr/bin/env ral
# Footgun: the find | awk -F'\t' | sort idiom keys its size buckets by a
# string field that a tab in a filename splits apart.  Here the bucket map
# is keyed by the actual extension value and aggregated with a fold —
# nothing is stringly typed.

let [root] = $ARGS

let files = filter { |p| is-file $p } !{glob "$root/**/*"}

let totals = fold { |acc p|
    let key   = case !{extension $p} [
        `just: { |e| return ".$e" },
        `none: { |_| return '(none)' }
    ]
    let bytes = !{file-info $p}[size]
    let prev  = !{get $acc $key 0}
    return [...$acc, $key: $[$prev + $bytes]]
} [:] $files

let rows = map { |k| return [ext: $k, size: $totals[$k]] } !{keys $totals}
let sorted = reverse !{sort-list-by { |r| return $r[size] } $rows}

for $sorted { |r|
    echo "$r[size]\t$r[ext]"
}
