#!/usr/bin/env ral

# Kill the named memory hogs and report, as one value, what each was
# holding and what the kill bought back.
#
#     ral reap.ral Zulip "Microsoft Edge" Discord
#
# The bash session this replaces interleaves action and re-measurement
# by hand:
#
#     pkill -i zulip; sleep 1; pgrep -il zulip
#     pkill -i "Microsoft Edge"; pkill -i discord
#     sysctl vm.swapusage; uptime          # ...did that help?
#
# Each `pkill` either matches or exits nonzero, so the kills cannot
# simply be sequenced — a miss would abort the rest.  Here the census
# is taken once, every app is weighed against it before anything dies,
# `attempt` swallows the empty-match failure, and the free-memory
# percentage is sampled either side of the kill so the answer to "did
# that help?" is in the returned record, not in your head.

if !{is-empty $args} {
    echo 'usage: reap.ral APP...' 1>&2
    exit 2
}

let grab = { |pat s| re-replace "(?s).*$pat.*" '$1' $s }
let free = { int !{grab 'free percentage: ([0-9]+)' !{memory_pressure 2>/dev/null}} }

let census = map { |l|
    let w = words $l
    [rss: !{int $w[0]}, comm: !{intercalate ' ' !{drop 1 $w}}]
} !{drop 1 !{lines !{ps -Aco rss,comm}}}

let weigh = { |pat|
    let hits = filter { |p| re-match "(?i)$pat" $p[comm] } $census
    let kb   = sum !{map { |p| $p[rss] } $hits}
    [app: $pat, procs: !{length $hits}, rss-mb: $[$kb / 1024]]
}

let before = !$free
let reaped = map $weigh $args
for $args { |p| attempt { pkill -i $p } }
let after  = !$free

[
    reaped:   $reaped,
    total-mb: !{sum !{map { |r| $r[rss-mb] } $reaped}},
    free-pct: [before: $before, after: $after],
]
