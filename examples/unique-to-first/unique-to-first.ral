#!/usr/bin/env ral
# Footgun: `comm -23` needs both inputs pre-sorted or it silently drops
# real differences, and the `sort` it demands reorders the output and
# imposes locale collation.  Here it is a difference: lines of A that B
# does not contain, in A's own order, no sorting required.

let [a, b] = $ARGS
let bs = from-lines-list $b
for !{from-lines-list $a} { |l| if $[not !{contains $bs $l}] { echo $l } }
