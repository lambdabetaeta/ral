#!/usr/bin/env ral
# Footgun: a retry loop checks its deadline only after the probe returns.
# Requires macOS/OpenBSD or traditional Linux netcat (`nc -z -w 1`). The
# probe timeout is best-effort; the outer race cancels and drains even a
# blocked probe, bounding the whole wait plus cancellation grace. Other nc
# dialects are not covered; an unsupported option is not a firewall timeout.

let [target, port, secs] = args

let probe = { |interval|
    if !{succeeds { nc -z -w 1 -- $target $port 2> /dev/null }} { return `up }
    else { sleep $interval ; probe $interval }
}

let waiter = spawn { probe 1 }
let alarm = spawn { sleep !{int $secs} ; return `late }

case !{race [$waiter, $alarm]} [
    `up:   { |_| echo "$target:$port is up" },
    `late: { |_|
        warn "$target:$port never came up within !{str $secs}s"
        exit 1
    },
]
