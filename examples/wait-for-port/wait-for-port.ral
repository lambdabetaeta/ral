#!/usr/bin/env ral
# Footgun: `until nc -z -w 1 …; do <deadline check>; sleep 1; done` gives up on
# time only if the probe returns, and `-w` need not bound connect (macOS wants
# `-G`), so a host that drops the SYN overruns the budget.  Here the alarm races
# the probes and cancels a blocked one; `-w` only paces them.  Needs an nc that
# takes `-z -w` (macOS, OpenBSD or traditional Linux netcat).

let [target, port, secs] = args

let probe = { |interval|
    if !{succeeds { nc -z -w 1 -- $target $port 2> /dev/null }} { return `up }
    else { sleep $interval ; probe $interval }
}

let waiter = spawn { probe 1 }
let alarm = spawn { sleep !{int $secs} ; return `late }

case !{race [$waiter, $alarm]} [
    `up:   { |_| echo "$target:$port is up" },
    `late: { |_|
        warn "$target:$port never came up within $(secs)s"
        exit 1
    },
]
