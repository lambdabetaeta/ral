#!/usr/bin/env ral
# Footgun: `echo "$title"` silently eats a title beginning `-n` or `-e`
# as an echo flag, and `tr [:upper:] [:lower:]` folds case by the current
# locale.  Here `lower` and `re-replace-all` act on the String value
# itself — no subprocess, no argv/flag confusion, no locale surprise.

let [title] = $ARGS
let dashed = re-replace-all '[^a-z0-9]+' '-' !{lower $title}
echo !{re-replace-all '^-+|-+$' '' $dashed}
