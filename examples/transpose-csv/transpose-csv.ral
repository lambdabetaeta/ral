#!/usr/bin/env ral
# Footgun: the awk transpose `{for(i=1;i<=NF;i++)a[i,NR]=$i}END{...}` is a
# write-only two-array incantation whose meaning you must reverse-engineer
# every time.  Here a CSV is a list of rows, and transposing is reading
# column j across every row — a nested map that reads as what it does.

let [path] = $args
let rows = map { |l| re-split ',' $l } !{from-lines-list $path}

for !{range 0 !{length $rows[0]}} { |j|
    echo !{intercalate ',' !{map { |row| return $row[$j] } $rows}}
}
