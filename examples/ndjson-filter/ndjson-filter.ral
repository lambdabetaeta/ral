#!/usr/bin/env ral
# Footgun: `grep "\"$field\":\"$want\""` tests a substring of raw text, so
# it matches the value under a different field, a partial token ("admin"
# inside "administrator"), or misses it when the writer added spaces —
# and the per-line loop forks grep for every record.  Here each line is
# decoded once and the real field value is compared as data.

let [path, field, want] = $ARGS

let kept = filter { |r|
    return $[!{has $r $field} && !{equal !{str $r[$field]} $want}]
} !{stream-to-list !{from-jsonl < $path}}

to-jsonl $kept
