#!/usr/bin/env ral
# Footgun: `sed -i 's/\r$//'` truncates then rewrites — a crash mid-write
# loses the file; `-i` even differs GNU vs BSD (`-i` vs `-i ''`); and `\r$`
# misses lone/embedded CRs and a final line with no newline.  Here `\r`
# strips every carriage return, and `>` is rename-on-close: a reader sees
# the old file or the new, never a torn write.

let [path] = $args

let body = from-string < $path

to-string !{re-replace-all '\r' '' $body} > $path
