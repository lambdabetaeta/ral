#!/usr/bin/env ral
# Footgun: `find | xargs -P8 sha256sum` needs the `-print0`/`-0` NUL dance
# only because filenames are shell tokens xargs re-splits on whitespace —
# drop it and a spaced path hashes as two bogus files.  Here a path is a
# value, `par` distributes values, and hashes come back in input order.

let [root, ...rest] = $ARGS
let jobs = if !{is-empty $rest} { return 8 } else { return !{int $rest[0]} }

let files = filter { |p| is-file $p } !{glob "$root/**/*"}

let results = par { |p|
    let line  = !{sha256sum $p | from-string}
    let parts = words $line
    return [hash: $parts[0], path: $p]
} $files $jobs

for !{sort-list-by { |r| return $r[path] } $results} { |r|
    echo "$r[hash]  $r[path]"
}
