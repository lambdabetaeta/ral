#!/usr/bin/env ral
# Footgun: bash round-trips base64 through `>` and unquoted paths — a filename
# with spaces splits into two arguments, and a failed decode leaves a half-written
# output whose nonzero status hides in a `pipefail` gap.  Here `>` is atomic,
# `$path` never splits, and `guard` cleans up on every exit.

let [path] = $args
let enc = temp-file
let dec = temp-file
guard {
    base64 $path > $enc
    base64 -d $enc > $dec
    if !{succeeds { cmp -s $path $dec }} { echo "round-trip ok: !{line-count $enc} lines of base64" }
    else { fail [status: 1, message: 'round-trip mismatch'] }
} { rm -f $enc $dec }
