#!/usr/bin/env ral
# Footgun: `grep -v '^#'` keeps INDENTED comments (`   # note`) and blank
# lines; the tempting `sed 's/#.*//'` instead mangles a `#` inside a value
# (`color=#fff`, `url=host/path#frag`) — silent data corruption.  Here a
# line survives only if its first non-blank char is not `#`, so indented
# comments and blanks go while a `#` inside a value is never touched.

let [path] = $args

let kept = filter { |l| re-match '^\s*[^#\s]' $l } !{from-lines-list $path}

for $kept { |l| echo $l }
