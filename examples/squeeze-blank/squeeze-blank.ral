#!/usr/bin/env ral
# Footgun: `cat -s` squeezes only truly empty lines — a line of spaces or
# a tab counts as content, so runs padded with whitespace survive intact.
# Here "blank" is the regex `^\s*$`, so whitespace-only lines collapse too;
# the accumulator is just whether the previous emitted line was blank.

fold-lines { |prev line|
    let blank = re-match '^\s*$' $line
    if $[$blank && $prev] { return true } else {
        echo $line
        return $blank
    }
} false
