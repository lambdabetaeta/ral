#!/usr/bin/env ral
# Footgun: the bash loop recomputes with `sha256sum "$file"` under
# `set -e`, so the first missing or unreadable entry aborts the whole
# run — a crash, not a FAILED line.  Here the hash is split off the front
# (the rest is the filename, spaces and all) and computed in a `try`, so
# one bad entry is one FAILED row and the report continues.

let [manifest] = $ARGS
let base = dirname $manifest

for !{from-lines-list $manifest} { |line|
    let want = re-find-match '^[0-9a-f]+' $line
    let file = re-replace '^[0-9a-f]+[ *]+' '' $line
    let ok = try {
        return !{equal $want !{words !{sha256sum "$base/$file" | from-string}}[0]}
    } { |_| return false }
    echo "!{if $ok { return 'OK' } else { return 'FAILED' }}  $file"
}
