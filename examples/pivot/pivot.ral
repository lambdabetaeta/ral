#!/usr/bin/env ral
# Footgun: `awk -F, '{s[$1]+=$2} END{for(k in s)print k,s[k]}'` addresses
# both columns by position and emits groups in awk's unspecified hash
# order.  Here `group-by` keys on the named category and the keys come
# out sorted.

let [path, category, val] = $args

let [hdr, ...rows] = !{from-lines-list $path}
let header = re-split ',' $hdr
let records = map { |line|
    fold { |m p| let k = $p[0]; return [...$m, $k: $p[1]] } [:] !{zip $header !{re-split ',' $line}}
} $rows

let buckets = group-by { |r| return $r[$category] } $records

echo "$category\tsum($val)"
for !{keys $buckets} { |k|
    echo "$k\t!{fold { |acc r| return $[$acc + !{float $r[$val]}] } 0.0 $buckets[$k]}"
}
