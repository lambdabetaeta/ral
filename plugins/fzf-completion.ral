# fzf-completion — the trigger (default `**`) then tab completes the word with
# fzf, as fzf's completion.zsh does: directories after
# $FZF_COMPLETION_DIR_COMMANDS (default `cd rmdir`), hosts after ssh and
# telnet, PIDs after kill, paths elsewhere.  Reads $FZF_COMPLETION_TRIGGER (at
# load), $FZF_COMPLETION_OPTS, $FZF_COMPLETION_PATH_OPTS and
# $FZF_COMPLETION_DIR_OPTS.  Options: trigger.

let [pick: pick, var: var] = use 'lib/fzf.ral'

## The word becomes the picks, each rendered, joined, and closed with `tail`.
let _complete = { |ours src args render tail lbuf|
    pick $ours !{var FZF_COMPLETION_OPTS ''} $src $args { |ps| _ed-set-lbuffer "$lbuf!{intercalate ' ' !{map $render $ps}}$tail" }
}

## `dir` split at its longest existing directory, as [root, query].
let _split = { |dir q|
    if !{re-match '^[^/]*$' $dir} { ['', "$dir$q"] }
    elsif !{is-dir $dir} { [$dir, $q] }
    else { _split !{re-replace-all '[^/]+/*$' '' $dir} "!{re-find-match '[^/]+/*$' $dir}$q" }
}

## Walk below the word's longest existing directory; the rest is the query.
let _walk = { |flags walker opts render tail [prefix: p, lbuf: l]|
    let [root, q] = _split !{if !{re-match '^~(/|$)' $p} { "!{home}!{slice $p 1 $[!{length $p} - 1]}" } else { $p }} ''
    _complete '--reverse --scheme=path' `walk '' [...$flags, -q, $q, --walker, $walker, "--walker-root=!{if !{is-empty $root} { '.' } else { re-replace-all '(.)/+$' '$1' $root }}", ...!{posix-split !{var $opts ''}}] $render $tail $l
}
let _files = _walk [-m] file,dir,follow,hidden FZF_COMPLETION_PATH_OPTS $ral-quote ' '
let _dirs = _walk [] dir,follow FZF_COMPLETION_DIR_OPTS { |d| ral-quote "!{re-replace-all '/+$' '' $d}/" } ''

## Pick from `items`; the word is the query.
let _list = { |args items render [prefix: p, lbuf: l]| _complete --reverse `items $items [...$args, -q, $p] $render ' ' $l }

## ssh's configs, known_hosts and /etc/hosts, sorted and unique: __fzf_list_hosts.
let _hosts = {
    let read = { |f| from-lines < $f ? [] }
    let host = '(?i)^\s*host(name)?\s*[\s=]'
    keys !{fold { |m h| [...$m, $h: ()] } [:] [
        ...!{flat-map { |l| filter { |w| $[not !{re-match '[*?%]' $w}] } !{words !{re-replace-all '#.*' '' !{re-replace-all $host '' $l}}} } !{filter { |l| re-match $host $l } !{flat-map $read [~/.ssh/config, ...!{glob ~/.ssh/config.d/* ? []}, /etc/ssh/ssh_config]}}},
        ...!{flat-map { |m| re-split ',' !{re-replace-all '[\[\]]|:[^,]*' '' $m} } !{flat-map { |l| re-find-matches '^[\[\]a-zA-Z0-9.,:-]+' $l } !{read ~/.ssh/known_hosts}}},
        ...!{flat-map { |l| filter { |h| $[$h != '0.0.0.0'] } !{drop 1 !{words !{re-replace-all '#.*' '' $l}}} } !{read /etc/hosts}},
    ]}
}

## Completers by command word: upstream's _fzf_complete_<command>.
let _by_cmd = [:,
    ssh: { |c|
        if !{elem $c[prev] [-i, -F, -E]} { _files $c } else {
            let u = re-find-match '^[^@]*@' $c[prefix] ? ''
            _list [+m] !{map { |h| "$u$h" } !{_hosts}} $id $c
        }
    },
    telnet: { |c| _list [+m] !{_hosts} $id $c },
    kill: { |c| _list [-m, --header-lines=1, --no-preview, --wrap] !{lines !{ps -eo user,pid,ppid,start,time,command 2> /dev/null ? ps -eo user,pid,ppid,time,args 2> /dev/null ? ps --everyone --full --windows}} { |l| !{words $l}[1] } $c },
]

{ |options|
    let trigger = get $options trigger !{get !{env} FZF_COMPLETION_TRIGGER '**'}
    [
        name: fzf-completion,
        keybindings: [[
            key: tab,
            guard: !{intercalate '' ['\S\s+\S*', !{re-replace-all '[.^$*+?()\[\]{}|\\]' '\$0' $trigger}, '$']},
            handler: { |_|
                let [words: ws, current: i, offset: o] = _ed-parse
                let lb = _ed-lbuffer
                let n = $[!{length $lb} - $o - !{length $trigger}]
                if $[not !{is-empty $ws} && $n >= 0] {
                    let [cmd, ..._] = $ws
                    let t = union !{fold { |m d| [...$m, $d: $_dirs] } [:] !{words !{get !{env} FZF_COMPLETION_DIR_COMMANDS 'cd rmdir'}}} $_by_cmd
                    let complete = if !{has $t $cmd} { $t[$cmd] } else { $_files }
                    complete [prefix: !{slice $lb $o $n}, prev: !{last ['', ...!{take $i $ws}]}, lbuf: !{slice $lb 0 $o}]
                }
            },
        ]],
    ]
}
