{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synod",
  "version": "0.1.0",
  "identifier": "app.synod.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Synod",
        "width": 940,
        "height": 760,
        "minWidth": 560,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../vm-image/out/boot/kernel": "boot/kernel",
      "../vm-image/out/boot/initramfs.img": "boot/initramfs.img",
      "../vm-image/out/rootfs.img.zst": "boot/rootfs.img.zst",
      "../vm-image/out/rootfs.img.sha256": "boot/rootfs.img.sha256"
    },
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
