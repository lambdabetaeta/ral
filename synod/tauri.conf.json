{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synod",
  "version": "0.1.0",
  "identifier": "app.synod.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Synod",
        "width": 940,
        "height": 760,
        "minWidth": 560,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
