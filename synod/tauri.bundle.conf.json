{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "cargo run --quiet -p ral-vm-image-build-tools --bin check-media"
  },
  "bundle": {
    "resources": {
      "../vm-image/out/boot/kernel": "boot/kernel",
      "../vm-image/out/boot/initramfs.img": "boot/initramfs.img",
      "../vm-image/out/rootfs/rootfs.img.zst": "boot/rootfs.img.zst",
      "../vm-image/out/rootfs/rootfs.img.sha256": "boot/rootfs.img.sha256"
    }
  }
}
