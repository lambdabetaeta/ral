#!/usr/bin/env ral

# install.ral — build and install ral from source.
# May be run from anywhere; locates the repo root via $SCRIPT.

let here      = dirname $SCRIPT
let repo_root = resolve-path "$here/.."

if $[not !{is-file "$repo_root/ral/Cargo.toml"}] {
    fail [status: 1, message: 'ral/Cargo.toml not found — repository may be incomplete']
}

cargo +stable install --force --locked --path ral
cargo +stable install --force --locked --path exarch
cargo +stable install --force --locked --path ral-sh

let cargo_home = try { return $ENV[CARGO_HOME] } { |_| return "$ENV[HOME]/.cargo" }
let ral_bin    = "$cargo_home/bin/ral"
let kernel     = uname -s

# Ad-hoc signing is a macOS ritual, so this step is a no-op everywhere else,
# and `attempt` is what keeps that no-op quiet.  A script ends with the status
# of its last statement, and an `if` whose condition was false ran nothing and
# so has no status of its own to report — unwrapped, the gate below would end
# every Windows and Linux `just install` in a failure the install did not have.
attempt {
    if $[!{equal $kernel 'Darwin'} && !{is-file $ral_bin}] {
        codesign -s - $ral_bin
    }
}
