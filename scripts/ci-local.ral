#!/usr/bin/env ral

# ci-local.ral — replay the Linux CI job locally so you can check
# before pushing.  Mirrors the `check` job in
# .github/workflows/ci.yml; kept in lock-step with that file.
#
# Windows is cross-checked here too (`cargo check`, which never links)
# against the shipping x86_64-pc-windows-msvc ABI — exarch (and synod,
# which sits atop it) is excluded because its rustls ->
# aws-lc-sys dependency compiles C against Windows system headers,
# impossible from a Unix host.  guest-net is excluded alongside them:
# it depends on exarch, so without excluding it too, exarch's
# C-compiling dependency tree (fff-search -> git2 -> libgit2-sys ->
# libz-sys) comes right back in and the check fails.  Only *test
# execution* on real Windows still needs the windows-check CI job
# (.github/workflows/windows.yml).
#
# Steps:
#   1. cargo build --workspace --all-targets   (RUSTFLAGS=-D warnings)
#   2. cargo test --workspace
#   3. cargo check --workspace --exclude exarch --exclude synod
#        --exclude guest-net --all-targets
#        --target x86_64-pc-windows-msvc
#   4. uv run scripts/render-site.py
#   5. for f in examples/*/*.ral: cargo run -p ral -- --check $f
#
# Exits non-zero on the first failing step (default ral semantics —
# external command failures propagate).

let here      = dirname $SCRIPT
let repo_root = resolve-path "$here/.."

# Print a CI-style banner, then run the thunk.  Matches the `==>`
# section-header style used in build-release.ral so output from
# multiple scripts stays consistent.
let step = { |label thunk|
    echo ''
    echo "!{styled $ansi-cyan '==>'} !{styled $ansi-yellow $label}"
    !$thunk
}

within [dir: $repo_root] {
    # -D warnings is what CI sees; without it, local builds pass on
    # warnings that CI then rejects.  Scoped to the cargo block so
    # the python steps don't inherit it.
    within [env: [RUSTFLAGS: '-D warnings']] {
        step 'cargo build --workspace --all-targets' {
            cargo build --workspace --all-targets
        }
        step 'cargo test --workspace' {
            cargo test --workspace
        }

        # Poisoned cross-CC so blake3's build script (via uucore and
        # exarch) sees NoCompiler and falls back to its pure-Rust
        # intrinsics instead of hunting for ml64.exe.  Scoped to this
        # one step; shipped builds never set this variable.
        within [env: [CC_x86_64_pc_windows_msvc: 'cc-absent-use-blake3-pure-fallback']] {
            step 'cargo check --workspace --exclude exarch/synod/guest-net --target x86_64-pc-windows-msvc' {
                cargo check --workspace --exclude exarch --exclude synod --exclude guest-net --all-targets --target x86_64-pc-windows-msvc
            }
        }
    }

    step 'render-site.py' {
        uv run scripts/render-site.py
    }

    # plugins/*.ral are not checked here: the `_ed-*` builtins they call
    # live only on the interactive shell's table, so batch `--check`
    # cannot type them — the REPL checks each plugin as rc loads it.
    step 'syntax-check examples/*/*.ral' {
        for !{glob 'examples/*/*.ral'} { |f|
            cargo run -p ral --quiet -- --check $f
        }
    }
}

echo ''
echo "!{styled $ansi-green '  CI-local OK.'}"
