#!/usr/bin/env ral

# linux-ci.ral — replay the Linux half of CI in a container, because no
# macOS host can replay it at all: `core/src/sandbox.rs` gates `mod linux`
# out there, so a native `cargo check` never compiles the bwrap backend or
# its tests, and `ci-local.ral` — the same steps on whatever host you are
# on — silently proves nothing about them.
#
# The image is scripts/linux-box.Dockerfile; `just linux-box` builds it.
# The first step here probes for it, so a missing image fails at a banner
# naming the fix rather than somewhere inside cargo.
#
# `--privileged` is load-bearing.  bubblewrap mounts devpts for its virtual
# /dev, which an unprivileged container refuses, and every sandbox test
# would then skip instead of confining anything.
#
# synod is excluded: its tauri dependency links the GTK/WebKit stack, whose
# dev packages this image does not carry, and synod ships on macOS and
# Windows only.  ci.yml excludes it on the same grounds.  The site render
# and the examples check are not repeated here — they are host-agnostic,
# and ci-local.ral already covers them.

let here      = dirname $SCRIPT
let repo_root = resolve-path "$here/.."

# Print a CI-style banner, then run the thunk.  Same shape as
# ci-local.ral, so output from either script reads alike.
let step = { |label thunk|
    echo ''
    echo "!{styled $ansi-cyan '==>'} !{styled $ansi-yellow $label}"
    !$thunk
}

within [dir: $repo_root] {
    step 'podman image exists ral-linux-box (else: just linux-box)' {
        podman image exists ral-linux-box
    }

    step 'cargo clippy --workspace --exclude synod --all-targets' {
        podman run --rm --privileged --env 'RUSTFLAGS=-D warnings' -v "$repo_root:/workspace" -v ral-linux-cargo:/home/dev/.cargo -v ral-linux-target:/workspace/.target-linux ral-linux-box cargo clippy --workspace --exclude synod --all-targets
    }

    step 'cargo build --workspace --exclude synod --all-targets' {
        podman run --rm --privileged --env 'RUSTFLAGS=-D warnings' -v "$repo_root:/workspace" -v ral-linux-cargo:/home/dev/.cargo -v ral-linux-target:/workspace/.target-linux ral-linux-box cargo build --workspace --exclude synod --all-targets
    }

    step 'cargo test --workspace --exclude synod' {
        podman run --rm --privileged --init -v "$repo_root:/workspace" -v ral-linux-cargo:/home/dev/.cargo -v ral-linux-target:/workspace/.target-linux ral-linux-box cargo test --workspace --exclude synod --features ral-core/test-util,exarch/test-util
    }
}

echo ''
echo "!{styled $ansi-green '  Linux CI OK.'}"
