#!/usr/bin/env ral

# Builds the Unix release matrix locally, as build-binaries.yml does on Actions.
# Publishing is Actions' alone: push a `v*` tag.  Windows and synod are built
# only by Actions.
# For a stable release, the `v<version>` tag must match [workspace.package].version
# in Cargo.toml. Update both HomebrewFormula URLs together, with the same SHA-256
# computed from the actual GitHub tag archive, not a local archive.
#
# Flags:
#   --linux          include the Linux musl matrix (docker)
#   --macos          include macOS (host cargo, Darwin only)
#   --all            shorthand for --linux --macos; the default if no target flag
#   --local          build for the host only: no docker
#   --clean-builds   wipe the cache and artifact dirs (keeps docker images)
#   --clean-images   remove the cross-compile docker images
#   --clean          both of the above
#   --dry-run        print what would happen, do not run
#
# Linux builds in messense/rust-musl-cross images.  macOS has no cross image,
# so host cargo builds the host's own architecture only, ad-hoc codesigned.
#
# target/release-artifacts/, each name as <name>.tar.gz plus <name>.tar.gz.sha256:
#   ral-linux-{x86_64,arm64}[-allutils]   exarch-linux-{x86_64,arm64}
#   ral-macos-<host arch>[-allutils]      exarch-macos-<host arch>
#
# target/release-cache/:
#   registry/, rustup/   shared by every docker run
#   <triple>/            per-triple cargo target dir
#   target-host/         host cargo target for --local
#   target-macos/        host cargo target for --macos

# ── Helpers ───────────────────────────────────────────────────────────────

let has = { |x list|
    fold { |acc y| if $acc { return true } else { return $[$y == $x] } } false $list
}

# `uname` spellings to artifact-name spellings.
let norm_os = { |s|
    if $[$s == 'Darwin'] { return 'macos' } else { return !{lower $s} }
}
let norm_arch = { |s|
    if $[$s == 'aarch64'] { return 'arm64' } else { return $s }
}

let flags = ['--linux', '--macos', '--all', '--local',
             '--clean-builds', '--clean-images', '--clean',
             '--dry-run']
let known = [...$flags, '-h', '--help']

# Before the unknown-argument check, so `--help --whatever` still prints help.
if $[!{has '-h' !{args}} || !{has '--help' !{args}}] {
    let usage = map { |f| return "[$f]" } $flags
    echo 'build-release.ral' ...$usage
    exit 0
}

for !{args} { |a|
    if $[not !{has $a $known}] { warn "!{styled red "unknown argument: $a"}"; exit 2 }
}

let dry_run      = has '--dry-run'      !{args}
let want_local   = has '--local'        !{args}
let want_linux   = has '--linux'        !{args}
let want_macos   = has '--macos'        !{args}
let want_all     = has '--all'          !{args}
let want_clean_builds = $[!{has '--clean-builds' !{args}} || !{has '--clean' !{args}}]
let want_clean_images = $[!{has '--clean-images' !{args}} || !{has '--clean' !{args}}]
let want_clean        = $[$want_clean_builds || $want_clean_images]

let any_target  = $[$want_linux || $want_macos]
let default_all = if $any_target { return $want_all } else { return true }
let build_linux   = $[$want_linux   || $default_all]
let build_macos   = $[$want_macos   || $default_all]

let repo_root    = resolve-path "!{dirname $SCRIPT}/.."
let artifact_dir = "$repo_root/target/release-artifacts"
let cache_dir    = "$repo_root/target/release-cache"

# Read here, not in `main`: a dry run's handler would intercept `uname`.
let host_os   = norm_os !{uname -s}
let host_arch = norm_arch !{uname -m}

# The cross images ship amd64 only (run under Rosetta on Apple Silicon).
let musl_x86     = 'messense/rust-musl-cross:x86_64-musl'
let musl_arm     = 'messense/rust-musl-cross:aarch64-musl'
let pull_images  = [$musl_x86, $musl_arm]

let plain    = []
let allutils = ['--features', 'allutils']

# Shared by --local and --macos.  Names are built with `intercalate`: "$os-$arch"
# would parse as looking up `$os-`.  `sign` ad-hoc codesigns, as macOS requires.
let host_build = { |target pkg name feats sign|
    echo ''
    echo "!{styled cyan '==>'} !{styled yellow $name} !{styled dim '(host cargo)'}"
    within [env: [CARGO_TARGET_DIR: $target]] {
        cargo build --release -p $pkg ...$feats
    }
    let dst = "$cache_dir/binaries/$name"
    cp "$target/release/$pkg" $dst
    if $sign { attempt { codesign -s - $dst } }
    bash "$repo_root/scripts/package-release.sh" $dst "$artifact_dir/$name.tar.gz"
}
let host_variants_ral = { |target os arch sign|
    host_build $target 'ral' !{intercalate '-' ['ral', $os, $arch]}             $plain $sign
    host_build $target 'ral' !{intercalate '-' ['ral', $os, $arch, 'allutils']} $allutils $sign
}
# exarch has no allutils variant: `allutils` is a ral feature.
let host_variants_exarch = { |target os arch sign|
    host_build $target 'exarch' !{intercalate '-' ['exarch', $os, $arch]} $plain $sign
}

# A thunk, so --dry-run can run it under a handler that prints every command.
let main = {

    # Before the mkdirs, which would recreate what is being removed.
    if $want_clean_builds {
        for [$artifact_dir, $cache_dir] { |d|
            if !{exists $d} {
                echo "!{styled dim "  removing $d"}"
                rm -rf $d
            }
        }
    }
    if $want_clean_images {
        for $pull_images { |img|
            echo "!{styled dim '  removing docker image'} !{styled magenta $img}"
            attempt { docker rmi $img }
        }
        attempt { docker image prune -f }
    }
    if $want_clean { exit 0 }

    mkdir -p $artifact_dir
    mkdir -p "$cache_dir/registry"
    mkdir -p "$cache_dir/rustup"
    mkdir -p "$cache_dir/binaries"

    if $want_local {
        host_variants_ral    "$cache_dir/target-host" $host_os $host_arch false
        host_variants_exarch "$cache_dir/target-host" $host_os $host_arch false
        echo ''
        echo "!{styled green '  Local build done.'}  Artifacts in !{styled yellow $artifact_dir}"
        exit 0
    }

    let matrix = [
        [include: $build_linux,   pkg: 'ral',    img: $musl_x86, triple: 'x86_64-unknown-linux-musl',  bin: 'ral',     out: 'ral-linux-x86_64',           feats: $plain],
        [include: $build_linux,   pkg: 'ral',    img: $musl_x86, triple: 'x86_64-unknown-linux-musl',  bin: 'ral',     out: 'ral-linux-x86_64-allutils',  feats: $allutils],
        [include: $build_linux,   pkg: 'ral',    img: $musl_arm, triple: 'aarch64-unknown-linux-musl', bin: 'ral',     out: 'ral-linux-arm64',            feats: $plain],
        [include: $build_linux,   pkg: 'ral',    img: $musl_arm, triple: 'aarch64-unknown-linux-musl', bin: 'ral',     out: 'ral-linux-arm64-allutils',   feats: $allutils],
        [include: $build_linux,   pkg: 'exarch', img: $musl_x86, triple: 'x86_64-unknown-linux-musl',  bin: 'exarch',  out: 'exarch-linux-x86_64',        feats: $plain],
        [include: $build_linux,   pkg: 'exarch', img: $musl_arm, triple: 'aarch64-unknown-linux-musl', bin: 'exarch',  out: 'exarch-linux-arm64',         feats: $plain],
    ]

    # Pull both images concurrently rather than serially inside `docker run`.
    if $build_linux {
        echo ''
        echo "!{styled cyan '==>'} preparing cross-compile images"
        let pulls = map { |img|
            return !{watch $img { docker pull $img }}
        } $pull_images
        for $pulls { |h| await $h }
    }

    for $matrix { |t|
        if $t[include] {
            echo ''
            echo "!{styled cyan '==>'} !{styled yellow $t[out]} !{styled dim "($t[triple])"}"
            let td  = "$cache_dir/$t[triple]"
            let out = "$cache_dir/binaries/$t[out]"
            let run_args = [
                '--rm', '--platform=linux/amd64',
                '-v', "$repo_root:/work",
                '-v', "$cache_dir/registry:/usr/local/cargo/registry",
                '-v', "$cache_dir/rustup:/root/.rustup",
                '-v', "$td:/work/target",
                '-w', '/work',
            ]
            docker run ...$run_args $t[img] cargo build --release -p $t[pkg] --target $t[triple] ...$t[feats]
            cp "$td/$t[triple]/release/$t[bin]" $out
            attempt { chmod +x $out }
            bash "$repo_root/scripts/package-release.sh" $out "$artifact_dir/$t[out].tar.gz"
        }
    }

    if $build_macos {
        if $[$host_os == 'macos'] {
            host_variants_ral    "$cache_dir/target-macos" 'macos' $host_arch true
            host_variants_exarch "$cache_dir/target-macos" 'macos' $host_arch true
        } else {
            # Silent under --all or the default; warn only when asked for.
            if $want_macos {
                warn "!{styled red "  --macos requested but host is $host_os; skipping"}"
            }
        }
    }

    # Reads what the build wrote; a dry run wrote nothing.
    if $[not $dry_run] {
        echo ''
        echo "!{styled cyan '==>'} sha256 checksums"
        for !{list-dir $artifact_dir} { |e|
            if !{re-match '\.tar\.gz$' $e[name]} {
                let path = "$artifact_dir/$e[name]"
                let line =
                  try {
                    return !{sha256sum $path | from-string}
                  } { |_|
                    return !{shasum -a 256 $path | from-string}
                  }
                let hash = !{words $line}[0]
                to-string "$hash\n" > "$path.sha256"
            }
        }
        ls -1 $artifact_dir
    }
    echo ''
    echo "!{styled green '  Done.'}  Artifacts in !{styled yellow $artifact_dir}"
}

if $dry_run {
    within [handler: { |name argv| echo "!{styled dim "+ $name"}" ...$argv }] $main
} else { !$main }
