# Setting `gpu: `withheld` confines GPU access alone: ordinary commands still run
# under it, alone, nested and in spawned work

let assert_eq = { |name expected actual|
    if $[$expected != $actual] {
        warn "FAIL: $name expected: !{to-json $expected} actual: !{to-json $actual}"
        fail "assertion failed: $name"
    }
}

assert_eq 'alone' hi !{grant [gpu: `withheld] { /bin/echo hi }}
assert_eq 'pipeline' HI !{grant [gpu: `withheld] { /bin/echo hi | /usr/bin/tr a-z A-Z }}
assert_eq 'with net' hi !{grant [gpu: `withheld, net: `offline] { /bin/echo hi }}
assert_eq 'repeated' hi !{grant [gpu: `withheld] { grant [gpu: `withheld] { /bin/echo hi } }}
assert_eq 'under another axis' hi !{grant [net: `offline] { grant [gpu: `withheld] { /bin/echo hi } }}
assert_eq 'in spawned work' hi !{grant [gpu: `withheld] { await !{spawn "echo" { /bin/echo hi }} }}

# It leaves the other axes alone: an exec allowance still refuses
assert_eq 'exec still judged' refused !{try {
    grant [gpu: `withheld, exec: [allow: [`absolute /bin/echo]]] { /bin/sh -c 'exit 0' }
    return ran
} { |_| return refused }}

echo 'grant gpu tests done'
