# Grant [fs:] read and write sets gate every ral-owned file effect

let dir = temp-dir
let inside = "$dir/inside"
let outside = "$dir/outside"
mkdir -p $inside $outside
to-string secret > "$outside/secret.txt"
to-string original > "$outside/log.txt"
let root = !{absolute-path "$dir/.."}
let denied = { |body|
    try { !$body; echo 'ALLOWED' } { |e| echo "denied: !{re-match 'grant does not allow' $e[message]}" }
}

# Redirects: write, append, stdin, stderr
denied { grant [fs: [write: [`absolute $inside]]] { to-string leak > "$outside/new.txt" } }
echo !{exists "$outside/new.txt"}
denied { grant [fs: [write: [`absolute $inside]]] { to-string more >> "$outside/log.txt" } }
echo !{from-string < "$outside/log.txt"}
denied { grant [fs: [read: [`absolute $inside]]] { head < "$outside/secret.txt" } }
denied { grant [fs: [write: [`absolute $inside]]] { head /dev/null 2> "$outside/err.log" } }
echo !{exists "$outside/err.log"}
grant [fs: [write: [`absolute $inside]]] { to-string kept > "$inside/ok.txt" }
echo !{from-string < "$inside/ok.txt"}
echo !{grant [fs: [read: [`absolute $inside]]] { from-string < "$inside/ok.txt" }}

# A pipeline stage that runs in a helper carries the same grant
denied { grant [fs: [write: [`absolute $inside]]] {
    let sink = { from-line; /bin/echo seed > "$outside/leak.txt" }
    echo seed | !$sink
} }
echo !{exists "$outside/leak.txt"}
grant [fs: [write: [`absolute $inside]]] {
    let sink = { from-line; /bin/echo seed > "$inside/kept.txt" }
    echo seed | !$sink
}
echo !{from-string < "$inside/kept.txt"}

# Linking precedes lexical grants; the module's effects still obey them.
let linked = grant [fs: [read: [`absolute $inside]]] { use '../../lib/modules/values.ral' }
echo $linked[version]
grant [fs: [read: [`absolute $inside], write: [`absolute $inside]]] {
    within [env: [MODULE_WITNESS: "$inside/witness.txt"]] { use '../../lib/modules/write-witness.ral' }
}
echo !{from-string < "$inside/witness.txt"}
denied { grant [fs: [write: [`absolute $inside]]] {
    within [env: [MODULE_WITNESS: "$outside/witness.txt"]] { use '../../lib/modules/write-witness.ral' }
} }
echo !{exists "$outside/witness.txt"}

# Read-gated queries and write-gated temp builtins
denied { grant [fs: [read: [`absolute $inside]]] { file-info "$outside/secret.txt" } }
echo !{grant [fs: [read: [`absolute $inside]]] { file-info "$inside/ok.txt" }}[name]
denied { grant [fs: [read: [`absolute $inside]]] { resolve-path $outside } }
echo !{re-match '^/' !{grant [fs: [read: [`absolute $inside]]] { resolve-path $inside }}}
denied { grant [fs: [write: [`absolute $inside]]] { temp-dir } }
denied { grant [fs: [write: [`absolute $inside]]] { temp-file } }
let td = grant [fs: [write: [`absolute $root]]] { temp-dir }
echo !{exists $td}
let tf = grant [fs: [write: [`absolute $root]]] { temp-file }
echo !{exists $tf}

rm -rf $dir $td $tf
echo 'grant fs sets tests done'
