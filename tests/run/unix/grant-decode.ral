# A grant whose targets cannot be decoded is refused before its body runs

# A place that is not absolute, a path-shaped name, a directory left unwrapped
try { grant [fs: [read: [`absolute proj]]] { echo BODYRAN }; return () } { |e| echo $e[message] }
try { grant [exec: [allow: [`name ./tool]]] { echo BODYRAN }; return () } { |e| echo $e[message] }
try { grant [exec: [allow: [`absolute /usr/bin]]] { echo BODYRAN }; return () } { |e| echo $e[message] }

echo 'grant decode tests done'
