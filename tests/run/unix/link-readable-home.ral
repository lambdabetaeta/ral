# Is-link and is-readable on files, directories, links and nothing;
# abbreviate-home folds only a whole leading home component

let assert_eq = { |name expected actual|
    if $[$expected != $actual] {
        warn "FAIL: $name expected: !{to-json $expected} actual: !{to-json $actual}"
        fail "assertion failed: $name"
    }
}

let d = temp-dir
to-string x > "$d/f"
mkdir "$d/sub"
ln -s "$d/f" "$d/to-file"
ln -s "$d/sub" "$d/to-dir"
ln -s "$d/nowhere" "$d/dangling"

# is-link is true of a link itself, dangling or not, and of nothing else
assert_eq 'file' false !{is-link "$d/f"}
assert_eq 'dir' false !{is-link "$d/sub"}
assert_eq 'link to file' true !{is-link "$d/to-file"}
assert_eq 'link to dir' true !{is-link "$d/to-dir"}
assert_eq 'dangling link' true !{is-link "$d/dangling"}
assert_eq 'absent' false !{is-link "$d/none"}

# is-readable follows links: a dangling one reads nothing
assert_eq 'readable file' true !{is-readable "$d/f"}
assert_eq 'readable dir' true !{is-readable "$d/sub"}
assert_eq 'readable link to file' true !{is-readable "$d/to-file"}
assert_eq 'readable link to dir' true !{is-readable "$d/to-dir"}
assert_eq 'readable dangling' false !{is-readable "$d/dangling"}
assert_eq 'readable absent' false !{is-readable "$d/none"}

# Both answer against the within directory
within [dir: $d] {
    assert_eq 'relative link' true !{is-link to-file}
    assert_eq 'relative readable' true !{is-readable sub}
    assert_eq 'relative absent' false !{is-link f}
}

# abbreviate-home: the home directory and what lies under it become `~`
within [env: [HOME: $d]] {
    assert_eq 'under home' '~/sub/x' !{abbreviate-home "$d/sub/x"}
    assert_eq 'home itself' '~' !{abbreviate-home $d}
    assert_eq 'sibling of home' "$(d)-other/x" !{abbreviate-home "$(d)-other/x"}
    assert_eq 'elsewhere' '/usr/bin' !{abbreviate-home /usr/bin}
    assert_eq 'empty' '' !{abbreviate-home ''}
    assert_eq 'already abbreviated' '~/x' !{abbreviate-home '~/x'}
}

rm -rf $d
echo 'link, readable and home tests done'
