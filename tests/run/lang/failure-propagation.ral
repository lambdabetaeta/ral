# §10.0 failure propagation

# `cat`'s complaints land in a file, so each failure below is `cat`'s own
let d = temp-dir

# Sequential: failure stops execution
try {
    cat /nonexistent 2> "$d/err"
    echo 'SHOULD NOT REACH'
} { |err|
    echo 'propagation works'
}

# try suppresses failure
try { cat /nonexistent 2> "$d/err" } { |_| echo 'caught' }

# ? chain stops at the first success — even a `false` value is a success
return false ? return true

# ? chain falls through a failing arm to the next
cat /nonexistent 2> "$d/err" ? echo 'recovered'

# ? chain: when every arm fails, the final error propagates
try { cat /nonexistent 2> "$d/err" ? cat /also-missing 2> "$d/err" } { |_| echo 'all arms failed' }

# A failing pipeline under `try` and capture reports through both frames
echo !{try { !{ echo a | fail 'boom' } } { |e| return $e[message] }}

# A non-final `?` arm's failure stays catchable inside a function
let broken = { |x| fail 'boom' }
let fallback = { |y| broken $y ? return 7 }
echo !{fallback 1}

# A failing `guard` release fails the computation with its own message.
echo !{try { let _ = guard { () } { |_| return 7 } { |_ _| fail 'release failed' }; return 'cleanup unexpectedly succeeded' } { |e| return $e[message] }}

rm -rf $d
echo 'failure propagation tests done'
