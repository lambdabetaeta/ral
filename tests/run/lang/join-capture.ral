# `let` captures a command-only join; mixed joins need explicit capture.

let assert_eq = { |name expected actual|
    if $[$expected != $actual] {
        warn "FAIL: $name expected: !{to-json $expected} actual: !{to-json $actual}"
        fail "assertion failed: $name"
    }
}

# The enclosing `let` captures a command-only `if` (SPEC §17.5).
let taken = if true { echo one } else { echo two }
assert_eq 'if then-arm' one $taken

let other = if false { echo one } else { echo two }
assert_eq 'if else-arm' two $other

# Capture explicitly beside a String arm (SPEC §17.6).
let empty_arm = if false { return !{echo one} } else { '' }
assert_eq 'empty arm' '' $empty_arm

let chained = ^false ? echo fallback
assert_eq 'chain arm' fallback $chained

# Capture explicitly beside a String handler (SPEC §17.6).
let recovered = try { return !{^false} } { |_| return '' }
assert_eq 'try handler' '' $recovered

# The body arm is a block in hand: the join is still a command, and a
# decoder may read it at the pipe.
let arm = { echo indirect }
let indirect = try $arm { |_| return () } | from-line
assert_eq 'command arm in hand' indirect $indirect

# An unwritten handler arrow still receives the error; `let` captures the join.
let h = { |e| echo "handled $e[message]" }
let handled = try { fail 'boom' } { !$h }
assert_eq 'handler under an unwritten arrow' 'handled boom' $handled

echo 'join capture done'
