# Within [env:] and [dir:] scope what children and the shell see

within [env: [TEST_VAR: hello]] {
    printenv TEST_VAR
}

# env doesn't leak
try { printenv TEST_VAR | from-string } { |_| echo 'TEST_VAR correctly unset'; return "" }

# Nested env
within [env: [A: 1]] {
    within [env: [B: 2]] {
        printenv A
        printenv B
    }
    printenv A
}

# Chdir into a fresh scratch directory and prove the block observed it via
# the `cwd` primitive, not by echoing the literal (run-specific) path.

let original = !{cwd}
let target = temp-dir
let observed = !{ within [dir: $target] { cwd } }
if $[$observed == $target] { echo 'dir changed' } else { echo 'dir mismatch!' }

# dir doesn't leak
let after = !{cwd}
if $[$original == $after] { echo 'cwd restored' } else { echo 'cwd leaked!' }
rm -rf $target

# An option's value may be computed elsewhere; the empty option set is the
# form's own bracket.
let bound_env = [BOUND_VAR: bound]
within [env: $bound_env] {
    printenv BOUND_VAR
}

within [] {
    echo 'no options'
}

# Bad options are errors
try { within [dir: '/nonexistent_dir_xyz'] { echo bad } } { |_| echo 'missing dir refused' }
try { within [env: [PWD: '/tmp']] { echo bad } } { |_| echo 'PWD refused' }
try { within [env: [OLDPWD: '/tmp']] { echo bad } } { |_| echo 'OLDPWD refused' }

echo 'within env/dir tests done'
