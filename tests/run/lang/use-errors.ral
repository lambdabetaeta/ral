# Linking failures are static; a checked module's body can still fail at runtime.

let assert_eq = { |name expected actual|
    if $[$expected != $actual] {
        warn "FAIL: $name expected: !{to-json $expected} actual: !{to-json $actual}"
        fail "assertion failed: $name"
    }
}

let failing = try {
    let _ = use '../../lib/modules/failing.ral'
    fail 'ran'
} { |e| return $e }
assert_eq 'module message' boom $failing[message]
assert_eq 'module status' 1 $failing[status]
assert_eq 'module operation' fail $failing[frame]
assert_eq 'module source' true !{re-match '(^|/)lib/modules/failing\.ral$' $failing[site][script]}
assert_eq 'module line' 1 $failing[site][line]
assert_eq 'module column' 1 $failing[site][col]

echo 'use error tests done'
