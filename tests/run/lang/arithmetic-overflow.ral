# `+`, `-` and `*` on Int are checked: an overflow is a catchable error,
# never a wrapped result

let assert_eq = { |name expected actual|
    if $[$expected != $actual] {
        warn "FAIL: $name expected: !{to-json $expected} actual: !{to-json $actual}"
        fail "assertion failed: $name"
    }
}

let top = 9223372036854775807
let bottom = $[-9223372036854775808]
let add = { |a b| return $[$a + $b] }
let sub = { |a b| return $[$a - $b] }
let mul = { |a b| return $[$a * $b] }

# The extremes themselves are reachable
assert_eq 'top plus zero' $top !{add $top 0}
assert_eq 'bottom minus zero' $bottom !{sub $bottom 0}
assert_eq 'top times one' $top !{mul $top 1}
assert_eq 'bottom times one' $bottom !{mul $bottom 1}
assert_eq 'top minus one' 9223372036854775806 !{add $top -1}
assert_eq 'bottom plus one' -9223372036854775807 !{sub $bottom -1}

# One step past either end is refused with a plain runtime error, status 1
let overflows = { |op a b|
    try { let _ = $op $a $b; return false } { |e| return $[$e[status] == 1] }
}
assert_eq 'top + 1' true !{overflows $add $top 1}
assert_eq 'bottom + -1' true !{overflows $add $bottom -1}
assert_eq 'bottom - 1' true !{overflows $sub $bottom 1}
assert_eq 'top - -1' true !{overflows $sub $top -1}
assert_eq '0 - bottom' true !{overflows $sub 0 $bottom}
assert_eq 'top * 2' true !{overflows $mul $top 2}
assert_eq 'bottom * 2' true !{overflows $mul $bottom 2}
assert_eq 'bottom * -1' true !{overflows $mul $bottom -1}
assert_eq 'top + top' true !{overflows $add $top $top}

# Negating the smallest Int overflows too
assert_eq 'negation' true !{try { let _ = $[-$bottom]; return false } { |_| return true }}

echo 'arithmetic overflow tests done'
