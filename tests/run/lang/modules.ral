# Modules are linked when their importer is checked.

# Only public bindings come back; missing and private fields are static errors.
let m = use '../../lib/modules/values.ral'
echo $m[version]
let m2 = use '../../lib/modules/values.ral'
echo $[$m == $m2]

# A nested path is relative to the module that writes it.
let entry = use '../../lib/modules/entry.ral'
echo $entry[via_use]

# Each export is instantiated in the importer, then generalised by this let.
let poly = use '../../lib/modules/functions.ral'
echo !{$poly[id] 1}
echo !{$poly[id] 'a'}
echo !{$poly[inc] 4}
echo $poly[label]

# The importer cannot shadow the module's own bindings or its prelude.
let version = 99
let length = { |_| return 99 }
let closed = use '../../lib/modules/values.ral'
echo "$closed[version] $closed[count]"

# Runtime cwd and read grants do not resolve or read a linked module.
let dir = temp-dir
within [dir: $dir] {
    grant [fs: [read: []]] {
        let linked = use '../../lib/modules/values.ral'
        echo $linked[version]
    }
}
rm -rf $dir

# A use inside a function is linked at check, but runs its body on every call.
let load = { use '../../lib/modules/body-effect.ral' }
grant [fs: [read: []]] {
    let _ = load
    let _ = load
}

echo 'module tests done'
