# Test: how try reports a command that did not succeed

# The handler's record names why: a process failure names its program and how it failed
try { sh -c 'exit 3'; fail 'ran' } { |e| echo $e[reason] }
try { /nonexistent/ral-no-such-command; fail 'ran' } { |e| echo $e[reason] }
try { ral-no-such-command; fail 'ran' } { |e| echo $e[reason] }
try { sh -c 'kill -SEGV $$'; fail 'ran' } { |e| echo $e[reason] }

# A file without the execute bit is not runnable, by path or through PATH
let dir = temp-dir
to-string '#!/bin/sh' > "$dir/not-executable"
let unrunnable = { |e| case $e[reason] [
    `process: { |p| case $p[failure] [
        `not-runnable: { |detail| echo $detail[why]; echo $[!{length $detail[found]} > 0] },
        `exited: { |_| fail 'expected not-runnable' },
        `signaled: { |_| fail 'expected not-runnable' },
        `not-found: { |_| fail 'expected not-runnable' },
    ] },
    `timed-out: { |_| fail 'expected not-runnable' },
    `cancelled: { |_| fail 'expected not-runnable' },
    `raised: { |_| fail 'expected not-runnable' },
] }
within [dir: $dir] {
    try { ./not-executable; fail 'ran' } { |e| unrunnable $e }
}
within [env: [PATH: "$dir:/bin:/usr/bin"]] {
    try { not-executable; fail 'ran' } { |e| unrunnable $e }
}
rm -rf $dir

echo 'try reason tests done'
