# Test: the `env` builtin reads the shell's own environment

# A numeric use is refused at the env door.
let refused = try {
    let n = $[!{env}[HOME] + 1]
    return false
} { |e| return $[!{re-match '^env:.*`/HOME`' !{describe $e}} && !{re-match 'line 5$' !{describe $e}}] }
if $[not $refused] { fail 'env must refuse the numeric HOME use at its door, naming /HOME and line 5' }
echo $[!{env}[HOME] == !{home}]

# within [env:] is visible to `env`; nested overrides stack; none leaks
within [env: [A: 1]] {
    within [env: [B: 2]] {
        let e = env
        echo $e[A] $e[B]
    }
    let e = env
    echo $e[A]
}
echo !{try { let after = env; let v = $after[A]; return false } { |_| return true }}
