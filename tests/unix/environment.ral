# Test: the `env` builtin reads the shell's own environment

# HOME is the home directory the shell reports
echo $[!{env}[HOME] == !{home}]

# within [env:] is visible to `env`; nested overrides stack; none leaks
within [env: [A: 1]] {
    within [env: [B: 2]] {
        let e = env
        echo $e[A] $e[B]
    }
    let e = env
    echo $e[A]
}
let after = env
echo !{try { let v = $after[A]; return false } { |_| return true }}
