# Test: a pipeline stage behaves like the same command on its own —
# statuses, ^name, handlers, redirects and spreads

let d = temp-dir

# A pipeline ends with its last stage; a non-match is a failure try can see
/bin/echo hello | grep hello
try { /bin/echo hello | grep zzz } { |e| echo "no match: status $e[status]" }

# An exit of 137 is an exit; only a real SIGKILL is a signal
try { /bin/sh -c 'exit 137' } { |e| echo "$e[message]" }
try { /bin/sh -c 'kill -KILL $$' } { |e| echo "$e[message]" }

# The first external failure wins over a later stage's own complaint
try { /bin/sh -c 'exit 42' | from-json; return () } { |e| echo "$e[message]" }

# 2>&1 inside a stage merges stderr into the bytes it hands on
let both = !{!{/bin/sh -c 'printf out; printf err >&2' 2>&1} | from-string}
echo $both

# ^name reaches the external, in a pipeline as anywhere
^echo HELLO | cat

# A handler answers for its name as a stage; ^name skips it
within [handlers: [cat: { |args| /bin/echo via-handler }]] { echo hi | ^cat }
within [handlers: [cat: { |args| /bin/echo via-handler }]] { echo hi | cat }

# A stage's own redirect takes its bytes: the pipe sees EOF
/bin/echo redirected > "$d/f1" | cat
cat "$d/f1"

# ... and the stage still finishes when the reader never looks at stdin
/bin/echo redirected > "$d/f2" | /usr/bin/true
cat "$d/f2"
let f = { |x| /bin/echo $x }
$f hello > "$d/f3" | /usr/bin/true
cat "$d/f3"

# A redirect on an aliased head is installed for the alias body
alias myecho { |a| /bin/echo ...$a }
myecho stdout_marker > "$d/a1"
cat "$d/a1"
alias myerr { |a| /bin/sh -c 'echo stderr_marker >&2' }
myerr 2> "$d/a2"
cat "$d/a2"
echo stdin_marker > "$d/a3"
alias mycat { |a| /bin/cat }
mycat < "$d/a3"

# ... and for a handler head, whether it is a stage, a builtin body, or catch-all
within [handlers: [foo: { |args| /bin/echo stage_marker }]] { foo > "$d/h1" | cat }
cat "$d/h1"
within [handlers: [foo: { |args| echo mock_marker }]] { foo > "$d/h2" }
cat "$d/h2"
within [handler: { |name _args| echo $name }] { catchme > "$d/h3" }
cat "$d/h3"

# A spread contributes exactly its elements to an external stage's argv
let ee = []
echo hi | /usr/bin/printf '[%s]\n' --flag '' ...$ee
let ff = ['-n', 'hello']
echo hi | /usr/bin/printf '[%s]\n' --flag ...$ff

# A failing arm's bytes flush live rather than into the winner's value
let vv = /bin/sh -c 'echo half; exit 3' ? echo x
echo $vv

rm -rf $d
echo 'pipeline stage tests done'
