# Test: the audit trail (§13.3)

# A builtin application is not an observation: the pure fragment performs no
# effect, so `echo` and `length` leave the trail empty
let quiet = audit { echo 'quiet'; length [1, 2] }
echo !{succeeded $quiet}
echo !{length $quiet[trail]}

# Basic audit: the report is `[outcome, trail]`, and `commands` picks the
# `command` observations — the externals — out of the trail
let report = audit { /bin/echo 'step one'; /bin/echo 'step two' }
echo !{succeeded $report}
echo !{length !{commands $report}}
echo !{commands $report}[0][argv][0]
echo !{commands $report}[1][argv][1]

# try is transparent: it observes nothing of its own, so the failing `sh`
# and the handler's `/bin/echo` land directly in the audit's trail
let report2 = audit {
    try { /bin/sh -c 'exit 1' } { |_| /bin/echo 'handled' }
    /bin/echo 'continued'
}
echo !{succeeded $report2}
echo !{length !{commands $report2}}
echo !{commands $report2}[0][argv][0]
echo !{commands $report2}[0][status]
echo !{commands $report2}[1][argv][0]
echo !{commands $report2}[2][argv][0]

# for/map/each are transparent, and so is the builtin that performs the
# iteration: only the body's commands land, flat, in the trail
let report3 = audit { for [a, b] { |x| /bin/echo $x } }
echo !{succeeded $report3}
echo !{length !{commands $report3}}
echo !{commands $report3}[0][argv][1]
echo !{commands $report3}[1][argv][1]

# A failing body settles into `err`, carrying the same record `try` hands a
# handler; the audit expression itself succeeds
let failed = audit { fail [status: 3, message: 'no index'] }
echo !{succeeded $failed}
case $failed[outcome] [
    `ok:  { |_| echo 'unreachable' },
    `err: { |e| echo "$e[status] $e[message]" },
]

# Nested audit: the inner audit still returns its own report, but its real
# commands also flatten into the outer audit's trail
let outer = audit {
    /bin/echo 'outer'
    let inner = audit { /bin/echo 'inner' }
}
echo !{succeeded $outer}
echo !{length !{commands $outer}}
echo !{commands $outer}[0][argv][0]
echo !{commands $outer}[1][argv][0]

# grant is transparent — its body's command lands directly in the trail,
# with no grant observation framing it
let grant_report = audit { grant [exec: ['/bin/echo': 'allow']] { /bin/echo 'inside' } }
echo !{length !{commands $grant_report}}
echo !{commands $grant_report}[0][argv][0]

# within is transparent too
let within_report = audit { within [dir: !{cwd}] { /bin/echo 'inside' } }
echo !{length !{commands $within_report}}
echo !{commands $within_report}[0][argv][0]

# guard is transparent — both body and cleanup land directly in the trail
let gr = audit { guard { /bin/echo 'body' } { /bin/echo 'cleanup' } }
echo !{length !{commands $gr}}
echo !{commands $gr}[0][argv][0]
echo !{commands $gr}[1][argv][0]

# Only refusals are recorded as capability checks; an admitted exec leaves
# just the command observation. `checks` reads `resource decision detail`.
let checks = { |report key|
    fold { |acc o|
        case $o[what] [
            `check:   { |c| return [...$acc, "$c[resource] $c[decision] !{get $c[fields] $key ''}"] },
            `command: { |_| return $acc },
            `write:   { |_| return $acc },
            `read:    { |_| return $acc },
            `grep:    { |_| return $acc },
            `worker:  { |_| return $acc },
            `act:     { |_| return $acc }
        ]
    } [] $report[trail]
}
let argv0s = { |report| map { |c| return "$c[argv][0]" } !{commands $report} }

let admitted = audit { grant [exec: ['/bin/echo': 'allow']] { /bin/echo hi } }
echo !{checks $admitted name}
echo !{argv0s $admitted}

# A refusal is recorded whatever the grant says about auditing; it fails the
# body, and it names the refused command
let refused = audit { grant [exec: ['/bin/echo': 'allow']] { /bin/sh -c 'exit 0' } }
echo !{succeeded $refused}
echo !{checks $refused name}

# So is a refused write, naming the operation
let scratch = temp-dir
let blocked = audit { grant [fs: [write: [$scratch]]] { to-string x > '/ralaudit_test.txt' } }
echo !{checks $blocked op}
rm -rf $scratch

# A stage of an external pipeline is observed as a command in its own right
echo !{argv0s !{audit { /bin/echo hi | /bin/cat }}}

# `^name` reaches the binary, and the observation says so; the builtin stage
# feeding it is no observation at all
let caret = audit { echo hi | ^cat }
echo !{map { |c| return "$c[argv][0] $c[origin]" } !{commands $caret}}

# Observations made inside a pipeline stage merge into the parent's trail
let relay = { from-line; /bin/echo helper }
echo !{argv0s !{audit { echo seed | !$relay }}}

# File effects are observations too: a read, and a write with its mode and
# outcome. A failing body aborts an atomic write; an unopenable target fails it.
let io-facts = { |report|
    fold { |acc o|
        case $o[what] [
            `write:   { |w| return [...$acc, "write $w[mode] $w[outcome] !{basename $w[path]}"] },
            `read:    { |r| return [...$acc, "read !{basename $r[path]}"] },
            `check:   { |_| return $acc },
            `command: { |_| return $acc },
            `grep:    { |_| return $acc },
            `worker:  { |_| return $acc },
            `act:     { |_| return $acc }
        ]
    } [] $report[trail]
}
let io-dir = temp-dir
echo !{io-facts !{audit {
    to-string x > "$io-dir/a.txt"
    from-string < "$io-dir/a.txt"
    to-string y >> "$io-dir/a.txt"
    to-string z >~ "$io-dir/s.txt"
}}}
echo !{io-facts !{audit {
    try { !{ fail [status: 1, message: 'boom'] } > "$io-dir/never.txt" } { |_| return () }
    try { to-string x > "$io-dir/no-such-dir/out.txt" } { |_| return () }
}}}
echo !{exists "$io-dir/never.txt"}

# A write is stamped at its redirect, never at the body's last command
let write-cols = { |report|
    fold { |acc o|
        case $o[what] [
            `write:   { |_| case $o[site] [`just: { |s| return [...$acc, $s[col]] }, `none: { |_| return $acc }] },
            `read:    { |_| return $acc },
            `check:   { |_| return $acc },
            `command: { |_| return $acc },
            `grep:    { |_| return $acc },
            `worker:  { |_| return $acc },
            `act:     { |_| return $acc }
        ]
    } [] $report[trail]
}
let stamped = audit {
    !{ echo a; true } > "$io-dir/site.txt"
}
echo !{write-cols $stamped}
rm -rf $io-dir

# A bundled tool is observed as an external command
echo !{map { |c| return "$c[argv][0] $c[origin] $c[status]" } !{commands !{audit { printf '' }}}}

# An audit that follows a `guard` still records its own commands
let _ = audit { guard { return () } { return () } }
echo !{argv0s !{audit { /bin/echo hi }}}

# A spawn inside an audit leaves the foreground trail whole
echo !{argv0s !{audit { /bin/echo one; spawn { sleep 0.02 }; /bin/echo two }}}

# A guard's cleanup runs on the normal path, and its body's value survives
echo !{argv0s !{audit { guard { return 7 } { /bin/echo cleaned } }}}
echo !{guard { return 7 } { echo cleaned }}

# A command inside a function body is recorded into the enclosing audit
let emit = { |_| /bin/echo audited-from-fn }
echo !{argv0s !{audit { emit () }}}

# A command's captured bytes ride beside its argv
each { |c| echo !{bytes-to-string $c[stdout]} $c[argv][0] } !{commands !{audit { /bin/echo hi }}}

# Forcing an arity-0 native is no more an observation than applying it
let forced = audit { !$cwd }
let applied = audit { cwd }
echo !{length $forced[trail]} !{length $applied[trail]}

# A pipeline that ends in an audit binds the audit's record, not the piped text
let piped = echo a | audit { cat }
echo !{succeeded $piped}
echo !{argv0s $piped}

echo 'audit trail tests done'
