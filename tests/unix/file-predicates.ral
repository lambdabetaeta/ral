# Test: is-writable, is-readable and is-link follow symlinks and honour mode bits

let d = temp-dir
to-string x > "$d/rw"
chmod 644 "$d/rw"
to-string x > "$d/ro"
chmod 444 "$d/ro"
ln -s "$d/ro" "$d/link"

echo !{is-writable "$d/rw"} !{is-writable "$d/ro"} !{is-writable "$d/link"}
echo !{is-link "$d/link"} !{is-readable "$d/link"} !{is-link "$d/rw"}

chmod 644 "$d/ro"
rm -rf $d
echo 'file predicate tests done'
