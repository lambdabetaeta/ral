# Test: audit records capability checks, and only refusals

# Only refusals are recorded as capability checks; an admitted exec leaves
# just the command observation. `checks` reads `resource decision detail`.
let checks = { |report key|
    fold { |acc o|
        case $o[what] [
            `check:   { |c| return [...$acc, "!{str $c[resource]} !{str $c[decision]} !{get $c[fields] $key ''}"] },
            `command: { |_| return $acc },
            `write:   { |_| return $acc },
            `read:    { |_| return $acc },
            `grep:    { |_| return $acc },
            `worker:  { |_| return $acc },
            `act:     { |_| return $acc }
        ]
    } [] $report[trail]
}
let argv0s = { |report| map { |c| return "$c[argv][0]" } !{commands $report} }

let admitted = audit { grant [exec: [allow: [`absolute /bin/echo]]] { /bin/echo hi } }
echo !{checks $admitted name}
echo !{argv0s $admitted}

# A refusal is recorded whatever the grant says about auditing; it fails the
# body, and it names the refused command
let refused = audit { grant [exec: [allow: [`absolute /bin/echo]]] { /bin/sh -c 'exit 0' } }
echo !{succeeded $refused}
echo !{checks $refused name}

# So is a refused write, naming the operation
let scratch = temp-dir
let blocked = audit { grant [fs: [write: [`absolute $scratch]]] { to-string x > '/ralaudit_test.txt' } }
echo !{checks $blocked op}
rm -rf $scratch

echo 'audit check tests done'
