# Test: audit is transparent to try, for, grant, within, guard and nesting

# A builtin application is not an observation: the pure fragment performs no
# effect, so `echo` and `length` leave the trail empty
let quiet = audit { echo 'quiet'; length [1, 2] }
echo !{succeeded $quiet}
echo !{length $quiet[trail]}

# Basic audit: the report is `[outcome, trail]`, and `commands` picks the
# `command` observations — the externals — out of the trail
let report = audit { /bin/echo 'step one'; /bin/echo 'step two' }
echo !{succeeded $report}
echo !{length !{commands $report}}
echo !{commands $report}[0][argv][0]
echo !{commands $report}[1][argv][1]

# try is transparent: it observes nothing of its own, so the failing `sh`
# and the handler's `/bin/echo` land directly in the audit's trail
let report2 = audit {
    try { /bin/sh -c 'exit 1' } { |_| /bin/echo 'handled' }
    /bin/echo 'continued'
}
echo !{succeeded $report2}
echo !{length !{commands $report2}}
echo !{commands $report2}[0][argv][0]
echo !{commands $report2}[0][status]
echo !{commands $report2}[1][argv][0]
echo !{commands $report2}[2][argv][0]

# for/map/each are transparent, and so is the builtin that performs the
# iteration: only the body's commands land, flat, in the trail
let report3 = audit { for [a, b] { |x| /bin/echo $x } }
echo !{succeeded $report3}
echo !{length !{commands $report3}}
echo !{commands $report3}[0][argv][1]
echo !{commands $report3}[1][argv][1]

# A failing body settles into `err`, carrying the same record `try` hands a
# handler; the audit expression itself succeeds
let failed = audit { fail 'no index' }
echo !{succeeded $failed}
case $failed[outcome] [
    `ok:  { |_| echo 'unreachable' },
    `err: { |e| echo "$e[frame] $e[message]" },
]

# Nested audit: the inner audit still returns its own report, but its real
# commands also flatten into the outer audit's trail
let outer = audit {
    /bin/echo 'outer'
    let inner = audit { /bin/echo 'inner' }
}
echo !{succeeded $outer}
echo !{length !{commands $outer}}
echo !{commands $outer}[0][argv][0]
echo !{commands $outer}[1][argv][0]

# grant is transparent — its body's command lands directly in the trail,
# with no grant observation framing it
let grant_report = audit { grant [exec: [allow: [`absolute /bin/echo]]] { /bin/echo 'inside' } }
echo !{length !{commands $grant_report}}
echo !{commands $grant_report}[0][argv][0]

# within is transparent too
let within_report = audit { within [dir: !{cwd}] { /bin/echo 'inside' } }
echo !{length !{commands $within_report}}
echo !{commands $within_report}[0][argv][0]

# guard is transparent — both body and cleanup land directly in the trail
let gr = audit { guard { /bin/echo 'body' } { /bin/echo 'cleanup' } }
echo !{length !{commands $gr}}
echo !{commands $gr}[0][argv][0]
echo !{commands $gr}[1][argv][0]

echo 'audit transparency tests done'
