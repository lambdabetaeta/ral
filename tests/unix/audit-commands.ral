# Test: audit observes external commands in pipelines, functions, spawns and guards

let argv0s = { |report| map { |c| return "$c[argv][0]" } !{commands $report} }

# A stage of an external pipeline is observed as a command in its own right
echo !{argv0s !{audit { /bin/echo hi | /bin/cat }}}

# `^name` reaches the binary, and the observation says so; the builtin stage
# feeding it is no observation at all
let caret = audit { echo hi | ^cat }
echo !{map { |c| return "$c[argv][0] !{str $c[origin]}" } !{commands $caret}}

# Observations made inside a pipeline stage merge into the parent's trail
let relay = { from-line; /bin/echo helper }
echo !{argv0s !{audit { echo seed | !$relay }}}

# A bundled tool is observed as an external command
echo !{map { |c| return "$c[argv][0] !{str $c[origin]} $c[status]" } !{commands !{audit { printf '' }}}}

# An audit that follows a `guard` still records its own commands
let _ = audit { guard { return () } { return () } }
echo !{argv0s !{audit { /bin/echo hi }}}

# A spawn inside an audit leaves the foreground trail whole
echo !{argv0s !{audit { /bin/echo one; spawn { sleep 0.02 }; /bin/echo two }}}

# A guard's cleanup runs on the normal path, and its body's value survives
echo !{argv0s !{audit { guard { return 7 } { /bin/echo cleaned } }}}
echo !{guard { return 7 } { echo cleaned }}

# A command inside a function body is recorded into the enclosing audit
let emit = { |_| /bin/echo audited-from-fn }
echo !{argv0s !{audit { emit () }}}

# Without byte capture a command's recorded stdout is empty
each { |c| echo !{bytes-to-string $c[stdout]} $c[argv][0] } !{commands !{audit { /bin/echo hi }}}

# Forcing an arity-0 native is no more an observation than applying it
let forced = audit { !$cwd }
let applied = audit { cwd }
echo !{length $forced[trail]} !{length $applied[trail]}

# A pipeline that ends in an audit binds the audit's record, not the piped text
let piped = echo a | audit { cat }
echo !{succeeded $piped}
echo !{argv0s $piped}

echo 'audit command tests done'
