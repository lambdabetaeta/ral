# Typed grant values: places, selectors and verbs written inline, computed
# and bound all check

let tool = 'rg'
let sub = 'build'
let shared = [`absolute /usr/share]
grant [
    exec: [
        allow: [`name git, `name $tool, `absolute /bin/sh, `cwd tools/build, `dir `system, `dir `path],
        deny: [`name bash, `dir `absolute /opt/homebrew],
    ],
    fs: [
        read:  [`cwd ., `xdg-data ., `home .gitconfig, `gitdir ., ...$shared],
        write: [`cwd $sub, `tempdir .],
        deny:  [`cwd .git],
    ],
    net:    `offline,
    editor: [`read],
    shell:  [`chdir],
] { return 1 }

# Bound lists are checked under written table keys
let nothing = []
grant [exec: [allow: $nothing], fs: [read: $nothing], editor: [], shell: []] { return 1 }
grant [editor: [`read, `write, `tui], shell: [`chdir, `detach]] { return 1 }

# A list passed through a parameter is checked under a written key
let exec-of = { |allow| grant [exec: [allow: $allow]] { return 1 } }
let _ = exec-of [`name git]
