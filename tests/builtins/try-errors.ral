# Test: §10.1 try / handler dispatch
#
# `try body handler` runs body and returns its value; on failure it
# calls handler with an ErrorRec [cmd, status, message, site] and
# returns the handler's value instead.

# Success: handler is not called.
echo !{try { return 0 } { |e| return $e[status] }}

# Command failure: status flows into the handler.
echo !{try { cat /nonexistent 2> /dev/null; return 0 } { |e| return $e[status] }}

# Explicit fail: status flows through.
echo !{try { fail [status: 42, message: 'explicit status'] } { |e| return $e[status] }}

# fail with a custom message: status and message round-trip.
try { fail [status: 7, message: 'custom failure'] } { |e|
    echo $e[status]
    echo $e[message]
}

# fail re-raise inside a handler: $e round-trips through nested try.
try {
    try { fail [status: 9, message: 'boom'] } { |e| fail $e }
} { |e|
    echo $e[status]
    echo $e[message]
}

# `try` with side-effecting handler.
try { fail [status: 1, message: 'side-effecting handler test'] } { |err|
    echo "caught status $err[status]"
}

# `try` success — handler not called.
try { return true } { |_| return false }

# Nested try.
try {
    try { fail [status: 1, message: 'nested try test'] } { |_err| echo 'inner caught' }
    echo 'continued after inner'
} { |_err| echo 'outer caught' }

# retry.
try {
    retry 3 { echo 'trying...'; fail [status: 1, message: 'retry test'] }
} { |_err| echo 'retry exhausted' }

# The record carries why the body failed, its status, and where it happened
try { fail [status: 3, message: 'x'] } { |e| echo $e[reason] $e[status] }
try { fail [status: 1, message: 'x'] } { |e|
    case $e[site] [`just: { |s| echo $[$s[line] > 0] }, `none: { |_| echo none }]
}

# A failure raised by the evaluator itself passes through no command
try { let _ = $[1 / 0] } { |e| echo $e[cmd] }

# guard: the body's error propagates, not the cleanup's
try { guard { fail [status: 42, message: 'original failure'] } { echo cleanup } } { |e|
    echo "status $e[status]"
}

echo 'try error tests done'
