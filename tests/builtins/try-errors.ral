# Test: §10.1 try / handler dispatch
#
# `try body handler` runs body and returns its value; on failure it
# calls handler with an ErrorRecord [reason, frame, site] and
# returns the handler's value instead.

# Success: the body's value comes back and the handler is not called.
echo !{try { return 0 } { |_| return -1 }}

# Command failure: the reason flows into the handler.  `cat`'s complaint lands in
# a file, so the failure is `cat`'s own.
let d = temp-dir
echo !{try { cat /nonexistent 2> "$d/err"; return `raised unreached } { |e| return $e[reason] }}
rm -rf $d

# Explicit fail: the reason carries the text.
echo !{try { fail 'explicit failure' } { |e| return $e[reason] }}

# A custom message is data in raised, and describe supplies its text.
try { fail 'custom failure' } { |e|
    echo $e[reason]
    echo !{describe $e}
}

# raise inside a handler preserves the entire record.
let original = try { fail 'boom' } { |e| return $e }
try { raise $original } { |e|
    echo $[$e == $original]
    echo !{describe $e}
}

# `try` with side-effecting handler.
try { fail 'side-effecting handler test' } { |err|
    echo "caught !{describe $err}"
}

# Nested try.
try {
    try { fail 'nested try test' } { |_err| echo 'inner caught' }
    echo 'continued after inner'
} { |_err| echo 'outer caught' }

# retry.
try {
    retry 3 { echo 'trying...'; fail 'retry test' }
} { |_err| echo 'retry exhausted' }

# The record carries why the body failed, its operation, and a total site.
try { fail 'x' } { |e| echo $e[reason] $e[frame] }
try { fail 'x' } { |e|
    echo $[$e[site][line] > 0]
}

# guard: the body's error propagates, not the cleanup's.
try { guard { fail 'original failure' } { echo cleanup } } { |e|
    echo !{describe $e}
}

echo 'try error tests done'
