# Test: glob patterns — *, ?, [chars], **

let tmpdir = temp-dir
mkdir -p "$tmpdir/sub"

# Create test files
echo x > "$tmpdir/hello.txt"
echo x > "$tmpdir/world.txt"
echo x > "$tmpdir/data.csv"
echo x > "$tmpdir/notes.md"
echo x > "$tmpdir/sub/deep.txt"

# *.txt — match extension
let txt = glob "$tmpdir/*.txt"
let ntxt = length $txt
echo "txt files: $ntxt"

# * — match all in directory
let all = glob "$tmpdir/*"
let nall = length $all
echo "all entries: $nall"

# ? — single character wildcard
let q = glob "$tmpdir/?????.txt"
let nq = length $q
echo "5-char names: $nq"

# [chars] — character class
let bracket = glob "$tmpdir/[hw]*.txt"
let nb = length $bracket
echo "h or w files: $nb"

# ** — recursive
let deep = glob "$tmpdir/**/*.txt"
let nd = length $deep
echo "recursive txt: $nd"

# No match returns empty list
let empty = glob "$tmpdir/*.xyz"
echo "no match: !{length $empty}"

# Clean up
rm -rf $tmpdir
# Dotfiles match only a literal name, never a wildcard
let dotdir = temp-dir
echo x > "$dotdir/a.txt"
echo x > "$dotdir/.hidden.txt"
within [dir: $dotdir] {
    echo !{glob '*.txt'}
    echo !{glob '.hidden.txt'}
}

# A leading `~` expands before the pattern is matched
within [env: [HOME: $dotdir]] {
    echo !{length !{glob '~/*.txt'}}
}
rm -rf $dotdir

# A wildcard component starting with `.` can match nothing: refused
let refusal = { |body| try $body { |e| echo $e[message]; return () } }
let gdir = temp-dir
within [dir: $gdir] {
    refusal { glob '.h*'; return () }

    # A literal dot name after a wildcard is matched; a wildcard never enters one
    mkdir -p a/.cfg .cfg/.cfg
    echo !{glob '*/.cfg'}

    # Alternation
    echo x > a.txt
    echo x > b.txt
    echo x > c.txt
    echo !{glob '{a,b}.txt'}

    # A dangling link is still an entry
    ln -s nowhere dangling
    echo !{glob 'dang*'}

    # A link back to an ancestor is an entry, never descended
    mkdir loop
    ln -s . loop/self
    echo !{length !{glob 'loop/**'}}

    # A trailing `**` matches the directory itself and its non-dot descendants
    mkdir -p src/x/.y
    echo x > src/x/f
    echo x > src/x/.y/g
    echo !{glob 'src/**'}
}
rm -rf $gdir

echo 'glob tests done'
