# Test: spawn and await carry values, closures, and deep recursion

# A second await returns the cached record
let h1 = !{spawn { return 99 }}
let first = await $h1
let again = await $h1
echo $[$first[value] + $again[value]]
# Expected: 198

# A closure returned from a worker keeps its captured bindings
let secret = 42
let h2 = !{spawn { return { |x| return $[$x + $secret] } }}
let r2 = await $h2
let add-secret = $r2[value]
echo !{add-secret 8}
# Expected: 50

# Cancelling a finished worker changes nothing
let h3 = !{spawn { return 7 }}
let r3 = await $h3
cancel $h3
echo $r3[value]
# Expected: 7

# A tail-recursive body runs in constant stack inside a worker
let h4 = !{spawn {
    let count = { |n acc|
        if $[$n <= 0] { return $acc } else { count $[$n - 1] $[$acc + $n] }
    }
    let total = count 10000 0; return $total
}}
let r4 = await $h4
echo $r4[value]
# Expected: 50005000

echo 'spawn value tests done'
