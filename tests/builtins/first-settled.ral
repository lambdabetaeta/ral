# Test: first-settled names the index of the first handle to settle and
# claims nothing

let assert_eq = { |name expected actual|
    if $[$expected != $actual] {
        warn "FAIL: $name expected: !{to-json $expected} actual: !{to-json $actual}"
        fail [status: 1, message: "assertion failed: $name"]
    }
}

# The settled one is named wherever it stands in the list
let slow = spawn "slow" { sleep 30; return slow }
let fast = spawn "fast" { return fast }
assert_eq 'fast second' 1 !{first-settled [$slow, $fast]}
assert_eq 'fast first' 0 !{first-settled [$fast, $slow]}

# It is an observation: the named handle is still awaitable
assert_eq 'await after' fast !{await $fast}
cancel $slow

# A handle already claimed is skipped
let a = spawn "a" { return 1 }
let b = spawn "b" { return 2 }
assert_eq 'await a' 1 !{await $a}
assert_eq 'claimed skipped' 1 !{first-settled [$a, $b]}
assert_eq 'await b' 2 !{await $b}

# With nothing left to wait on, or nothing listed, it fails
assert_eq 'all claimed' -1 !{try { first-settled [$a, $b] } { |_| return -1 }}
assert_eq 'empty list' -1 !{try { first-settled [] } { |_| return -1 }}

echo 'first-settled tests done'
