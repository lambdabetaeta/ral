# Test: explain names the kind of the entry that applies, whatever supplies it

let assert_eq = { |name expected actual|
    if $[$expected != $actual] {
        warn "FAIL: $name expected: !{to-json $expected} actual: !{to-json $actual}"
        fail [status: 1, message: "assertion failed: $name"]
    }
}
let headed = { |name kind|
    let text = explain $name
    return !{re-match "^$name · $kind\n" $text}
}

assert_eq 'builtin' true !{headed echo builtin}
assert_eq 'prelude function' true !{headed sum prelude}
assert_eq 'language form' true !{headed gather 'language syntax'}
assert_eq 'conditional form' true !{headed elsif 'language syntax'}

# A binding of the session is explained as itself, with its type
let double = { |x| return $[$x * 2] }
assert_eq 'session binding' true !{headed double session}
assert_eq 'session type' true !{re-match 'type +Integer → Returns Integer' !{explain double}}

# A rebinding shadows the prelude's function: explain describes what applies
let sum = { |xs| return 0 }
assert_eq 'shadowing binding' true !{headed sum session}

echo 'explain kinds tests done'
