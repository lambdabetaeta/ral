# Test: list combinators of the prelude at their edges: empty, single, unequal

let assert_eq = { |name expected actual|
    if $[$expected != $actual] {
        warn "FAIL: $name expected: !{to-json $expected} actual: !{to-json $actual}"
        fail "assertion failed: $name"
    }
}
let lt3 = { |x| return $[$x < 3] }

# take-while / drop-while split a list at the first element failing the predicate
assert_eq 'take-while prefix' [1, 2] !{take-while $lt3 [1, 2, 3, 1]}
assert_eq 'take-while all' [1, 2] !{take-while $lt3 [1, 2]}
assert_eq 'take-while none' [] !{take-while $lt3 [5, 1]}
assert_eq 'take-while empty' [] !{take-while $lt3 []}
assert_eq 'drop-while suffix' [3, 1] !{drop-while $lt3 [1, 2, 3, 1]}
assert_eq 'drop-while all' [] !{drop-while $lt3 [1, 2]}
assert_eq 'drop-while none' [5, 1] !{drop-while $lt3 [5, 1]}
assert_eq 'drop-while empty' [] !{drop-while $lt3 []}

# group-by keeps first-seen order inside each group; keys are strings
assert_eq 'group-by parity' [:, k0: [2, 4], k1: [1, 3, 5]] !{group-by { |x| return "k$[$x % 2]" } [1, 2, 3, 4, 5]}
assert_eq 'group-by single' [:, k1: [1]] !{group-by { |x| return "k$x" } [1]}
assert_eq 'group-by empty' [:] !{group-by { |x| return "k$x" } []}

# median is lower-middle on even length, and refuses the empty list
assert_eq 'median odd' 3 !{median [5, 1, 3]}
assert_eq 'median even' 2 !{median [4, 1, 3, 2]}
assert_eq 'median single' 7 !{median [7]}
assert_eq 'median-by key' 3 !{median-by { |x| return $[0 - $x] } [3, 1, 2, 4]}
assert_eq 'median empty' -1 !{try { median [] } { |_| return -1 }}
assert_eq 'median-by empty' -1 !{try { median-by $identity [] } { |_| return -1 }}

# maximum / minimum: single element, and the empty list is refused
assert_eq 'maximum' 9 !{maximum [2, 9, 3]}
assert_eq 'minimum' -3 !{minimum [2, 9, -3]}
assert_eq 'maximum single' 4 !{maximum [4]}
assert_eq 'minimum single' 4 !{minimum [4]}
assert_eq 'maximum empty' -1 !{try { maximum [] } { |_| return -1 }}
assert_eq 'minimum empty' -1 !{try { minimum [] } { |_| return -1 }}
assert_eq 'max tie' 7 !{max 7 7}
assert_eq 'max floats' 1.5 !{max 1.25 1.5}
assert_eq 'min negative' -2 !{min 2 -2}

# zip stops at the shorter list
assert_eq 'zip left shorter' [[1, 4]] !{zip [1] [4, 5, 6]}
assert_eq 'zip right shorter' [[1, 4], [2, 5]] !{zip [1, 2, 3] [4, 5]}
assert_eq 'zip empty left' [] !{zip [] [1]}
assert_eq 'zip empty right' [] !{zip [1] []}

# flat-map and concat flatten one level
assert_eq 'flat-map duplicate' [1, 1, 2, 2] !{flat-map { |x| return [$x, $x] } [1, 2]}
assert_eq 'flat-map to nothing' [] !{flat-map { |_| return [] } [1, 2]}
assert_eq 'flat-map empty' [] !{flat-map { |x| return [$x] } []}
assert_eq 'concat mixed' [1, 2, 3] !{concat [[1], [], [2, 3]]}
assert_eq 'concat empty' [] !{concat []}

# cross pairs every element of the first list with every one of the second
assert_eq 'cross' ['1a', '1b', '2a', '2b'] !{cross [1, 2] [a, b] { |x y| return "$x$y" }}
assert_eq 'cross empty left' [] !{cross [] [a, b] { |x y| return "$x$y" }}
assert_eq 'cross empty right' [] !{cross [1, 2] [] { |x y| return "$x$y" }}

# enumerate pairs elements with their positions
assert_eq 'enumerate' [[index: 0, item: a], [index: 1, item: b]] !{enumerate [a, b]}
assert_eq 'enumerate empty' [] !{enumerate []}

# option-or eliminates an Option
assert_eq 'option-or some' 5 !{option-or 0 `some 5}
assert_eq 'option-or none' 0 !{option-or 0 `none}
assert_eq 'option-or first-where' 3 !{option-or 0 !{first-where { |x| $[$x > 2] } [1, 2, 3]}}
assert_eq 'option-or first-where none' 0 !{option-or 0 !{first-where { |x| $[$x > 9] } [1, 2, 3]}}

echo 'prelude list tests done'
