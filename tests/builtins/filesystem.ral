# Test: §16.4 filesystem builtins

let tmpdir = temp-dir

# read file via from-string < path
echo hello > "$tmpdir/test.txt"
let content = !{from-string < "$tmpdir/test.txt"}
echo $content
# Expected: hello

# file size via file-info
let filesz = !{file-info "$tmpdir/test.txt"}[size]
echo $filesz
# Expected: 6 (hello + newline)

# line-count
echo "a\nb\nc" > "$tmpdir/lines.txt"
let count = line-count "$tmpdir/lines.txt"
echo $count
# Expected: 3

# file-info returns a record; mtime is an Int
let info = file-info "$tmpdir/test.txt"
if $[$info[mtime] > 0] { echo 'mtime ok' }
# Expected: mtime ok
echo $info[type]
# Expected: file

# Cleanup
rm "$tmpdir/test.txt" "$tmpdir/lines.txt"

# write file via to-string > path
to-string 'hello from write' > "$tmpdir/write.txt"
let written = !{from-string < "$tmpdir/write.txt"}
echo $written

# cp (bundled coreutils, sandboxed via the capability-checked dispatch)
cp "$tmpdir/write.txt" "$tmpdir/copy.txt"
let copied = !{from-string < "$tmpdir/copy.txt"}
echo $copied

# mv
mv "$tmpdir/copy.txt" "$tmpdir/move.txt"
if $[not !{exists "$tmpdir/copy.txt"}] { echo 'mv ok' }
let moved = !{from-string < "$tmpdir/move.txt"}
echo $moved

# mkdir -p
mkdir -p "$tmpdir/mkdir-test/sub"
if !{is-dir "$tmpdir/mkdir-test/sub"} { echo 'mkdir ok' }

# list-dir (structured query — primitive, returns a value)
let entries = list-dir "$tmpdir/mkdir-test"
if $[!{length $entries} == 1] { echo 'list-dir ok' }
let entry = $entries[0]
echo $entry[name]
echo $entry[type]

# rm (regular file)
rm "$tmpdir/write.txt" "$tmpdir/move.txt"
if $[not !{exists "$tmpdir/write.txt"}] { echo 'rm ok' }

# rm -rf (directory tree — the dangerous verb wears its name)
rm -rf "$tmpdir/mkdir-test"
if $[not !{exists "$tmpdir/mkdir-test"}] { echo 'rm -rf ok' }

# temp-dir (primitive — secure O_EXCL recipe, returns the path as a value)
let td = temp-dir
if !{is-dir $td} { echo 'temp-dir ok' }
rm -rf $td

# temp-file
let tf = temp-file
if !{is-file $tf} { echo 'temp-file ok' }
rm $tf

# resolve-path
let rp = resolve-path $tmpdir
if !{is-dir $rp} { echo 'resolve-path ok' }

rm -rf $tmpdir
echo 'filesystem tests done'
