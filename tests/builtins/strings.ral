# Test: string builtins — re-replace, re-split, join, upper, lower, length, slice, re-match

# upper / lower
echo !{upper hello}
echo !{lower HELLO}

# length
echo !{length hello}
echo !{length [a, b, c]}

# re-replace — unique-anchor; errors on 0 or >1 matches
echo !{re-replace world al 'hello world'}

# re-replace-all — every occurrence
echo !{re-replace-all a b 'a-a-a'}

# re-replace errors on an ambiguous (>1 match) pattern
try { re-replace a b 'a-a' } { |e| echo "$e[cmd] refused"; return "" }

# re-replace errors on a missing pattern
try { re-replace xyz q 'hello' } { |e| echo "$e[cmd] refused"; return "" }

# re-split / intercalate
let parts = re-split '/' '/usr/local/bin'
echo $parts[0]
echo $parts[2]
let joined = intercalate '-' $parts
echo $joined

# slice
echo !{slice hello 1 3}

# re-match
if !{re-match '\.ral$' 'hello.ral'} { echo 'matches' }

# posix-quote
echo !{posix-quote 'hello world'}

# ral-quote: bare where a bare word reads back the same, else the lightest quote
echo !{ral-quote hello} !{ral-quote 'hello world'} !{ral-quote '007'} !{ral-quote #'it's'#} !{ral-quote ##'a'#b'##}

# has
let m = [:, a: 1, b: 2]
if !{has $m a} { echo 'has a' }
if $[not !{has $m c}] { echo 'no c' }

echo 'string tests done'
