# Test: watch — live line-framed output from a concurrent block
#
# Every line carries the label, and the block's last line is unterminated:
# only the end-of-stream flush emits it, so `[job] two` appearing at all is
# what says the tail was flushed. `await` joins the worker, ordering both
# against `after`. A watched worker streams rather than buffers, so its
# handle's replayable bytes are empty.

let h = watch "job" { printf "one\ntwo" }
let joined = await $h
echo after
echo !{length !{to-bytes $joined[stdout]}}
