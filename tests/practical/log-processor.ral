# Test: generate log entries, process them, summarize.

let logdir = '/tmp/al-logs'
mkdir -p $logdir

# Generate log lines into a single file
let levels = [INFO, WARN, ERROR, INFO, INFO, ERROR, WARN, INFO, ERROR, INFO]
for $levels { |level|
    echo "$level: something happened" >> "$logdir/app.log"
}

# Read log file into list of lines
let lines_stream = cat "$logdir/app.log" | from-lines
let lines = !{stream-to-list $lines_stream}
let nlines = length $lines
echo "total lines: $nlines"

# Count errors by filtering
let errors = filter { |line| !{re-match '^ERROR' $line} } $lines
let nerrors = length $errors
echo "errors: $nerrors"

# Count warnings
let warns = filter { |line| !{re-match '^WARN' $line} } $lines
let nwarns = length $warns
echo "warnings: $nwarns"

# Count total using fold
let total = fold { |acc _| return $[$acc + 1] } 0 $lines
echo "counted: $total"

# Write summary
echo "Log Summary" > "$logdir/summary.txt"
echo "Total: $nlines" >> "$logdir/summary.txt"
echo "Errors: $nerrors" >> "$logdir/summary.txt"
echo "Warnings: $nwarns" >> "$logdir/summary.txt"

let summary = cat "$logdir/summary.txt"
echo $summary

# Clean up
rm -rf $logdir
if $[not !{exists $logdir}] {
    echo 'logs cleaned up'
}
