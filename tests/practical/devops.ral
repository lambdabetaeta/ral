# Test: practical devops-style script
# Things you'd actually do in a deployment script

# Machine-specific facts: assert shape only
let tmpdir = temp-dir
let config = [host: hostname, user: whoami, tmpdir: $tmpdir]
echo $[$config[host] != #''#]
echo $[$config[user] != #''#]

# Process a list of files with error handling
echo test1 > "$tmpdir/al-test-1.txt"
echo test2 > "$tmpdir/al-test-2.txt"
echo test3 > "$tmpdir/al-test-3.txt"

let files = ["$tmpdir/al-test-1.txt", "$tmpdir/al-test-2.txt", "$tmpdir/al-test-3.txt"]
for $files { |f|
    let content = cat $f
    echo "!{basename $f}: $content"
}

# Use try for error handling
try {
    cat /nonexistent/file | from-string
} { |err|
    echo "caught error with status $err[status]"; return ""
}

# Cleanup with explicit rm
let cleanup_marker = "$tmpdir/al-cleanup-test"
echo dirty > $cleanup_marker
if !{is-file $cleanup_marker} {
    echo 'cleanup marker exists'
}
rm $cleanup_marker
echo $[not !{exists $cleanup_marker}]

# Functional pipeline
let items = [3, 1, 4, 1, 5, 9, 2, 6]
let big = filter { |x| return $[$x > 3] } $items
echo ...$big

rm -rf $tmpdir
echo 'all done'
