# Test: lists, maps, indexing, spread, empty collections

# List basics
let items = [a, b, c]
echo $items[0]
echo $items[2]

# Map basics
let opts = [host: localhost, port: 8080]
echo $opts[host]
echo $opts[port]

# Nested map with chained indexing
let config = [db: [host: localhost, port: 5432], app: [workers: 4]]
echo $config[db][host]
echo $config[app][workers]

# Spread in maps (override then rest)
let base_opts = [host: localhost, port: 8080, workers: 4]
let custom = [port: 9090, ...$base_opts]
echo $custom[port]
echo $custom[host]

# Spread in lists
let xs = [1, 2]
let ys = [3, 4]
let all = [...$xs, ...$ys, 5]
echo !{length $all}

# Empty collections
let empty_list = []
let empty_map = [:]
echo !{length $empty_list}

# Trailing commas
let trailing = [
    a,
    b,
    c,
]
echo !{length $trailing}
