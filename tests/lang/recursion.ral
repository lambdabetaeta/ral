# Test: recursion, mutual recursion, and tail calls

let sum-to = { |n| if $[$n == 0] { return 0 } else { let prev = sum-to $[$n - 1]; return $[$n + $prev] } }
echo !{sum-to 3}
# Expected: 6

# Mutual recursion in tail position: 0+2+4+6+8+10
let even-sum = { |n acc| if $[$n > 10] { return $acc } else { odd-sum $[$n + 1] $[$acc + $n] } }
let odd-sum = { |n acc| if $[$n > 10] { return $acc } else { even-sum $[$n + 1] $acc } }
echo !{even-sum 0 0}
# Expected: 30

# Mutual recursion in non-tail position
let ff = { |n| if $[$n <= 0] { return 1 } else { let r = gg $[$n - 1]; return $[$n + $r] } }
let gg = { |n| if $[$n <= 0] { return 1 } else { let r = ff $[$n - 1]; return $[$n + $r] } }
echo !{ff 4}
# Expected: 11

# Deep tail recursion runs in constant stack
let countdown = { |n| if $[$n <= 0] { return done } else { countdown $[$n - 1] } }
echo !{countdown 10000}
# Expected: done

# Deep non-tail recursion stays within the machine's own stack
let deep = { |n| if $[$n == 0] { return 0 } else { let prev = deep $[$n - 1]; return $prev } }
echo !{deep 10000}
# Expected: 0

# Tail calls do not escape a grant or a within: the attenuation is still in force at depth 0
let chdir-at-bottom = { |n| if $[$n <= 0] { cd /tmp } else { chdir-at-bottom $[$n - 1] } }
try { grant [shell: [chdir: false]] { chdir-at-bottom 2 } } { |_| echo 'grant survives the tail call' }
let probe-env = { |n| if $[$n <= 0] { return $ENV[MARK] } else { probe-env $[$n - 1] } }
echo !{within [env: [MARK: inside]] { probe-env 3 }}
let probe-handled = { |n| if $[$n <= 0] { return !{within-probe} } else { probe-handled $[$n - 1] } }
echo !{within [handlers: [within-probe: { |args| to-string pong }]] { probe-handled 3 }}

# Deep tail recursion stays flat through a `?` chain, a case arm, and a bind continuation
let no = { |x| fail [status: 1, message: "x"] }
let chained = { |n| if $[$n <= 0] { return $n } else { no $n ? chained $[$n - 1] } }
echo !{chained 150000}
let cased = { |n| if $[$n <= 0] { return 0 } else { case `go $[$n - 1] [`go: { |m| cased $m }] } }
echo !{cased 150000}
let bound = { |n| if $[$n <= 0] { return $n } else { let m = $[$n - 1]
    bound $m } }
echo !{bound 150000}
