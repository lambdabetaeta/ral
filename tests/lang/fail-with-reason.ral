# Test: `fail` with a `reason` raises that kind of failure; try reads it back.
# `cancelled` and `timed-out` are reachable here, as a worker's stop is
# re-raised from its error record.

let assert_eq = { |name expected actual|
    if $[$expected != $actual] {
        warn "FAIL: $name expected: !{to-json $expected} actual: !{to-json $actual}"
        fail [status: 1, message: "assertion failed: $name"]
    }
}
let caught = { |body|
    try { !$body; fail [status: 99, message: 'ran'] } { |e| return $e }
}

let timed = caught { fail [status: 124, reason: `timed-out, message: 'too slow'] }
assert_eq 'timed-out reason' true $[$timed[reason] == `timed-out]
assert_eq 'timed-out status' 124 $timed[status]
assert_eq 'timed-out message' 'too slow' $timed[message]

let stopped = caught { fail [status: 143, reason: `cancelled, message: 'stopped'] }
assert_eq 'cancelled reason' true $[$stopped[reason] == `cancelled]
assert_eq 'cancelled status' 143 $stopped[status]

# The reasons are told apart by tag, as a case does
let tag = { |e|
    case $e[reason] [
        `exited:       { |_| return exited },
        `signaled:     { |_| return signaled },
        `cancelled:    { |_| return cancelled },
        `timed-out:    { |_| return timed-out },
        `not-found:    { |_| return not-found },
        `not-runnable: { |_| return not-runnable },
        `raised:       { |_| return raised }
    ]
}
assert_eq 'tag timed-out' timed-out !{tag $timed}
assert_eq 'tag cancelled' cancelled !{tag $stopped}
assert_eq 'tag plain fail' raised !{tag !{caught { fail [status: 3, message: 'plain'] }}}

# A caught error re-raises with its reason intact
let again = caught { fail $timed }
assert_eq 'reraised reason' timed-out !{tag $again}
assert_eq 'reraised status' 124 $again[status]

# A reason fixes its status: a disagreeing one is refused, as a plain failure
let refused = caught { fail [status: 3, reason: `cancelled, message: 'x'] }
assert_eq 'disagreeing status' raised !{tag $refused}
assert_eq 'disagreement is not the stop' true $[$refused[status] != 143]

echo 'fail with reason tests done'
