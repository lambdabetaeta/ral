# Tst: use (§8)

# Create a module
let tmpdir = temp-dir
echo "let version = 1\nlet _private = 42" > "$tmpdir/lib.ral"

# use returns a record of the module's bindings, excluding _ names; a
# record is reached by name, and `use` checks it against the names the script
# reads, so a read of an absent one fails at the `use`.
let m = use "$tmpdir/lib.ral"
echo $m[version]
let private = try { let probe = use "$tmpdir/lib.ral"; return $probe[_private] } { |_| return -1 }
echo !{equal $private -1}

# re-using an unchanged file yields a structurally equal record
let m2 = use "$tmpdir/lib.ral"
echo !{equal $m $m2}

# caller-file-relative module loading
mkdir -p "$tmpdir/sub"
echo "let x = 9" > "$tmpdir/sub/inner.ral"
echo #'let m = !{use 'sub/inner.ral'}
let via_use = $m[x]'# > "$tmpdir/entry.ral"
let entry = use "$tmpdir/entry.ral"
if $[not !{equal $entry[via_use] 9}] { fail [status: 1, message: "module: caller-relative use did not resolve sub/inner.ral"] }

# use is cacheless: each call re-reads the file, so rewriting a module
# between two `use` calls surfaces the new bindings.
echo "let version = 1" > "$tmpdir/reload.ral"
let m1 = use "$tmpdir/reload.ral"
echo "let version = 2" > "$tmpdir/reload.ral"
let mfresh = use "$tmpdir/reload.ral"
if $[not !{equal $mfresh[version] 2}] { fail [status: 1, message: "module: reload did not pick up the rewritten file"] }

# A module that uses itself is a cycle
echo "let _ = use '$tmpdir/cycle.ral'" > "$tmpdir/cycle.ral"
echo !{try { let _ = use "$tmpdir/cycle.ral"; return false } { |e| return !{re-match 'circular dependency' $e[message]} }}

# A failing module keeps its status and is tagged once
echo "fail [status: 7, message: 'boom']" > "$tmpdir/failing.ral"
echo !{try { let _ = use "$tmpdir/failing.ral"; return '' } { |e| return "$e[status] $e[message]" }}

# A module sees the session, earlier definitions included, but not a
# block's local `let`; only its own non-underscore names come back
echo 'let reads_local = $local' > "$tmpdir/block-local.ral"
let outer_define = 41
echo #'let visible = 1
let _hidden = 2
let reads_earlier = $[$outer_define + 1]'# > "$tmpdir/session.ral"
echo !{try { let _ = !{ let local = 1; use "$tmpdir/block-local.ral" }; return '' } { |e| return $e[message] }}
let sess = use "$tmpdir/session.ral"
let hidden = try { let probe = use "$tmpdir/session.ral"; return $probe[_hidden] } { |_| return hidden }
echo "$sess[visible] $sess[reads_earlier] $hidden"

# A RAL_PATH hit still answers to the fs read grant
mkdir -p "$tmpdir/lib" "$tmpdir/other"
echo "let answer = 42" > "$tmpdir/lib/g.ral"
try {
    grant [fs: [read: ["$tmpdir/other"]]] {
        within [dir: "$tmpdir/other", env: [RAL_PATH: "$tmpdir/lib"]] { let _ = use 'g.ral' }
    }
} { |e| echo !{re-match 'denied by grant' $e[message]} }

# Cleanup
rm -rf $tmpdir

echo 'module tests done'
