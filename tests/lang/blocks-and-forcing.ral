# Test: §4 block semantics, forcing, return values

# Force computation with !{}
let result = !{return 42}
echo $result

# Explicit unit return (no implicit value->command coercion)
let result = !{return ()}
echo !{equal $result ()}

# Multi-statement force returns last explicit return
let result = !{
    let x = 10
    let y = 20
    return $[$x + $y]
}
echo $result

# Lambda in substitution
let result = !{{ |x| return $[$x * 2] } 21}
echo $result

# Block as argument to function (not forced)
let run = { |_| echo 'deferred' }
!{run ()}

# Currying: a partial application is a function of the remaining parameters
let add3 = { |x y z| return $[$x + $y + $z] }
echo !{add3 1 2 3}
let add12 = add3 1 2
echo !{add12 3}

# `!{...}` atoms in one command evaluate left to right, before the command
let three = { |a b c| return [$a, $b, $c] }
echo ...!{three !{echo A; return 1} !{echo B; return 2} !{echo C; return 3}}

# In a sequence, a non-final step's bytes are effect; the block's value is its tail's
let seq_out = !{ echo one; echo two }
echo "bound [$seq_out]"

# `let _ = M` captures and drops M's bytes
let _ = echo secret
echo done

echo 'block tests done'
