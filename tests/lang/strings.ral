# Test: literal strings, interpolated strings, escapes, multi-line

let name = 'alice'

# Literal — no interpolation
echo 'hello $name'
# Expected: hello $name

# Interpolated
echo "hello $name"
# Expected: hello alice

# Escapes in double quotes
echo "line one\nline two"
# Expected: line one (newline) line two

# Multi-line literal
let stanza = 'first
second
third'
echo $stanza
# Expected: first (newline) second (newline) third

# Hash-bumped literals (embed quotes without escapes)
echo #'it's working'#
# Expected: it's working

echo "she said \"hello\""
# Expected: she said "hello"

# Literal dollar
echo "price: \$5"
# Expected: price: $5

# Unit is nothing to interpolate; `str` renders its literal
let uu = ()
echo "val: !{str $uu} end"
# Expected: val: () end
