# Test: elsif chains pick the first true branch, evaluate conditions in
# order, and need no else

let assert_eq = { |name expected actual|
    if $[$expected != $actual] {
        warn "FAIL: $name expected: !{to-json $expected} actual: !{to-json $actual}"
        fail [status: 1, message: "assertion failed: $name"]
    }
}

let grade = { |n|
    if    $[$n >= 90] { return A }
    elsif $[$n >= 80] { return B }
    elsif $[$n >= 70] { return C }
    else              { return F }
}
assert_eq 'first branch' A !{grade 95}
assert_eq 'middle branch' B !{grade 85}
assert_eq 'boundary' C !{grade 70}
assert_eq 'else' F !{grade 3}

# Conditions run in order and stop at the first true one
let log = temp-file
let probe = { |name v| echo $name >> $log; return $v }
let r = if !{probe a false} { return 1 } elsif !{probe b true} { return 2 } elsif !{probe c true} { return 3 } else { return 4 }
assert_eq 'first true wins' 2 $r
assert_eq 'later conditions unevaluated' [a, b] !{from-lines < $log}
rm $log

# Every condition false falls to else
let u = if false { return 1 } elsif false { return 2 } else { return 3 }
assert_eq 'else after elsifs' 3 $u

# Without else, the form is for effect: nothing is written when nothing is taken
let out = temp-file
if false { echo one >> $out } elsif false { echo two >> $out }
assert_eq 'untaken without else' '' !{from-string < $out}
if false { echo one >> $out } elsif true { echo two >> $out }
assert_eq 'taken without else' "two\n" !{from-string < $out}
rm $out

echo 'elsif chain tests done'
