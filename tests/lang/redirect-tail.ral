# Test: a tail call made under a trailing redirect writes inside the fd frame.

let assert_eq = { |name expected actual|
    if !{equal $expected $actual} {} else {
        warn "FAIL: $name expected: $expected actual: $actual"
        fail [status: 1]
    }
}

let tmpdir = temp-dir
let inner = { |_| echo inside }
let outer = { |_| inner () }

# `outer ()` is the last statement of `run`, so it reaches the redirect in
# tail position: the frame must absorb the tail call while it is still open.
let run = { |_| outer () > "$tmpdir/out.txt" }
run ()

let got = !{from-string < "$tmpdir/out.txt"}
assert_eq 'tail call writes inside the redirect frame' 'inside
' $got

rm -rf $tmpdir
echo 'redirect tail done'
