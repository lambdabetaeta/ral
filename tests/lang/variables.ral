# Test: basic variable binding and shadowing

let greeting = 'hello'
echo $greeting

let greeting = 'world'
echo $greeting

# Shadowing — not mutation
let y = 5
let f = { |_| echo $y }
let y = 10
!{f ()}

# A bare name is a literal; `$name` is the bound value
let up = { |x| return $x }
echo !{return up}
# Expected: up
echo !{up hello}
# Expected: hello

# Unit is a value
echo !{str !{return ()}}
let m = [done: ()]
echo !{str $m[done]}

# nproc is a positive integer
echo $[!{nproc} > 0]
# Expected: true

# In a `let` right-hand side, a bare name is applied
let upper = { |x| return $x }
let applied = upper hello
echo $applied
# Expected: hello
