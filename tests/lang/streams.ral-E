# Test: recursive stream types — a stream is a variant whose tail is a thunk

let count = { |n|
    if $[$n <= 0] { return `done } else { return `more [head: $n, tail: { !{count $[$n - 1]} }] }
}

# A consumer takes the stream as a thunk and recurses through its tail
let drain = { |s|
    case !$s [
        `more: { |p| echo $p[head]; drain $p[tail] },
        `done: { |_| return () }
    ]
}
drain { count 3 }

# A combinator takes a stream value and produces another
let smap = { |f s|
    case $s [
        `more: { |p| return `more [head: !{$f $p[head]}, tail: { !{smap $f !$p[tail]} }] },
        `done: { |_| return `done }
    ]
}
let sum = { |s|
    case $s [
        `more: { |p| let rest = !{sum !$p[tail]}; return $[$p[head] + $rest] },
        `done: { |_| return 0 }
    ]
}
echo !{sum !{smap { |x| return $[$x * 10] } !{count 3}}}

# Piped whole, a stream is a value like any other: a non-final stage's value
# goes nowhere, so the program is silent rather than wrong
let s = `more [head: 1, tail: { return `done }]
$s | { |e| return $[$e + 1] } | { |y| return $[$y * 10] }

echo 'streams done'
