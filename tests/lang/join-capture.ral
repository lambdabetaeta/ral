# Test: capture across a *join* — every arm of a branching byte-side command
# must contribute its own bytes to the binding, never the join's.

let assert_eq = { |name expected actual|
    if $[$expected != $actual] {
        warn "FAIL: $name expected: !{to-json $expected} actual: !{to-json $actual}"
        fail [status: 1, message: "assertion failed: $name"]
    }
}

# The demand descends into each arm, so the taken arm's own bytes are bound.
let taken = if true { echo one } else { echo two }
assert_eq 'if then-arm' one $taken

let other = if false { echo one } else { echo two }
assert_eq 'if else-arm' two $other

# An empty arm binds the empty String, written out: `()` would not join with
# the captured arm.
let empty_arm = if false { echo one } else { '' }
assert_eq 'empty arm' '' $empty_arm

let chained = ^false ? echo fallback
assert_eq 'chain arm' fallback $chained

let recovered = try { ^false } { |_| return '' }
assert_eq 'try handler' '' $recovered

# The body arm is a block in hand: the join is still a command, and a
# decoder may read it at the pipe.
let arm = { echo indirect }
let indirect = try $arm { |_| return () } | from-line
assert_eq 'eta-expanded arm' indirect $indirect

# A handler whose arrow is not written, `{ !$h }`, is captured as a whole —
# η-expanded around the forced call — so the error still reaches `h` under
# the capture.
let h = { |e| echo "handled $e[message]" }
let handled = try { fail [status: 1, message: 'boom'] } { !$h }
assert_eq 'handler under an unwritten arrow' 'handled boom' $handled

echo 'join capture done'
