# Test: §4.2/§4.3 capture semantics — let binds the return value of its RHS.

let assert_eq = { |name expected actual|
    if !{equal $expected $actual} {} else {
        warn "FAIL: $name expected: $expected actual: $actual"
        fail [status: 1]
    }
}

# Block return value: only the last command's bytes are the bound value.
let xs = !{ echo one; echo two; echo three }
assert_eq 'block last only' three $xs

# Value-returning last command: non-final stdout remains an effect; the
# final value is bound directly.
let n = !{ echo hello; length [1, 2, 3] }
assert_eq 'block mixed modes' 3 $n

# Higher-order capture: call-site mode instantiation resolves Var to Bytes.
let f = { |cmd| !$cmd }
let h = f { printf hello }
assert_eq 'higher-order capture' hello $h

# to-json writes JSON bytes to the channel; it no longer returns them, so a
# roundtrip lives in the pipe, not at a value boundary.
let obj = !{to-json [a: 42] | from-json}
assert_eq 'to-json roundtrip' 42 $obj[a]

# Binding an encoder captures its write as a String — nothing is discarded.
let jj = to-json [a: 42]
let obj2 = !{echo $jj | from-json}
assert_eq 'to-json bind captures its write' 42 $obj2[a]

# ints-to-bytes: a non-UTF-8 roundtrip must also stay in pipe form — binding
# the write as a value would now strict-decode it as a String and fail.
let raw = !{ints-to-bytes [72, 105, 255] | from-bytes}
assert_eq 'ints-to-bytes non-utf8 roundtrip' 3 !{length $raw}

echo 'capture semantics done'
