# Test: capture semantics — a command's value is its output, and a `let`
# binds the whole of it.

let assert_eq = { |name expected actual|
    if !{equal $expected $actual} {} else {
        warn "FAIL: $name expected: $expected actual: $actual"
        fail [status: 1, message: "assertion failed: $name"]
    }
}

# A block that runs commands is a command: everything it writes is the value.
let xs = !{ echo one; echo two; echo three }
assert_eq 'block whole' "one\ntwo\nthree" $xs

# A block ending in a value produces that value; what it wrote before goes
# to the terminal.
let n = !{ echo hello; length [1, 2, 3] }
assert_eq 'block mixed' 3 $n

# Higher-order: `f` produces what the block it is given produces, so a
# command block through `f` is still a command, and a stage may read it.
let f = { |cmd| !$cmd }
let h = f { printf hello } | from-line
assert_eq 'higher-order command' hello $h

# to-json writes JSON bytes to the channel; a roundtrip lives in the pipe.
let obj = !{to-json [a: 42] | from-json}
assert_eq 'to-json roundtrip' 42 $obj[a]

# Binding an encoder binds its output as a String — nothing is discarded.
let jj = to-json [a: 42]
let obj2 = !{echo $jj | from-json}
assert_eq 'to-json bind captures its write' 42 $obj2[a]

# ints-to-bytes: a non-UTF-8 roundtrip must stay in pipe form — binding the
# write as a value would strict-decode it as a String and fail.
let raw = !{ints-to-bytes [72, 105, 255] | from-bytes}
assert_eq 'ints-to-bytes non-utf8 roundtrip' 3 !{length $raw}

# The byte-to-value coercion is syntax, not a call: an alias standing under
# the coercion's old name cannot blank a captured binding
alias __decode-captured { |_| echo "" }
let greeting = echo hello
assert_eq 'alias cannot blank a capture' hello $greeting

echo 'capture semantics done'
