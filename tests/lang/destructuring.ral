# Test: list destructuring, map destructuring, rest params, nested

# List destructuring
let [first, second, third] = [a, b, c]
echo $first $second $third

# Rest params
let [head-el, ...tl] = [1, 2, 3, 4, 5]
echo $head-el
echo !{length $tl}

# Map destructuring
let [host: hst, port: prt] = [host: prod1, port: 8080]
echo $hst $prt

# Nested destructuring
let [name: n, addr: [city: c]] = [name: alice, addr: [city: london, zip: 'SW1']]
echo "$n lives in $c"

# Destructuring in lambda params
let servers = [
    [host: alpha, port: 80],
    [host: beta, port: 443],
]
for $servers { |[host: h, port: p]|
    echo "$h:$p"
}

# Wildcards discard
let _ = 42
let [_, second] = [1, 2]
echo $second

# An update destructures to each field's winner
let dflt = [tier: 'a', host: 'local', port: 80]
let [host: hn, port: pn] = [...$dflt, host: 'prod']
echo "$hn $pn"

# A shape mismatch in length is a runtime error
try { let [a, b, c] = [1, 2] } { |_| echo 'too few' }
try { let [a, b] = [1, 2, 3] } { |_| echo 'too many' }
