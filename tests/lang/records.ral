# Test: §21.9 record types and row polymorphism

# Heterogeneous map literal: each field has its own type
let rec = [host: prod1, port: 8080, debug: false]
echo $rec[host]
echo $rec[port]
echo !{equal $rec[debug] false}

# Nested records: inner fields retain their types
let config = [db: [host: localhost, port: 5432], workers: 4]
echo $config[db][host]
echo $config[db][port]
echo $config[workers]

# Row-polymorphic function: reads one field, ignores the rest
# Inferred type: ∀α ρ. {name: Str | ρ} → F Unit
let greet = { |x| echo "hello $x[name]" }
greet [name: alice]
greet [name: bob, dept: eng]

# try returns the body's value on success.
let ok = try { return 42 } { |_| return -1 }
echo !{equal $ok 42}

# try calls the handler on failure with a typed error record.
let status = try { fail [status: 7, message: 'typed error record test'] } { |e| return $e[status] }
echo !{equal $status 7}

# Inline form: handler can echo, return, or further dispatch.
try { fail [status: 3, message: 'inline dispatch test'] } { |err|
    echo "status is $err[status]"
}

# A spread updates the fields of a record
let base = [x: 1, y: 2, z: 0]
let extended = [...$base, z: 3]
echo $extended[x]
echo $extended[z]

# Record used as argument to row-polymorphic function
let get_x = { |r| return $r[x] }
echo !{get_x [x: 99, y: 0]}
echo !{get_x [label: a, x: 42]}

# An update over a base whose fields are unknown keeps them: the written entry wins
let with-x = { |base| return [...$base, x: 0] }
let shadowed = with-x [x: 'shadowed']
let extended = with-x [x: 5, y: 1]
echo [$shadowed[x], $extended[x], $extended[y]]

# An update keeps the base's other fields, and the written one wins at its own type
let base = [host: localhost, port: 80]
let nine = [...$base, port: 'nine']
echo [$nine[host], $nine[port]]

echo 'records ok'
