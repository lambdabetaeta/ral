# Test: the double-quoted escape table, as it reaches a value.
#
# Every escape is compared against the single-quoted literal it should denote.
# Single quotes go through a different lexer path — no escape processing — so
# the comparisons are not tautological.

echo $["\x41" == 'A']
# Expected: true
echo $["\u{1F600}" == '😀']
# Expected: true
echo $["\t" == '	']
# Expected: true
echo $["\\" == '\']
# Expected: true

# `\!` keeps the bang textual: without it, `!{rm -rf x}` would run.
echo $["\!{rm -rf x}" == '!{rm -rf x}']
# Expected: true

# A backslash before a newline continues the line and emits nothing.
echo $["a\
b" == 'ab']
# Expected: true

# Escapes with no printable literal to compare against: check their length.
echo !{length "\e"}
# Expected: 1
echo !{length "\0"}
# Expected: 1
echo !{length "\r\n"}
# Expected: 2
