# Map operands run in written order; assembly follows all operands.
let mark = { |label value| echo $label; return $value }
let k = 'a'
let m = ["!{mark key z}": !{mark value 1}, ...!{mark spread [:, a: 2]}, "!{mark last b}": !{mark final 3}]
to-json $m; echo

# The duplicate's value and later spread run before the duplicate is refused.
try {
    let _ = [$k: 1, $k: !{mark duplicate-value 2}, ...!{mark later-spread [:, b: 3]}]
    return ()
} { |e| echo !{describe $e} }
try {
    let _ = [$k: 1, $k: !{mark duplicate-value 2}]
    return ()
} { |e| echo !{describe $e} }

# An operand failure prevents assembly, even with a repeated computed key.
try {
    let _ = [$k: 1, $k: !{mark duplicate-value 2}, ...!{fail later-spread}]
    return ()
} { |e| echo !{describe $e} }
try {
    let _ = [$k: 1, $k: !{fail duplicate-value}]
    return ()
} { |e| echo !{describe $e} }

# The earliest failing spread, key, or value keeps its raised text.
try {
    let _ = [...!{fail first-spread}, "!{mark forbidden a}": 1]
    return ()
} { |e| echo !{describe $e} }
try {
    let _ = ["!{fail first-key}": !{mark forbidden 1}, ...!{fail later-spread}]
    return ()
} { |e| echo !{describe $e} }
try {
    let _ = [$k: !{fail first-value}, ...!{mark forbidden [:, a: 2]}]
    return ()
} { |e| echo !{describe $e} }

# Explicit beats every spread; among spreads the first wins. Iteration is sorted.
let a = [:, a: 1, b: 10, c: 100]
let b = [:, a: 2, b: 20, d: 200]
to-json [...$a, ...$b, $k: 3]; echo
to-json [$k: 3, ...$a, ...$b]; echo
to-json [...$a, $k: 3, ...$b]; echo

# Capture and function/block values survive the operand boundary.
let captured = [$k: !{echo hello}]
echo $captured[$k]
let fns = [$k: { |x| return $[$x + 1] }]
echo !{$fns[$k] 4}
let blocks = [$k: { echo forced }]
!$blocks[$k]

# Computed operands retain their lexical dependencies in a delayed closure.
let build = !{
    let prefix = 'inner'
    return { |key| return [$key: !{str $prefix}] }
}
let result-key = 'result'
let delayed = build $result-key
echo $delayed[$result-key]

# A nested admission failure stops the later operand before assembly.
try {
    let _ = [$k: !{echo '{"nested":"wrong"}' | from-json}, b: [:, nested: 1], ...!{mark forbidden [:, c: [:, nested: 2]]}]
    return ()
} { |e| echo admission-failed }
