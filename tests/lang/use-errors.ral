# Test: use refuses what it cannot load, as a plain runtime error naming `use`

let assert_eq = { |name expected actual|
    if $[$expected != $actual] {
        warn "FAIL: $name expected: !{to-json $expected} actual: !{to-json $actual}"
        fail "assertion failed: $name"
    }
}

# What `use` failed with, whatever the cause
let error-of = { |body| try { !$body; fail 'ran' } { |e| return $e } }
let d = temp-dir

# A module file that is not there, a directory, and source that does not parse
let missing = error-of { let _ = use "$d/missing.ral" }
assert_eq 'missing frame' use $missing[frame]
case $missing[reason] [
    `raised: { |_| return () },
    `process: { |_| fail 'missing module claimed an external failure' },
    `timed-out: { |_| fail 'missing module claimed a timeout' },
    `cancelled: { |_| fail 'missing module claimed cancellation' }
]
assert_eq 'missing caller source' true !{re-match '(^|/)use-errors\.ral$' $missing[site][script]}
let directory = error-of { let _ = use $d }
assert_eq 'directory frame' use $directory[frame]
echo '$[' > "$d/unparsed.ral"
let unparsed = error-of { let _ = use "$d/unparsed.ral" }
assert_eq 'unparsed frame' use $unparsed[frame]

# A failure inside the module keeps its own reason and source provenance.
echo "fail 'boom'" > "$d/failing.ral"
let failing = error-of { let _ = use "$d/failing.ral" }
assert_eq 'module reason' true $[$failing[reason] == `raised 'boom']
assert_eq 'module operation' fail $failing[frame]
assert_eq 'module source' "$d/failing.ral" $failing[site][script]
assert_eq 'module line' 1 $failing[site][line]
assert_eq 'module column' 1 $failing[site][col]
assert_eq 'missing is not a module failure' true $[$missing[site][script] != $failing[site][script]]

rm -rf $d
echo 'use error tests done'
