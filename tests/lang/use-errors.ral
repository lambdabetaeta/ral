# Test: use refuses what it cannot load, as a plain runtime error naming `use`

let assert_eq = { |name expected actual|
    if $[$expected != $actual] {
        warn "FAIL: $name expected: !{to-json $expected} actual: !{to-json $actual}"
        fail [status: 1, message: "assertion failed: $name"]
    }
}

# What `use` failed with, whatever the cause
let error-of = { |body| try { !$body; fail [status: 99, message: 'ran'] } { |e| return $e } }
let d = temp-dir

# A module file that is not there, a directory, and source that does not parse
let missing = error-of { let _ = use "$d/missing.ral" }
assert_eq 'missing cmd' use $missing[cmd]
assert_eq 'missing status' 1 $missing[status]
assert_eq 'missing reason' true $[$missing[reason] == `raised]
let directory = error-of { let _ = use $d }
assert_eq 'directory cmd' use $directory[cmd]
echo '$[' > "$d/unparsed.ral"
let unparsed = error-of { let _ = use "$d/unparsed.ral" }
assert_eq 'unparsed cmd' use $unparsed[cmd]

# A module that fails keeps its own status, which a missing one lacks
echo "fail [status: 7, message: 'boom']" > "$d/failing.ral"
let failing = error-of { let _ = use "$d/failing.ral" }
assert_eq 'failing status' 7 $failing[status]
assert_eq 'missing is not a module failure' true $[$missing[status] != $failing[status]]

rm -rf $d
echo 'use error tests done'
