# Test: §3 lexical scoping, closures, shadowing

# Lexical scoping
let base = 10
let f = { |y| return $[$base + $y] }
echo !{f 5}

# Closures capture at definition
let base = 10
let f = { |y| return $[$base + $y] }
let base = 20
echo !{f 5}

# Block-like scoping via lambda call
let base = 'outer'
!{{ |_|
    let x = 'inner'
    echo $x
    return ()
} ()}
echo $base

# Shadowing in for does not leak
let total = fold { |acc x| return $[$acc + $x] } 0 [1, 2, 3]
echo $total

# A local binding wins at the bare head
echo !{ let echo = { |n| return $[$n + 1] }; echo 5 }

# A native is shadowed by a `let` and restored when the scope exits
let inside = !{ let list-dir = 'shadowed'; return $list-dir }
echo $inside
let _ = list-dir .
echo 'native restored'

# A later non-thunk `let` does not capture an earlier use of a builtin
upper hi
let upper = 5

# Consecutive thunk lets form one recursive group: forward references resolve
let fwd = { |n| bwd $n }
let bwd = { |n| return $[$n + 1] }
echo !{fwd 41}
let ta = { return $[!{tb} + 1] }
let tb = { return 41 }
echo !{ta}

# A rebinding begins a new stretch: the block keeps the value bound above it
let bf = 10
let bg = { return $bf }
let bf = { return 20 }
echo !{bg}

# No definition moves across a statement: `cx` reads the first `cf`
let cf = { return 0 }
let cx = cf
let cf = { return 'hello' }
let cg = { cf }
echo $cx
echo !{cg}

# An inner block's own definition is no reference to the stretch around it
let idf = { |x|
  let ia = { ig }
  let ig = { return 1 }
  return $x
}
let ig = {
  let p = idf 1
  let q = idf 'a'
  return $q
}
echo !{ig}

# A stretch shadows an enclosing binding across the whole stretch
let sf = 10
let sh = {
  let sg = { sf }
  let sf = { return 20 }
  sg
}
echo !{sh}

# A let's extent is the rest of its own block
echo !{ let extent_x = 41; return $[$extent_x + 1] }

echo 'scoping tests done'
