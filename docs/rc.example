# ~/.config/ral/rc — ral interactive shell configuration
#
# Copy to $XDG_CONFIG_HOME/ral/rc (normally ~/.config/ral/rc), or ~/.ralrc.
#
# This file must return a record, or `()` to set nothing.  Every key is
# optional; an unknown key or a wrongly typed value refuses the whole file.
#
# Inside a prompt block, `cwd` and `user` are in scope.

# ANSI escape sequences for prompt colouring.
let red   = "\e[31m"
let blue  = "\e[34m"
let reset = "\e[0m"

return [
    # Line-editing mode: emacs (default) or vi.
    edit-mode: vi,

    # Audible bell on a line-editor error (default false).
    bell: false,

    # Interactive surface: readline (default) or minimal.
    surface: readline,

    # Maximum function-call recursion depth (default 100000).
    recursion-limit: 50000,

    # File creation mask, 1-4 octal digits (Unix only).
    umask: '022',

    # Soft limits for child processes: open-files, core-bytes, stack-bytes (Unix only).
    limits: [open-files: 4096, core-bytes: 0],

    # Environment variables set in every child process.
    env: [
        EDITOR: vim,
        PAGER:  less,
    ],

    # Lexical bindings (functions too) in scope at the prompt.
    bindings: [
        proj: ~/src/project,
    ],

    # Prompt block.  Return a string; `user` and `cwd` are in scope.
    prompt: {
        let lbracket = '['
        let rbracket = ']'
        return "$red$lbracket !{user} $rbracket$reset $blue!{abbreviate-home !{cwd}}$reset $ "
    },

    # Command aliases, expanded before external-command lookup.
    # A block receives any trailing arguments as $args.
    aliases: [
        ll: { |args| ls -lh ...$args },
        la: { |args| ls -lha ...$args },
        g:  { |args| git ...$args },
    ],

    # Plugins loaded before the first prompt: name (or path) => its options.
    plugins: [
        zoxide:         [key: 'alt-z'],
        autosuggestion: [:],
    ],

    # Block run once after the rc is applied.
    startup: { echo 'ready' },

    # Result printing: prefix, and colour (black red green yellow blue magenta cyan white none).
    theme: [
        value-prefix: '=> ',
        value-color:  yellow,
    ],
]
