# ~/.config/ral/rc — ral interactive shell configuration
#
# Copy to $XDG_CONFIG_HOME/ral/rc (normally ~/.config/ral/rc), or ~/.ralrc.
#
# End in a written record with all twelve keys below (SPEC §15.3).
# Write every limits/theme key too; compute values, not table keys.
# Unknown or missing keys and statically wrong types refuse the file before it runs.
# `inherit keeps ral's or the system's existing setting; `set VALUE overrides it.
# Empty collections are [:]; edit-mode, bell, and surface take plain values.
#
# Inside a prompt block, `cwd` and `user` are in scope.

# ANSI escape sequences for prompt colouring.
let red   = "\e[31m"
let blue  = "\e[34m"
let reset = "\e[0m"

# Top-level lets install checked lexical bindings (functions too) for the session.
let proj = ~/src/project

return [
    # Line-editing mode: emacs (default) or vi.
    edit-mode: vi,

    # Audible bell on a line-editor error (default false).
    bell: false,

    # Interactive surface: readline (default) or minimal.
    surface: readline,

    # `inherit keeps --recursion-limit, else ral's built-in limit (100000).
    recursion-limit: `set 50000,

    # `inherit keeps the process's umask; `set takes 1-4 octal digits (Unix only).
    umask: `set '022',

    # Child soft limits: `inherit keeps ral's limit; `set takes bytes/count (Unix only).
    limits: [
        open-files: `set 4096,
        core-bytes: `set 0,
        stack-bytes: `inherit,
    ],

    # Environment variables set in every child process.
    env: [
        EDITOR: vim,
        PAGER:  less,
    ],

    # `inherit keeps ral's prompt; `set takes a block returning a string.
    prompt: `set {
        let lbracket = '['
        let rbracket = ']'
        return "$red$lbracket !{user} $rbracket$reset $blue!{abbreviate-home !{cwd}}$reset $ "
    },

    # Command handlers, consulted before external-command lookup.
    # A block receives any trailing arguments as $args.
    handlers: [:,
        ll: { |args| ls -lh ...$args },
        la: { |args| ls -lha ...$args },
        g:  { |args| git ...$args },
    ],

    # Plugins loaded at startup only: name (or path) => its options.
    # Adding a plugin requires a new session.
    plugins: [
        zoxide:         [key: 'alt-z'],
        autosuggestion: [:],
    ],

    # `inherit runs no startup block; `set runs this once after the rc is applied.
    startup: `set { echo 'ready' },

    # `inherit keeps '=> ' and yellow; `set overrides each independently.
    # Colours: black red green yellow blue magenta cyan white none.
    theme: [
        value-prefix: `set '→ ',
        value-color: `inherit,
    ],
]
