# tasks.ral — a small task-management kit.
#
# Load with `source "kit/tasks.ral"`.  The bindings drop into the current
# scope; loading also echoes a short API recap to stdout so the model
# sees the kit's surface in the tool result.
#
# Schema (records are statically typed; every field is always present):
#     id     : Int
#     desc   : String
#     status : String     -- "open" | "doing" | "blocked" | "done"
#     tags   : [String]
#     notes  : String     -- "" means none
#
# Two layers:
#
# * The pure data layer (set-status, update-task, by-status, render-*,
#   save-/load-tasks, …) is side-effect-free and runs in a bare ral
#   REPL with no host.
# * The host-surfacing layer (add-task, remove-task, transition,
#   surface-progress) hands the host a render document with the `surface`
#   builtin.  Task state is *pinned*, not streamed: `surface-progress`
#   pins one card — a `measure` gauge on top, then two `text` marks per
#   task (a coloured header line and an indented body line) — wrapped in
#   a `` `pin `` disposition keyed to a register slot, which the host
#   overwrites in place rather than appending a card per change.  When a
#   change leaves no work — the list emptied, or every task done — the
#   card goes empty and the host drops the slot, so the gauge clears from
#   the rail.  With no host installed `surface` is the identity, so the
#   kit stays runnable in a bare ral REPL.
#
# Id allocation: `add-task` calls `next-id`, which returns
# `max(ids) + 1`.  Ids freed by `remove-task` are recycled.
#
# Convenience wrappers (tag-task, note-task, retag-task) compose on top
# of update-task so callers never rebuild a full record by hand.
#
# Status validation: `transition` rejects anything outside
# `valid-statuses` and leaves the list unchanged, printing a warning.


# --- constructor ------------------------------------------------------------

let mk-task = { |id desc|
  [ id: $id, desc: $desc, status: "open", tags: [], notes: "" ]
}

# A correctly-typed empty task list. A bare `[]` would be polymorphic and
# get monomorphised to the wrong element type at the first use site.
let empty-tasks = drop 1 [ !{mk-task 0 ""} ]

# Valid status values.  `transition` rejects anything outside this set.
let valid-statuses = ['open', 'doing', 'blocked', 'done']

# --- per-field setters ------------------------------------------------------
# One respread per setter, so adding a field touches O(setters), not O(callers).

let set-desc   = { |t v| [id: $t[id], desc: $v,       status: $t[status], tags: $t[tags], notes: $t[notes]] }
let set-status = { |t v| [id: $t[id], desc: $t[desc], status: $v,         tags: $t[tags], notes: $t[notes]] }
let set-tags   = { |t v| [id: $t[id], desc: $t[desc], status: $t[status], tags: $v,       notes: $t[notes]] }
let set-notes  = { |t v| [id: $t[id], desc: $t[desc], status: $t[status], tags: $t[tags], notes: $v        ] }

let add-tag    = { |t g| set-tags $t [...$t[tags], $g] }
let remove-tag = { |t g| set-tags $t !{filter { |x| $[not !{equal $x $g}] } $t[tags]} }


# --- id allocation ---------------------------------------------------------
# Project ids first so the fold accumulator is unambiguously Int.
# Returns 1 for an empty list, max(ids) + 1 otherwise.

let next-id = { |ts|
  let ids = map { |t| $t[id] } $ts
  if !{is-empty $ids} { 1 }
    else { $[!{fold { |acc x| if $[$x > $acc] { $x } else { $acc } } 0 $ids} + 1] }
}

# --- list combinators ------------------------------------------------------

## Construct a fresh task with `desc`, allocate its id via `next-id`,
## and append it to `ts`.  Updates the pinned `tasks` rollup gauge in
## place — growing the list is a state change, not an event, so it
## appends nothing to the transcript.  Returns the updated list.
## Canonical entry point for growing the task list.
let add-task = { |ts desc|
  let new-ts = [...$ts, !{mk-task !{next-id $ts} $desc}]
  surface-progress $new-ts
  $new-ts
}

## Append a pre-built Task to `ts`.  Useful for deserialisation and
## bulk import.
let append-task = { |ts t| [...$ts, $t] }

## Drop the task with `id` and update the pinned `tasks` gauge in place.
## Removing the last task empties the card, so the host drops the slot
## and the gauge disappears.  Returns the updated list.  The mirror of
## `add-task`, the canonical entry point for shrinking the list.
let remove-task = { |ts id|
  let new-ts = filter { |t| $[$t[id] != $id] } $ts
  surface-progress $new-ts
  $new-ts
}
let find-task   = { |ts id|   first  { |t| $[$t[id] == $id] } $ts }
let update-task = { |ts id f|
  map { |t| if $[$t[id] == $id] { f $t } else { $t } } $ts
}

# --- list-level convenience (setters composed, no record rebuilding) ---

let tag-task   = { |ts id tag|  update-task $ts $id { |t| add-tag  $t $tag } }
let untag-task = { |ts id tag|  update-task $ts $id { |t| remove-tag $t $tag } }
let note-task  = { |ts id note| update-task $ts $id { |t| set-notes  $t $note } }
let retag-task = { |ts id tags| update-task $ts $id { |t| set-tags   $t $tags } }


# --- queries ---------------------------------------------------------------

let by-status   = { |ts s| filter { |t| equal $t[status] $s } $ts }
let by-tag      = { |ts g| filter { |t| elem   $g $t[tags]  } $ts }
let open-tasks  = { |ts| by-status $ts "open" }

# Single-fold status counts — one pass over the list, not four.
let status-counts = { |ts|
  fold { |acc t|
    if    !{equal $t[status] "open"}    { [open: $[$acc[open] + 1],     doing: $acc[doing],   blocked: $acc[blocked], done: $acc[done]] }
    elsif !{equal $t[status] "doing"}   { [open: $acc[open],   doing: $[$acc[doing] + 1],   blocked: $acc[blocked], done: $acc[done]] }
    elsif !{equal $t[status] "blocked"} { [open: $acc[open],   doing: $acc[doing],   blocked: $[$acc[blocked] + 1], done: $acc[done]] }
    elsif !{equal $t[status] "done"}    { [open: $acc[open],   doing: $acc[doing],   blocked: $acc[blocked], done: $[$acc[done] + 1]] }
    else                                { $acc }
  } [open: 0, doing: 0, blocked: 0, done: 0] $ts
}


# --- rendering -------------------------------------------------------------

let render-task = { |t|
  let tag-str  = if !{is-empty $t[tags]}   { "" } else { " [!{intercalate "," $t[tags]}]" }
  let note-str = if !{equal $t[notes] ""}  { "" } else { "  -- $t[notes]" }
  "#$t[id]  $t[status]  $t[desc]$tag-str$note-str"
}

let render-tasks = { |ts| for $ts { |t| echo !{render-task $t} } }


# --- persistence -----------------------------------------------------------

let save-tasks = { |ts path| to-json   $ts > $path }
let load-tasks = { |path|    from-json     < $path }


# --- host-rail surfacing ---------------------------------------------------
# `surface` hands the host a render document — a `` `card `` of Bertin
# *marks* — and with no host it is the identity.  The kit declares data and
# its level of measurement; the host binds it to visual variables.  See
# `value_to_card` in `exarch/src/card.rs` for the host's decoder.

## Build a list of two `` `text `` marks for one task: a header line
## (id + coloured status) and a body line (description, tags, notes).
## Empty tags or notes produce no span, so nothing renders as `[]`.
let task-to-marks = { |t|
  let id-str = "#$t[id]  "
  let status-str = $t[status]
  let tag-str = if !{is-empty $t[tags]} { "" } else { "  [!{intercalate "," $t[tags]}]" }
  let note-str = if !{equal $t[notes] ""} { "" } else { "  -- $t[notes]" }
  let header =
    if    !{equal $t[status] "done"}    { [[role: "muted", text: $id-str], [role: "ok",    text: $status-str]] }
    elsif !{equal $t[status] "doing"}   { [[role: "muted", text: $id-str], [role: "warn",   text: $status-str]] }
    elsif !{equal $t[status] "blocked"} { [[role: "muted", text: $id-str], [role: "bad",    text: $status-str]] }
    else                                { [[role: "muted", text: $id-str], [role: "muted",  text: $status-str]] }
  let desc-span = [[role: "", text: "  $t[desc]"]]
  let tag-span  = if !{is-empty $t[tags]}    { [] }  else { [[role: "code",  text: $tag-str]] }
  let note-span = if !{equal $t[notes] ""}   { [] } else { [[role: "muted", text: $note-str]] }
  let body = [...$desc-span, ...$tag-span, ...$note-span]
  [`text [spans: $header], `text [spans: $body]]
}

## Pin the `tasks <done>/<total>` rollup to the host register, with the
## full task list rendered as two-line blocks beneath the gauge.  The
## keyed slot means the whole card fills in place rather than streaming
## down the scrollback.  When no work is left — done == total, the empty
## list included — the card is emptied; the host drops a pin with an
## empty body, so a finished plan clears its gauge instead of resting at
## done/done.
let surface-progress = { |ts|
    let done  = !{length !{by-status $ts "done"}}
    let total = !{length $ts}
    let gauge = `measure [label: "tasks", value: $done, max: $total]
    let marks =
      if $[$done == $total] { drop 1 [$gauge] }
      else                  { [$gauge, ...!{flat-map $task-to-marks $ts}] }
    surface `pin [key: "tasks", body: `card $marks]
}

## Transition a task status and update the pinned `tasks` rollup gauge
## in place.  Rejects invalid statuses (anything outside
## open|doing|blocked|done) with a warning on stderr and leaves the
## list unchanged.  Returns the updated task list.
let transition = { |ts id new-status|
    if !{elem $new-status $valid-statuses} {
        let new-ts = update-task $ts $id { |t| set-status $t $new-status }
        surface-progress $new-ts
        $new-ts
    } else {
        echo "transition: invalid status -- $new-status (expected open|doing|blocked|done)" 1>&2
        $ts
    }
}


# --- load-time briefing ----------------------------------------------------
# Runs once when the file is sourced.  The echoes land in the
# sourcing tool call stdout so the model receives the API recap
# alongside the bindings.

echo 'tasks kit loaded.'
echo '  empty-tasks                          — correctly-typed empty list'
echo '  add-task $tasks <desc>               — fresh id, append, update pinned gauge'
echo '  remove-task $tasks <id>              — drop by id, update pinned gauge'
echo '  update-task $tasks <id> { |t| … }    — patch one task pure-functionally'
echo '  tag-task $tasks <id> <tag>           — add a tag to a task'
echo '  note-task $tasks <id> <note>         — set notes on a task'
echo '  retag-task $tasks <id> <tags>        — replace all tags on a task'
echo '  transition $tasks <id> <status>      — change status (validated) + update pinned gauge'
echo '  status-counts $tasks                 — record of per-status counts (single fold)'
echo '  render-tasks $tasks                  — echo each task to stdout'
echo '  save-tasks $tasks <path> / load-tasks <path>'
echo ''
echo 'add-task, remove-task and transition all pin a `tasks` rollup gauge'
echo 'to the rail register, updated in place; it clears once no work is'
echo 'left, so the user can see progress at a fixed spot.'
echo 'tag-task / note-task / retag-task set fields without rebuilding records.'
